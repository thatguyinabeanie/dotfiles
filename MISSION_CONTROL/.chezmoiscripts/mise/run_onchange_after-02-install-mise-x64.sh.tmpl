#!/bin/bash
# Install x86_64 version of mise for Node.js 14 compatibility on Apple Silicon
# Embeds and leverages the official mise installer logic

set -euo pipefail

# Only run on Apple Silicon
if [[ "$(uname -m)" != "arm64" ]]; then
    echo "Skipping mise-x64 installation: not on Apple Silicon"
    exit 0
fi

#region logging setup (from official installer)
if [ "${MISE_DEBUG-}" = "true" ] || [ "${MISE_DEBUG-}" = "1" ]; then
  debug() {
    echo "$@" >&2
  }
else
  debug() {
    :
  }
fi

if [ "${MISE_QUIET-}" = "1" ] || [ "${MISE_QUIET-}" = "true" ]; then
  info() {
    :
  }
else
  info() {
    echo "$@" >&2
  }
fi

error() {
  echo "$@" >&2
  exit 1
}
#endregion

#region environment setup (from official installer)
get_os() {
  os="$(uname -s)"
  if [ "$os" = Darwin ]; then
    echo "macos"
  elif [ "$os" = Linux ]; then
    echo "linux"
  else
    error "unsupported OS: $os"
  fi
}

get_arch() {
  musl=""
  if type ldd >/dev/null 2>/dev/null; then
    libc=$(ldd /bin/ls | grep 'musl' | head -1 | cut -d ' ' -f1)
    if [ -n "$libc" ]; then
      musl="-musl"
    fi
  fi
  arch="$(uname -m)"
  if [ "$arch" = x86_64 ]; then
    echo "x64$musl"
  elif [ "$arch" = aarch64 ] || [ "$arch" = arm64 ]; then
    echo "arm64$musl"
  elif [ "$arch" = armv7l ]; then
    echo "armv7$musl"
  else
    error "unsupported architecture: $arch"
  fi
}

get_ext() {
  if [ -n "${MISE_INSTALL_EXT:-}" ]; then
    echo "$MISE_INSTALL_EXT"
  elif tar_supports_zstd; then
    echo "tar.zst"
  elif command -v zstd >/dev/null 2>&1; then
    echo "tar.zst"
  else
    echo "tar.gz"
  fi
}

tar_supports_zstd() {
  # tar is bsdtar or version is >= 1.31
  if tar --version | grep -q 'bsdtar' && command -v zstd >/dev/null 2>&1; then
    true
  elif tar --version | grep -q '1\.(3[1-9]|[4-9][0-9]'; then
    true
  else
    false
  fi
}

shasum_bin() {
  if command -v shasum >/dev/null 2>&1; then
    echo "shasum"
  elif command -v sha256sum >/dev/null 2>&1; then
    echo "sha256sum"
  else
    error "mise install requires shasum or sha256sum but neither is installed. Aborting."
  fi
}
#endregion

#region download and checksum validation (from official installer)
download_file() {
  url="$1"
  filename="$(basename "$url")"
  cache_dir="$(mktemp -d)"
  file="$cache_dir/$filename"

  info "🔽 downloading $filename..."

  if command -v curl >/dev/null 2>&1; then
    debug ">" curl -#fLo "$file" "$url"
    curl -#fLo "$file" "$url"
  else
    if command -v wget >/dev/null 2>&1; then
      debug ">" wget -qO "$file" "$url"
      stderr=$(mktemp)
      wget -O "$file" "$url" >"$stderr" 2>&1 || error "wget failed: $(cat "$stderr")"
    else
      error "mise standalone install requires curl or wget but neither is installed. Aborting."
    fi
  fi

  echo "$file"
}

get_checksum() {
  version=$1
  os=$2
  arch=$3
  ext=$4
  url="https://github.com/jdx/mise/releases/download/v${version}/SHASUMS256.txt"

  if command -v curl >/dev/null 2>&1; then
    debug ">" curl -fsSL "$url"
    checksums="$(curl --compressed -fsSL "$url")"
  else
    if command -v wget >/dev/null 2>&1; then
      debug ">" wget -qO - "$url"
      checksums="$(wget -qO - "$url")"
    else
      error "mise standalone install specific version requires curl or wget but neither is installed. Aborting."
    fi
  fi

  checksum="$(echo "$checksums" | grep "$os-$arch.$ext")"
  if ! echo "$checksum" | grep -Eq "^([0-9a-f]{32}|[0-9a-f]{64})"; then
    info "⚠️  no checksum for mise $version and $os-$arch"
  else
    echo "$checksum"
  fi
}
#endregion

# Main installation logic
install_mise_x64() {
  # Get latest version from GitHub API
  info "🔍 fetching latest mise version..."
  if command -v curl >/dev/null 2>&1; then
    latest_version=$(curl -fsSL https://api.github.com/repos/jdx/mise/releases/latest | grep '"tag_name"' | sed 's/.*"tag_name": "v\([^"]*\)".*/\1/')
  else
    error "curl is required to fetch latest version"
  fi

  if [[ -z "$latest_version" ]]; then
    error "❌ failed to fetch latest mise version"
  fi

  version="${latest_version#v}"
  os="$(get_os)"
  arch="x64"  # Force x64 architecture
  ext="$(get_ext)"
  install_path="$HOME/.local/bin/mise-x64"
  install_dir="$(dirname "$install_path")"

  info "📦 latest mise version: v$version"

  # Check if already installed and up to date
  if [[ -f "$install_path" ]]; then
    current_version=$("$install_path" --version 2>/dev/null | awk '{print $1}' || echo "unknown")
    if [[ "$current_version" == "$version" ]]; then
      info "✅ mise-x64 v$version already installed and up to date"
      return 0
    else
      info "🔄 updating mise-x64 from v$current_version to v$version"
    fi
  else
    info "📦 installing mise-x64 v$version for Node.js 14 compatibility"
  fi

  # Build download URL
  tarball_url="https://github.com/jdx/mise/releases/download/v${version}/mise-v${version}-${os}-${arch}.${ext}"

  # Download tarball
  cache_file=$(download_file "$tarball_url")
  debug "mise-setup: tarball=$cache_file"

  # Validate checksum
  info "🔒 validating checksum..."
  cd "$(dirname "$cache_file")" && get_checksum "$version" "$os" "$arch" "$ext" | "$(shasum_bin)" -c >/dev/null

  # Extract tarball
  mkdir -p "$install_dir"
  rm -rf "$install_path"
  cd "$(mktemp -d)"
  
  info "📂 extracting mise-x64..."
  if [ "$ext" = "tar.zst" ] && ! tar_supports_zstd; then
    zstd -d -c "$cache_file" | tar -xf -
  else
    tar -xf "$cache_file"
  fi
  
  mv mise/bin/mise "$install_path"
  info "✅ mise-x64 installed successfully to $install_path"

  # Verify installation
  if "$install_path" --version >/dev/null 2>&1; then
    version_output=$("$install_path" --version)
    info "🎉 verification successful: $version_output"
  else
    error "❌ mise-x64 installation failed - binary not working"
  fi

  info "📝 usage: Set 'MISE_ARCH = \"x86_64\"' in your project's .mise.toml"
}

# Create ~/.local/bin if it doesn't exist
mkdir -p "$HOME/.local/bin"

# Run the installation
install_mise_x64
