#!/bin/bash
# Install x86_64 version of mise for Node.js 14 compatibility on Apple Silicon
# Uses the official mise installer with architecture override

set -euo pipefail

# Only run on Apple Silicon
if [[ "$(uname -m)" != "arm64" ]]; then
    echo "Skipping mise-x64 installation: not on Apple Silicon"
    exit 0
fi

# Create ~/.local/bin if it doesn't exist
mkdir -p "$HOME/.local/bin"

MISE_X64_PATH="$HOME/.local/bin/mise-x64"

# Check if mise-x64 is already installed and get current version
if [[ -f "$MISE_X64_PATH" ]]; then
    CURRENT_VERSION=$("$MISE_X64_PATH" --version 2>/dev/null | awk '{print $1}' || echo "unknown")
    echo "📦 Current mise-x64 version: v$CURRENT_VERSION"
else
    CURRENT_VERSION="none"
    echo "📦 No mise-x64 installation found"
fi

# Fetch the latest version from GitHub API
echo "🔍 Fetching latest mise version..."
LATEST_VERSION=$(curl -fsSL https://api.github.com/repos/jdx/mise/releases/latest | grep '"tag_name"' | sed 's/.*"tag_name": "v\([^"]*\)".*/\1/')

if [[ -z "$LATEST_VERSION" ]]; then
    echo "❌ Failed to fetch latest mise version"
    exit 1
fi

echo "📦 Latest mise version: v$LATEST_VERSION"

# Check if update is needed
if [[ "$CURRENT_VERSION" == "$LATEST_VERSION" ]]; then
    echo "✅ mise-x64 v$LATEST_VERSION already installed and up to date"
    exit 0
else
    echo "🔄 Installing/updating mise-x64 from v$CURRENT_VERSION to v$LATEST_VERSION"
fi

# Create temporary directory for installation
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

# Download the official mise installer
echo "⬇️  Downloading official mise installer..."
curl -fsSL https://mise.jdx.dev/install.sh -o "$TEMP_DIR/install.sh"

# Run the installer with x86_64 architecture override and custom install path
echo "📦 Installing mise v$LATEST_VERSION for x86_64 to ~/.local/bin/mise-x64..."
MISE_VERSION="v$LATEST_VERSION" \
MISE_INSTALL_ARCH="x64" \
MISE_INSTALL_PATH="$MISE_X64_PATH" \
MISE_INSTALL_HELP=0 \
bash "$TEMP_DIR/install.sh"

# Verify installation
echo "🔍 Verifying installation..."
if "$MISE_X64_PATH" --version >/dev/null 2>&1; then
    VERSION_OUTPUT=$("$MISE_X64_PATH" --version)
    echo "✅ mise-x64 installed successfully: $VERSION_OUTPUT"
else
    echo "❌ mise-x64 installation failed - binary not working"
    exit 1
fi

echo "🎉 mise-x64 is now available for Node.js 14 projects"
echo "Usage: Set 'MISE_ARCH = \"x86_64\"' in your project's .mise.toml"
