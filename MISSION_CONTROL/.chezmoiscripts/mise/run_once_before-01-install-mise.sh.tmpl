#!/bin/bash
# Unified mise installation - handles both regular mise and mise-x64

set -euo pipefail

# Function to install mise with specified architecture
install_mise_arch() {
	local arch="$1"
	local binary_name="$2"
	local description="$3"
	local launchagent_name="$4"

	echo "🔧 Installing $binary_name ($description)..."

	# Configure mise installation
	export MISE_INSTALL_ARCH="$arch"
	export MISE_INSTALL_PATH="$HOME/.local/bin/$binary_name"
	export MISE_QUIET="true"

	# Run unified installer
	"{{ .chezmoi.sourceDir }}/.chezmoitemplates/mise/install-or-update.sh"

	# Load and start LaunchAgent for daily updates (macOS only)
	{{- if eq .chezmoi.os "darwin" }}
  mkdir -p "{{ .chezmoi.homeDir }}/Library/LaunchAgents"
	if launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/$launchagent_name.plist" 2>/dev/null; then
		echo "⏰ $binary_name auto-update scheduled"
	else
		echo "⏰ $binary_name auto-update already configured"
	fi
	{{- end }}

	echo "✅ $binary_name setup complete"
}

echo "🚀 Installing mise..."

# Install native mise for system architecture
install_mise_arch "{{ if eq .chezmoi.arch "amd64" }}x64{{ else }}arm64{{ end }}" "{{ .architectures.native.binary }}" "{{ .chezmoi.arch }}" "{{ .architectures.native.launchagent }}"

# Install mise-x64 (for Node.js 14 compatibility) only on Apple Silicon
{{- if and (eq .chezmoi.arch "arm64") (.architectures.x64_variant.install_on_arm64) }}
install_mise_arch "{{ .architectures.x64_variant.arch }}" "{{ .architectures.x64_variant.binary }}" "{{ .architectures.x64_variant.description }}" "{{ .architectures.x64_variant.launchagent }}"
{{- end }}

echo "🎉 All mise installations complete"

# Setup mise upgrade LaunchAgent (only for native mise, not mise-x64, macOS only)
{{- if eq .chezmoi.os "darwin" }}
if launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/com.user.mise-upgrade.plist" 2>/dev/null; then
	echo "⏰ mise upgrade scheduled (weekly on Mondays at 10:00 AM)"
else
	echo "⏰ mise upgrade already configured"
fi
{{- end }}

