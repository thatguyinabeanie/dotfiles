#!/bin/bash
# Install x86_64 version of mise for Node.js 14 compatibility on Apple Silicon

set -euo pipefail

# Only run on macOS
if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "Skipping mise-x64 installation: not on macOS"
    exit 0
fi

# Only run on Apple Silicon
if [[ "$(uname -m)" != "arm64" ]]; then
    echo "Skipping mise-x64 installation: not on Apple Silicon"
    exit 0
fi

# Create ~/.local/bin if it doesn't exist
mkdir -p "$HOME/.local/bin"

# Check if mise-x64 is already installed and up to date
MISE_X64_PATH="$HOME/.local/bin/mise-x64"
TARGET_VERSION="2025.7.31"

if [[ -f "$MISE_X64_PATH" ]]; then
    CURRENT_VERSION=$("$MISE_X64_PATH" --version 2>/dev/null | grep -o 'v[0-9]\+\.[0-9]\+\.[0-9]\+' | head -1 | sed 's/v//' || echo "unknown")
    if [[ "$CURRENT_VERSION" == "$TARGET_VERSION" ]]; then
        echo "mise-x64 v$TARGET_VERSION already installed"
        exit 0
    else
        echo "Updating mise-x64 from v$CURRENT_VERSION to v$TARGET_VERSION"
    fi
else
    echo "Installing mise-x64 v$TARGET_VERSION for Node.js 14 compatibility"
fi

# Create temporary directory
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

cd "$TEMP_DIR"

# Download the x86_64 version of mise
echo "Downloading mise v$TARGET_VERSION for x86_64..."
curl -fsSL "https://github.com/jdx/mise/releases/download/v$TARGET_VERSION/mise-v$TARGET_VERSION-macos-x64.tar.gz" -o mise-x64.tar.gz

# Extract it
echo "Extracting mise-x64..."
tar -xzf mise-x64.tar.gz

# Move the binary to ~/.local/bin
echo "Installing mise-x64 to ~/.local/bin/mise-x64..."
cp mise/bin/mise "$MISE_X64_PATH"

# Make it executable
chmod +x "$MISE_X64_PATH"

# Verify installation
echo "Verifying installation..."
if "$MISE_X64_PATH" --version >/dev/null 2>&1; then
    VERSION_OUTPUT=$("$MISE_X64_PATH" --version)
    echo "✅ mise-x64 installed successfully: $VERSION_OUTPUT"
else
    echo "❌ mise-x64 installation failed - binary not working"
    exit 1
fi

echo "🎉 mise-x64 is now available for Node.js 14 projects"
echo "Usage: Set 'MISE_ARCH = \"x86_64\"' in your project's .mise.toml"