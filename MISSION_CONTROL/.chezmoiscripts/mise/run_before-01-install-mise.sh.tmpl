#!/bin/bash
# Unified mise installation - handles both regular mise and mise-x64
# Uses pure chezmoi template logic for 18-hour caching

{{- $cacheFile := joinPath .chezmoi.homeDir ".local/share/mise-last-install" -}}
{{- $currentTime := output "date" "+%s" | trim | int -}}
{{- $eighteenHours := 64800 -}}
{{- $lastInstall := 0 }}

{{- if stat $cacheFile }}
  {{- $lastInstall = include $cacheFile | trim | int }}
{{- else }}
# Create cache file with epoch timestamp to ensure it always exists
mkdir -p "{{ joinPath .chezmoi.homeDir ".local/share" }}"
echo "0" > "{{ $cacheFile }}"
{{- end }}

{{- if lt (sub $currentTime $lastInstall) $eighteenHours }}
# Cache hit - mise installed within 18 hours, skipping
exit 0
{{- end }}

set -euo pipefail

# Function to install mise with specified architecture
install_mise_arch() {
	local arch="$1"
	local binary_name="$2"
	local description="$3"
	local launchagent_name="$4"

	echo "🔧 Installing $binary_name ($description)..."

	# Configure mise installation
	export MISE_INSTALL_ARCH="$arch"
	export MISE_INSTALL_PATH="$HOME/.local/bin/$binary_name"
	export MISE_QUIET="true"

	# Run unified installer
	"{{ .chezmoi.sourceDir }}/.chezmoitemplates/mise/install-or-update.sh"

	# Load and start LaunchAgent for daily updates
	if launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/$launchagent_name.plist" 2>/dev/null; then
		echo "⏰ $binary_name auto-update scheduled"
	else
		echo "⏰ $binary_name auto-update already configured"
	fi

	echo "✅ $binary_name setup complete"
}

# Detect system architecture
SYSTEM_ARCH=$(command uname -m)

# Install regular mise (native architecture)
if [[ "$SYSTEM_ARCH" == "arm64" ]]; then
	install_mise_arch "arm64" "mise" "arm64" "com.user.mise-update"
elif [[ "$SYSTEM_ARCH" == "x86_64" ]]; then
	install_mise_arch "x64" "mise" "x64" "com.user.mise-update"
else
	echo "❌ Unsupported architecture: $SYSTEM_ARCH"
	exit 1
fi

# Install mise-x64 (for Node.js 14 compatibility) only on Apple Silicon
if [[ "$SYSTEM_ARCH" == "arm64" ]]; then
	install_mise_arch "x64" "mise-x64" "for Node.js 14 compatibility" "com.user.mise-x64-update"
fi

echo "🎉 All mise installations complete"

# Setup mise upgrade LaunchAgent (only for native mise, not mise-x64)
if launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/com.user.mise-upgrade.plist" 2>/dev/null; then
	echo "⏰ mise upgrade scheduled (weekly on Mondays at 10:00 AM)"
else
	echo "⏰ mise upgrade already configured"
fi

# Update cache timestamp using pure chezmoi template
mkdir -p "{{ joinPath .chezmoi.homeDir ".local/share" }}"
echo "{{ $currentTime }}" > "{{ $cacheFile }}"
