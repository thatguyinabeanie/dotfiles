#!/bin/bash
{{- /* Cross-platform machine identity detection and setup */ -}}

set -euo pipefail

# Detect the best storage method for the current platform
detect_storage_method() {
    local os_type="$(uname -s)"
    
    case "${os_type}" in
        Darwin*)
            echo "macos_defaults"
            ;;
        Linux*)
            # Check for available storage methods in order of preference
            if command -v dconf >/dev/null 2>&1; then
                echo "dconf"
            elif command -v gsettings >/dev/null 2>&1; then
                echo "gsettings"
            else
                echo "xdg_config"
            fi
            ;;
        *)
            echo "xdg_config"  # Fallback to XDG for other Unix-like systems
            ;;
    esac
}

# Read a machine identity value
read_machine_identity() {
    local key="$1"
    local storage_method="${2:-$(detect_storage_method)}"
    
    case "${storage_method}" in
        macos_defaults)
            defaults read com.chezmoi.machine "${key}" 2>/dev/null || echo ""
            ;;
        dconf)
            local dconf_key="/com/chezmoi/machine/${key//_/-}"
            dconf read "${dconf_key}" 2>/dev/null | sed 's/^.\(.*\).$/\1/' || echo ""
            ;;
        gsettings)
            gsettings get com.chezmoi.machine "${key//_/-}" 2>/dev/null | sed 's/^.\(.*\).$/\1/' || echo ""
            ;;
        xdg_config)
            local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/machine-identity"
            if [[ -f "${config_file}" ]]; then
                grep "^${key}=" "${config_file}" 2>/dev/null | cut -d'=' -f2- | sed 's/^"\(.*\)"$/\1/' || echo ""
            else
                echo ""
            fi
            ;;
    esac
}

# Write a machine identity value
write_machine_identity() {
    local key="$1"
    local value="$2"
    local storage_method="${3:-$(detect_storage_method)}"
    
    case "${storage_method}" in
        macos_defaults)
            case "${key}" in
                work_environment)
                    defaults write com.chezmoi.machine "${key}" -bool "${value}"
                    ;;
                *)
                    defaults write com.chezmoi.machine "${key}" -string "${value}"
                    ;;
            esac
            ;;
        dconf)
            local dconf_key="/com/chezmoi/machine/${key//_/-}"
            case "${key}" in
                work_environment)
                    dconf write "${dconf_key}" "${value,,}"
                    ;;
                *)
                    dconf write "${dconf_key}" "'${value}'"
                    ;;
            esac
            ;;
        gsettings)
            local gsettings_key="${key//_/-}"
            case "${key}" in
                work_environment)
                    gsettings set com.chezmoi.machine "${gsettings_key}" "${value,,}"
                    ;;
                *)
                    gsettings set com.chezmoi.machine "${gsettings_key}" "${value}"
                    ;;
            esac
            ;;
        xdg_config)
            local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/machine-identity"
            local config_dir="$(dirname "${config_file}")"
            
            mkdir -p "${config_dir}"
            
            if [[ -f "${config_file}" ]]; then
                if grep -q "^${key}=" "${config_file}"; then
                    sed -i.bak "s|^${key}=.*|${key}=\"${value}\"|" "${config_file}"
                    rm -f "${config_file}.bak"
                else
                    echo "${key}=\"${value}\"" >> "${config_file}"
                fi
            else
                cat > "${config_file}" << EOF
# Machine identity configuration
# Generated by chezmoi machine identity system
${key}="${value}"
EOF
            fi
            ;;
    esac
}

# Check if machine identity is configured
is_machine_identity_configured() {
    local storage_method="${1:-$(detect_storage_method)}"
    local work_env="$(read_machine_identity "work_environment" "${storage_method}")"
    local machine_type="$(read_machine_identity "machine_type" "${storage_method}")"
    
    [[ -n "${work_env}" || -n "${machine_type}" ]]
}

# Only run machine identity setup if not already configured
if ! is_machine_identity_configured; then
    echo "🔧 Setting up machine identity (first time setup)"
    
    # Detect storage method
    STORAGE_METHOD="$(detect_storage_method)"
    echo "📦 Using storage method: ${STORAGE_METHOD}"
    
    # Get current values from environment or defaults
    CURRENT_HOSTNAME="$(hostname)"
    WORK_ENV="${WORK_ENVIRONMENT:-{{ .WORK_ENVIRONMENT | default "false" }}}"
    WORK_ORG="${WORK_ORG:-{{ get . "WORK_ORG" | default "" }}}"
    MACHINE_TYPE="${MACHINE_TYPE:-{{ get . "machine_type" | default "laptop" }}}"
    
    # Use hostname mapping if available
{{- $hostname_configs := dict
  "gmendoza-personal" (dict
    "work_environment" false
    "work_org" ""
    "machine_type" "personal-laptop"
  )
  "gmendoza-work-mbp" (dict
    "work_environment" true
    "work_org" "mycompany"
    "machine_type" "work-laptop"
  )
  "gmendoza-homelab" (dict
    "work_environment" false
    "work_org" ""
    "machine_type" "server"
  )
  "gmendoza-gaming-rig" (dict
    "work_environment" false
    "work_org" ""
    "machine_type" "desktop"
  )
-}}

{{- $host_config := get $hostname_configs (.hostname | default (output "hostname" | trim)) | default dict -}}
{{- if $host_config }}
    # Hostname-based configuration detected
    WORK_ENV="{{ get $host_config "work_environment" | default "false" }}"
    WORK_ORG="{{ get $host_config "work_org" | default "" }}"
    MACHINE_TYPE="{{ get $host_config "machine_type" | default "laptop" }}"
    echo "📍 Using configuration for hostname: {{ .hostname | default (output "hostname" | trim) }}"
{{- else }}
    echo "📍 No hostname mapping found for: {{ .hostname | default (output "hostname" | trim) }}"
    echo "   Using environment variables or defaults"
{{- end }}
    
    # Persist machine identity
    echo "💾 Saving machine identity using ${STORAGE_METHOD}..."
    write_machine_identity "work_environment" "${WORK_ENV}" "${STORAGE_METHOD}"
    write_machine_identity "work_org" "${WORK_ORG}" "${STORAGE_METHOD}"
    write_machine_identity "machine_type" "${MACHINE_TYPE}" "${STORAGE_METHOD}"
    write_machine_identity "setup_date" "$(date -Iseconds)" "${STORAGE_METHOD}"
    
    echo ""
    echo "✅ Machine identity configured:"
    echo "   Storage method: ${STORAGE_METHOD}"
    echo "   Work Environment: ${WORK_ENV}"
    echo "   Work Org: ${WORK_ORG}"
    echo "   Machine Type: ${MACHINE_TYPE}"
    echo "   Hostname: ${CURRENT_HOSTNAME}"
else
    echo "✅ Machine identity already configured"
fi