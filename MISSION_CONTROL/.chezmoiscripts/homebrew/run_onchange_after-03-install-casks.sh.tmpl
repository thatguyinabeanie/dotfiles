#!/bin/sh

# casks.yaml-hash: {{ include ".chezmoidata/homebrew/casks.yaml" | sha256sum }}

{{ template "homebrew-helpers.sh" . }}

{{ if eq .chezmoi.os "darwin" -}}
check_brew "casks"

# Build casks content
CASKS=""

# Always add shared casks
{{ range .casks.shared -}}
CASKS="${CASKS}cask \"{{ . }}\"
"
{{ end }}

# Add environment-specific casks
{{ if and (hasKey . "WORK_ENVIRONMENT") (eq .WORK_ENVIRONMENT true) -}}
# Add work casks
{{ range .casks.work -}}
CASKS="${CASKS}cask \"{{ . }}\"
"
{{ end }}
{{ else -}}
# Add personal casks
{{ range .casks.personal -}}
CASKS="${CASKS}cask \"{{ . }}\"
"
{{ end }}
{{ end -}}

install_packages "casks" "$CASKS"
{{ else -}}
echo "⏭️  Skipping casks (not on macOS)"
{{ end -}}