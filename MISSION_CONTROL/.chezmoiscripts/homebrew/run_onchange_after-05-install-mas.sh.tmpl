#!/bin/sh

# mas.yaml-hash: {{ include ".chezmoidata/homebrew/mas.yaml" | sha256sum }}

{{ template "homebrew-helpers.sh" . }}

{{ if eq .chezmoi.os "darwin" -}}
{{ if or (eq (hasKey . "WORK_ENVIRONMENT") false) (eq .WORK_ENVIRONMENT false) -}}
check_brew "mas apps"

# Build MAS apps content
MAS_APPS=""

{{ range .mas -}}
MAS_APPS="${MAS_APPS}mas {{ . }}
"
{{ end }}

install_packages "mas" "$MAS_APPS"
{{ else -}}
echo "⏭️  Skipping MAS apps (in work environment)"
{{ end -}}
{{ else -}}
echo "⏭️  Skipping MAS apps (not on macOS)"
{{ end -}}