#!/bin/sh

# homebrew.yaml-hash: {{ (toYaml .homebrew | sha256sum) }}
{{ if (lookPath "brew") -}}
echo "🟠 Installing/Updating homebrew packages..."

# Create a temporary Brewfile
BREWFILE=$(mktemp)

cat > "$BREWFILE" << 'EOF'
##
## SHARED PACKAGES
##
{{ range .homebrew.shared.taps }}
tap {{ . | quote }}
{{ end }}
{{ range .homebrew.shared.brews }}
brew {{ . | quote }}
{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
## macOS-specific casks and fonts
{{ range .homebrew.shared.casks }}
cask {{ . | quote }}
{{ end }}

{{ if env "CHEZMOI_INTERACTIVE" | eq "1" -}}
## Fonts (will be installed if user confirms later)
{{ range .homebrew.shared.fonts }}
# FONT: cask {{ . | quote }}
{{ end }}
{{ end -}}

##
## WORK PACKAGES
##
{{ if and (hasKey . "WORK_ENVIRONMENT") (eq .WORK_ENVIRONMENT true) }}
{{ range .homebrew.work.brews }}
brew {{ . | quote }}
{{ end }}

{{ if env "CHEZMOI_INTERACTIVE" | eq "1" -}}
## Work casks (will be installed if user confirms later)
{{ range .homebrew.work.casks }}
# WORK: cask {{ . | quote }}
{{ end }}
{{ end -}}
{{ end }}

##
## PERSONAL PACKAGES
##
{{ if or (eq (hasKey . "WORK_ENVIRONMENT") false) (eq .WORK_ENVIRONMENT false) }}
{{ range .homebrew.personal.brews }}
brew {{ . | quote }}
{{ end }}

{{ if env "CHEZMOI_INTERACTIVE" | eq "1" -}}
## Personal casks (will be installed if user confirms later)
{{ range .homebrew.personal.casks }}
# PERSONAL: cask {{ . | quote }}
{{ end }}

## Mac App Store apps (will be installed if user confirms later)
{{ range .homebrew.personal.mas }}
# MAS: mas {{ . }}
{{ end }}
{{ end -}}
{{ end }}
{{ end -}}
EOF

# Run brew bundle
brew bundle --file="$BREWFILE" || echo "Some Homebrew packages failed to install"

# Clean up
rm "$BREWFILE"

# Handle interactive installations
{{ if env "CHEZMOI_INTERACTIVE" | eq "1" -}}
# Extract commented items from Brewfile for interactive installation
PERSONAL_CASKS=$(grep "# PERSONAL: cask" "$BREWFILE" | sed 's/# PERSONAL: cask //g')
WORK_CASKS=$(grep "# WORK: cask" "$BREWFILE" | sed 's/# WORK: cask //g')
FONTS=$(grep "# FONT: cask" "$BREWFILE" | sed 's/# FONT: cask //g')
MAS_APPS=$(grep "# MAS: mas" "$BREWFILE" | sed 's/# MAS: mas //g')

# Install fonts if user confirms
if [ -n "$FONTS" ]; then
  echo "Do you want to install fonts? (y/N)"
  read -r install_fonts
  if [ "$install_fonts" = "y" ] || [ "$install_fonts" = "Y" ]; then
    echo "$FONTS" | xargs -L1 brew install --cask
  fi
fi

# Install work casks if user confirms
if [ -n "$WORK_CASKS" ]; then
  echo "Do you want to install work casks? (y/N)"
  read -r install_work_casks
  if [ "$install_work_casks" = "y" ] || [ "$install_work_casks" = "Y" ]; then
    echo "$WORK_CASKS" | xargs -L1 brew install --cask
  fi
fi

# Install personal casks if user confirms
if [ -n "$PERSONAL_CASKS" ]; then
  echo "Do you want to install personal casks? (y/N)"
  read -r install_personal_casks
  if [ "$install_personal_casks" = "y" ] || [ "$install_personal_casks" = "Y" ]; then
    echo "$PERSONAL_CASKS" | xargs -L1 brew install --cask
  fi
fi

# Install Mac App Store apps if user confirms
if [ -n "$MAS_APPS" ]; then
  echo "Do you want to install Mac App Store apps? (y/N)"
  read -r install_mas
  if [ "$install_mas" = "y" ] || [ "$install_mas" = "Y" ]; then
      echo "$MAS_APPS" | xargs -L1 brew  
  fi
fi
{{ end -}}

echo "🔵 Installed/updated homebrew packages."
{{ else -}}
echo "Homebrew is not installed. Skipping package installation."
{{ end -}}
