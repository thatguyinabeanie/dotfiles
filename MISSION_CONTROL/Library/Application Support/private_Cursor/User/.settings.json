{
    "window.commandCenter": 1,
    "workbench.colorTheme": "Catppuccin Mocha",
    "augment.nextEdit.enableGlobalBackgroundSuggestions": true,
    "augment.nextEdit.showDiffInHover": true,
    "augment.nextEdit.highlightSuggestionsInTheEditor": true,
    "workbench.iconTheme": "catppuccin-Mocha",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "redhat.telemetry.enabled": true,
    "explorer.confirmDragAndDrop": false,
    "terminal.external.osxExec": "ghostty.app",
    "terminal.external.linuxExec": "ghostty",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.stickyScroll.enabled": true,
    "editor.fontSize": 20,
    "mise.binPath": "/opt/homebrew/bin/mise",
    "github.copilot.enable": {
        "*": false
    },
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "git.autofetch": false,
    "cursor.cpp.disabledLanguages": [
        "plaintext",
        "markdown",
        "scminput"
    ],
    "cursor.cpp.enablePartialAccepts": true,
    "cursor.general.gitGraphIndexing": "enabled",
    "files.associations": {
        "*.toml.tmpl": "toml",
        "*.nu.tmpl": "nu"
    },
    "editor.tabSize": 2,
    "files.exclude": {
        "**/.node_modules": true
    },
    "augment.chat.userGuidelines": "",
    "workbench.editor.editorActionsLocation": "titleBar",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true
}
