#!/bin/sh

# Check if Rust is already installed via mise
if command -v rustc >/dev/null 2>&1; then
  rustc_path=$(which rustc)
  if echo "$rustc_path" | grep -q "mise"; then
    echo "🟠 Rust is already managed by mise, skipping rustup installation..."
    echo "🔵 Using mise-managed Rust toolchain."
    RUST_INSTALLED=true
  fi
else
  RUST_INSTALLED=false
fi

# Install Rust via rustup if not already installed via mise
if [ "$RUST_INSTALLED" != "true" ]; then
  echo "🟠 Installing/Updating Rust toolchain via rustup..."
  
  {{ if env "CODESPACES" -}}
  # Use minimal profile for Codespaces to save space
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path >/dev/null 2>&1
  {{ else -}}
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly --profile default --no-modify-path >/dev/null 2>&1
  {{ end -}}
  
  echo "🔵 Rust toolchain installed/updated via rustup."
  
  # Source the environment for the current session
  . "$HOME/.cargo/env"
fi
