{{- /*
  CHEZMOI CONFIGURATION TEMPLATE
  
  This template generates the main chezmoi configuration file based on:
  - Environment detection (interactive vs automated)
  - Platform detection (GitHub Codespaces, local machine, CI/CD)
  - User preferences (collected via prompts in interactive mode)
  
  The template supports both manual setup (with prompts) and automated deployment
  (using environment variables or defaults).
*/ -}}

{{- /* =================== INTERACTIVE MODE DETECTION =================== */ -}}
{{- /* Determine if we're in an interactive session where we can prompt the user */ -}}
{{- $interactive := false -}}

{{- /* Check explicit CHEZMOI_INTERACTIVE environment variable first */ -}}
{{- if eq (env "CHEZMOI_INTERACTIVE") "1" -}}
  {{- $interactive = true -}}
{{- else if eq (env "CHEZMOI_INTERACTIVE") "0" -}}
  {{- $interactive = false -}}
{{- else -}}
  {{- /* Fall back to checking if stdin is a TTY (terminal session) */ -}}
  {{- $interactive = stdinIsATTY -}}
{{- end -}}

{{- /* =================== DEFAULT VALUES =================== */ -}}
{{- /* Set sensible defaults for non-interactive environments (CI/CD, scripts) */ -}}
{{- $opacity := 0.8 }}              {{/* Terminal transparency level */ -}}
{{- $blur := 20 }}                  {{/* Terminal background blur amount */ -}}
{{- $font_size := 24 }}             {{/* Default font size for terminals */ -}}
{{- $font_family := "Dank Mono" }}  {{/* Preferred monospace font */ -}}
{{- $window_height := 65 }}         {{/* Terminal window height (rows) */ -}}
{{- $window_width := 160 }}         {{/* Terminal window width (columns) */ -}}
{{- $refreshPeriod := 168 }}        {{/* External repo refresh period (hours) */ -}}

{{- /* =================== ENVIRONMENT DETECTION =================== */ -}}
{{- $is_codespace := false -}}
{{- /* Check if we're running in a GitHub Codespace environment */ -}}
{{- if env "CODESPACES" | not | not -}}
  {{- $is_codespace = true -}}
{{- end -}}

{{- /* =================== GIT CONFIGURATION SETUP =================== */ -}}
{{- /* Initialize Git configuration variables */ -}}
{{- $GIT_NAME := "" -}}
{{- $GITHUB_USERNAME := "" -}}
{{- $GIT_EMAIL := "" -}}

{{- /* Set Git configuration based on environment */ -}}
{{- if $is_codespace -}}
  {{- /* GitHub Codespaces: Use GitHub user information */ -}}
  {{- $GIT_NAME = env "GITHUB_USER" | default "GitHub Codespaces User" -}}
  {{- $GITHUB_USERNAME = env "GITHUB_USER" | default "github-user" -}}
  {{- /* Use GitHub's noreply email for Codespaces */ -}}
  {{- $GIT_EMAIL = printf "%s@users.noreply.github.com" $GITHUB_USERNAME -}}
{{- else -}}
  {{- /* Local/CI environment: Use environment variables or defaults */ -}}
  {{- $GIT_NAME = env "GIT_NAME" | default "GitHub Actions" -}}
  {{- $GITHUB_USERNAME = env "GITHUB_USERNAME" | default "github-actions" -}}
  {{- $GIT_EMAIL = env "GIT_EMAIL" | default "github-actions@github.com" -}}
{{- end -}}

{{- /* =================== DEFAULT PREFERENCES =================== */ -}}
{{- /* Set default values for user preferences */ -}}
{{- $WORK_ENVIRONMENT := false }}       {{/* Personal environment by default */ -}}
{{- $SHELL := "nu" }}                   {{/* Nushell as default shell */ -}}
{{- $CATPPUCCIN_FLAVOR := "mocha" }}    {{/* Dark theme as default */ -}}

{{- /* =================== INTERACTIVE PROMPTS =================== */ -}}
{{- /* Only prompt for values in interactive mode (manual setup) */ -}}
{{- if $interactive }}
    {{- /* Git configuration prompts */ -}}
    {{- $GIT_NAME = promptStringOnce . "git.config.name" "👥 Git Config 👥 - Name" (env "GIT_NAME" | default "") -}}
    {{- $GITHUB_USERNAME = promptStringOnce . "git.config.username" "👥 Git Config 👥 - Github Username" (env "GITHUB_USERNAME" | default "") -}}
    
    {{- /* Work environment detection affects email and repository setup */ -}}
    {{- $WORK_ENVIRONMENT = promptBoolOnce . "WORK_ENVIRONMENT" "💻 Is this environment for work" false -}}
    
    {{- /* Email prompt changes based on work vs personal environment */ -}}
    {{- if eq $WORK_ENVIRONMENT true }}
        {{- $GIT_EMAIL = promptStringOnce . "git.config.email" "👥 Git Config 👥 - Work Email" (env "GIT_EMAIL" | default "") -}}
    {{- else }}
        {{- $GIT_EMAIL = promptStringOnce . "git.config.email" "👥 Git Config 👥 - Email" (env "GIT_EMAIL" | default "") -}}
    {{- end }}
    
    {{- /* Shell preference selection */ -}}
    {{- $SHELL_OPTIONS := list "nu" "zsh" -}}
    {{- $SHELL = promptChoiceOnce . "SHELL" "💻 What is your preferred shell" $SHELL_OPTIONS "nu" -}}
    
    {{- /* Theme preference selection */ -}}
    {{- $CATPPUCCIN_FLAVORS := list "mocha" "macchiatto" "frappe" "latte" -}}
    {{- $CATPPUCCIN_FLAVOR = promptChoiceOnce . "CATPPUCCIN_FLAVOR" "🌈 Select a Catppuccin flavor)" $CATPPUCCIN_FLAVORS "mocha" -}}
{{- end }}

{{- /* =================== CONFIGURATION OUTPUT =================== */ -}}
{{- /* Generate the final configuration file */ -}}

[data]
{{- /* ===== CORE PREFERENCES ===== */ -}}
SHELL                      = {{ $SHELL | quote }}
WORK_ENVIRONMENT           = {{ $WORK_ENVIRONMENT }}
CATPPUCCIN_FLAVOR          = {{ $CATPPUCCIN_FLAVOR | quote }}

{{- /* ===== THEME SYSTEM CONFIGURATION ===== */ -}}
{{- /* These control the advanced theme switching system */ -}}
THEME_MODE                 = "dark"                    {{/* Options: "system", "dark", "light" */ -}}
THEME_LIGHT                = "catppuccin-latte"        {{/* Light theme variant */ -}}
THEME_DARK                 = "catppuccin-mocha"        {{/* Dark theme variant */ -}}

{{- /* ===== APPLICATION SETTINGS ===== */ -}}
OBSIDIAN_VAULT_PERSONAL    = "obsidian-vault"          {{/* Personal knowledge vault */ -}}
OBSIDIAN_VAULT_WORK        = "obsidian-vault-work"     {{/* Work knowledge vault */ -}}
YAZI_CATPPUCCIN_COLOR      = "blue"                    {{/* File manager accent color */ -}}
SUDO_TOUCHID               = "true"                    {{/* Enable Touch ID for sudo (macOS) */ -}}
INTERACTIVE                = {{ $interactive }}        {{/* Track if this was an interactive setup */ -}}

{{- /* ===== K9S TERMINAL UI CONFIGURATION ===== */ -}}
[data.k9s]
transparent                = {{ lt $opacity 1.0 }}     {{/* Enable transparency if opacity < 1.0 */ -}}

{{- /* ===== GHOSTTY TERMINAL CONFIGURATION ===== */ -}}
[data.ghostty]
window_height              = {{ $window_height | quote }}
window_width               = {{ $window_width | quote }}
opacity                    = {{ $opacity | quote }}
blur                       = {{ $blur | quote }}
font_size                  = {{ $font_size | quote }}
font_thicken               = true                       {{/* Enable font thickening for readability */ -}}
font_family                = {{ $font_family | quote }}
cursor_style               = "block_hollow"            {{/* Hollow block cursor style */ -}}

{{- /* ===== KITTY TERMINAL CONFIGURATION ===== */ -}}
[data.kitty]
window_height              = {{ $window_height | quote }}
window_width               = {{ $window_width | quote }}
opacity                    = {{ $opacity | quote }}
blur                       = {{ $blur | quote }}
font_size                  = {{ $font_size | quote }}
font_family                = {{ $font_family | quote }}

{{- /* ===== GIT & GITHUB CONFIGURATION ===== */ -}}
[data.git.config]
name                       = {{ $GIT_NAME | quote }}
username                   = {{ $GITHUB_USERNAME | quote }}
email                      = {{ $GIT_EMAIL | quote }}
defaultRefreshPeriod       = "{{ $refreshPeriod }}h"   {{/* How often to refresh external repos */ -}}
work_org                   = "totally_real_git_org_for_work"  {{/* Placeholder for work organization */ -}}

{{- /* ===== INSTALLATION FLAGS ===== */ -}}
[data.install]
obsidian                   = true                       {{/* Enable Obsidian installation */ -}}

{{- /* ===== CHEZMOI INTERNAL SETTINGS ===== */ -}}
[warnings]
configFileTemplateHasChanged = false                   {{/* Suppress template change warnings */ -}}

{{- /* ===== AI INTEGRATION CONFIGURATION ===== */ -}}
[data.ai]
gemini_api_key             = "replace_with_gemini_api_key"  {{/* Placeholder for Gemini API key */ -}}
