#!/bin/bash
# Task to install Python development tools and MCP servers
# Run with: mise run install-python-tools
# Packages are defined in .chezmoidata/mise.yaml

set -euo pipefail

echo "🐍 Installing Python development tools and MCP servers..."

# Python packages from mise.yaml (injected via Chezmoi templating)
PACKAGES=(
{{- range .mise.python_packages }}
	"{{ .name }}"  # {{ .description }}
{{- end }}
)

echo "📋 Found ${#PACKAGES[@]} Python packages to install"

# Install Python packages using uv (fastest option) or pipx
if command -v uv &>/dev/null; then
	echo "📦 Installing with uv..."
	for package in "${PACKAGES[@]}"; do
		if [[ -n "$package" ]]; then
			echo "  Installing $package..."
			uv tool install "$package" || echo "  ⚠️  Failed to install $package"
		fi
	done
elif command -v pipx &>/dev/null; then
	echo "📦 Installing with pipx..."
	for package in "${PACKAGES[@]}"; do
		if [[ -n "$package" ]]; then
			echo "  Installing $package..."
			pipx install "$package" || echo "  ⚠️  Failed to install $package"
		fi
	done
else
	echo "⚠️  No suitable Python package manager found (uv or pipx)"
	echo "   Install uv or pipx first"
	exit 1
fi

echo "✅ Python development tools and MCP servers installed!"
