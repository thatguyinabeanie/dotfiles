# Basic LastPass aliases
alias lp = lpass
alias lpl = lpass ls
alias lps = lpass show
alias lpe = lpass edit
alias lpa = lpass add
alias lpg = lpass generate
alias lpsync = lpass sync

# Enhanced LastPass functions
def lpass_search [search_term: string] {
    lpass ls | grep -i $search_term
}

def lpass_copy [site_name: string] {
    lpass show -c --password $site_name
    print "Password copied to clipboard"
}

def lpass_show_user [site_name: string] {
    lpass show --username $site_name
}

def lpass_show_url [site_name: string] {
    lpass show --url $site_name
}

# Interactive LastPass search with fzf
def lpass_fzf [] {
    let selected = (lpass ls | fzf --height 40% --reverse)
    if ($selected | is-not-empty) {
        let name = ($selected | str replace --regex '.*\[id: [0-9]*\] *' '')
        lpass show -c --password $name
        print $"Password for '($name)' copied to clipboard"
    }
}

# Quick login check
def lpass_status [] {
    try {
        let status = (lpass status)
        print "✅ Logged in to LastPass"
        print $status
    } catch {
        print "❌ Not logged in to LastPass"
        print "Run: lpass login <username>"
    }
}

# Quick login function with your email
def lpass_login [] {
    print "🔐 Logging in to LastPass..."
    let result = (try { lpass login --trust gmendoza@civisanalytics.com } catch { null })
    if ($result != null) {
        print "✅ Successfully logged in to LastPass"
