##
## DOCKER MANAGEMENT
##

# Purge all Docker containers, volumes, and images
# ⚠️ WARNING: This is a destructive operation that removes ALL Docker data
# 
# What gets removed:
#   • All containers (running and stopped)
#   • All volumes (data will be lost!)
#   • All images (will need to re-download)
#   • All networks and build cache
#
# Usage: docker_purge [--force]
# --force: Skip confirmation prompts (use with extreme caution!)
# Example: docker_purge --force  # Dangerous - skips all confirmations
def docker_purge [
    --force (-f) = false  # Skip confirmation prompt
] {
    # Safety confirmation unless force flag is used
    if not $force {
        print "⚠️  WARNING: This will remove ALL Docker data including:"
        print "   • All containers (running and stopped)"
        print "   • All volumes (data will be lost!)"
        print "   • All images (will need to re-download)"
        print "   • All networks and build cache"
        print ""
        
        let confirm = (input "Are you sure you want to continue? (y/N): ")
        if ($confirm | str downcase) != "y" and ($confirm | str downcase) != "yes" {
            print "Operation cancelled."
            return
        }
    }
    
    print "🧹 Starting Docker system purge..."
    
    # Remove all containers (running containers will be stopped first)
    print "🧹 Purging Docker containers..."
    try { docker container prune -f } catch { print "ℹ️  No containers to remove" }
    
    # Remove all volumes (THIS DESTROYS DATA!)
    print "🧹 Purging Docker volumes..."
    try { docker volume prune -a -f } catch { print "ℹ️  No volumes to remove" }
    
    # Remove all images (forces re-download)
    print "🧹 Purging Docker images..."
    try { docker image prune -a -f } catch { print "ℹ️  No images to remove" }
    
    # Remove unused networks
    print "🧹 Purging Docker networks..."
    try { docker network prune -f } catch { print "ℹ️  No networks to remove" }
    
    # Remove build cache (saves disk space)
    print "🧹 Purging Docker build cache..."
    try { docker builder prune -a -f } catch { print "ℹ️  No build cache to remove" }
    
    print "✅ Docker purge complete!"
    print ""
    
    # Show remaining disk usage for verification
    print "📊 Remaining Docker disk usage:"
    try { docker system df } catch { print "Could not display disk usage" }
}

# Quick alias for docker purge with force flag
# Bypasses all confirmation prompts - use with extreme caution!
# Equivalent to: docker_purge --force
# ⚠️ DANGER: This will immediately destroy all Docker data without confirmation
def docker_nuke [] {
    docker_purge --force true
}

