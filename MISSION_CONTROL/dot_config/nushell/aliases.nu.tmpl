}

# Store password in macOS Keychain (safer)
def lpass_store_password [] {
    print "This will store your LastPass master password in macOS Keychain"
    let password = (input --suppress-output "Enter your LastPass master password: ")
    echo $password | security add-generic-password -a "gmendoza@civisanalytics.com" -s "lastpass-cli" -w
    print "✅ Password stored in macOS Keychain"
}

# Login using stored password from Keychain
def lpass_login_keychain [] {
    print "🔐 Logging in to LastPass using stored password..."
    let password = (try { 
        security find-generic-password -a "gmendoza@civisanalytics.com" -s "lastpass-cli" -w 
    } catch { null })
    
    if ($password != null) {
        let result = (try { 
            echo $password | lpass login --trust gmendoza@civisanalytics.com 
        } catch { null })
        
        if ($result != null) {
            print "✅ Successfully logged in to LastPass"
            lpass sync
        } else {
            print "❌ Login failed"
        }
    } else {
        print "❌ No password found in Keychain. Run 'lpass_store_password' first."
    }
}

# ⚠️ RISKY: Login using environment variable (NOT RECOMMENDED)
def lpass_login_env [] {
    if ($env.LPASS_PASSWORD? == null) {
        print "❌ LPASS_PASSWORD environment variable not set"
        print "Set it with: $env.LPASS_PASSWORD = 'your_password'"
        print "⚠️  WARNING: This is insecure!"
        return
    }
    
    print "🔐 Logging in to LastPass using environment variable..."
    let result = (try { 
        echo $env.LPASS_PASSWORD | lpass login --trust gmendoza@civisanalytics.com 
    } catch { null })
    
    if ($result != null) {
        print "✅ Successfully logged in to LastPass"
        lpass sync
    } else {
        print "❌ Login failed"
    }
}

