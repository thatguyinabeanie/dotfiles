# Generated from consolidated environment configuration
# Edit MISSION_CONTROL/.chezmoidata/environment/ files to modify

{{ $shared := (include ".chezmoidata/environment/shared.yaml" | fromYaml) -}}
{{ $path := (include ".chezmoidata/environment/path.yaml" | fromYaml) -}}
{{ $work := (include ".chezmoidata/environment/work.yaml" | fromYaml) -}}

##
## SIMPLE VARIABLES
##
{{ range $key, $value := $shared.variables -}}
$env.{{ $key }} = "{{ $value }}"
{{ end }}

##
## TEMPLATE VARIABLES
##
{{ range $key, $value := $shared.template_variables -}}
$env.{{ $key }} = "{{ $value }}"
{{ end }}

##
## PATH-BASED VARIABLES
##
{{ range $key, $config := $shared.path_variables -}}
{{- if hasKey $config "path" }}
$env.{{ $key }} = ($env.{{ trimPrefix "$" $config.base }} | path join "{{ $config.path }}")
{{- else }}
$env.{{ $key }} = $env.{{ trimPrefix "$" $config.base }}
{{- end }}
{{ end }}

##
## GROUPED PATH VARIABLES
##
{{ range $group_name, $group_config := $shared.path_groups -}}
{{ range $var_name, $var_path := $group_config.paths -}}
$env.{{ $var_name }} = ($env.{{ trimPrefix "$" $group_config.base }} | path join "{{ $var_path }}")
{{ end -}}
{{ end }}

##
## COMMAND-BASED VARIABLES
##
{{ range $key, $config := $shared.command_variables -}}
{{- if typeIs "string" $config }}
$env.{{ $key }} = (^{{ $config }} | str trim)
{{- else }}
$env.{{ $key }} = ({{ $config.command }})
{{- end }}
{{ end }}

##
## DERIVED PATH VARIABLES
##
{{ range $key, $config := $shared.derived_path_variables -}}
$env.{{ $key }} = ($env.{{ trimPrefix "$" $config.base }} | path join "{{ $config.path }}")
{{ end }}

##
## THEME VARIABLES
##
$env.CATPPUCCIN_FLAVOR = "{{ .CATPPUCCIN_FLAVOR }}"

##
## PATH
##
$env.PATH = ($env.PATH | split row (char esep) | prepend [
{{ range $path.path -}}
{{- if contains "$XDG_HOME" . }}
    ($env.XDG_HOME | path join "{{ trimPrefix "$XDG_HOME/" . }}")
{{- else if contains "$HOME" . }}
    ($env.HOME | path join "{{ trimPrefix "$HOME/" . }}")
{{- else if contains "$XDG_CONFIG_HOME" . }}
    ($env.XDG_CONFIG_HOME | path join "{{ trimPrefix "$XDG_CONFIG_HOME/" . }}")
{{- else if contains "$XDG_DATA_HOME" . }}
    ($env.XDG_DATA_HOME | path join "{{ trimPrefix "$XDG_DATA_HOME/" . }}")
{{- else if contains "$GOPATH" . }}
    ($env.GOPATH | path join "{{ trimPrefix "$GOPATH/" . }}")
{{- else }}
    "{{ . }}"
{{- end }}
{{ end }}
] | uniq )

# Shell-specific configuration
$env.SHELL = "/opt/homebrew/bin/nu"
$env."config.buffer_editor" = "nvim"

# FNM configuration (nushell-specific - other shells use `fnm env`)
# $env.FNM_VERSION_FILE_STRATEGY = "local"
# $env.FNM_LOGLEVEL = "info"
# $env.FNM_NODE_DIST_MIRROR = "https://nodejs.org/dist"
# $env.FNM_COREPACK_ENABLED = "false"
# $env.FNM_RESOLVE_ENGINES = "true"
# $env.FNM_ARCH = "arm64"
# $env.FNM_DIR = "{{ .chezmoi.homeDir }}/.local/share/fnm"

##
## WORK ENVIRONMENT
##
{{ if and (hasKey . "WORK_ENVIRONMENT") (eq .WORK_ENVIRONMENT true) -}}
{{ if hasKey . "work" -}}
{{ range $key, $value := .work -}}
{{- if eq $key "WORK_ENVIRONMENT" }}
$env.{{ $key }} = "{{ $.WORK_ENVIRONMENT | default false }}"
{{- else if and $value (not (hasPrefix "{{" (toString $value))) }}
$env.{{ $key }} = "{{ $value }}"
{{- end -}}
{{ end -}}
{{ end -}}
{{ end }}

$env.CARAPACE_BRIDGES = 'zsh,bash,inshellisense'
carapace _carapace nushell | save -f ~/.cache/carapace/init.nu



