# Generated from consolidated environment configuration
# Edit MISSION_CONTROL/.chezmoidata/environment/ files to modify

{{ $shared := (include ".chezmoidata/environment/shared.yaml" | fromYaml) -}}
{{ $path := (include ".chezmoidata/environment/path.yaml" | fromYaml) -}}
{{ $work := (include ".chezmoidata/environment/work.yaml" | fromYaml) -}}

##
## SHARED ENVIRONMENT VARIABLES
##
{{ range $key, $value := $shared.shared -}}
{{- if eq $key "BAT_THEME" }}
$env.{{ $key }} = "Catppuccin {{ title $.CATPPUCCIN_FLAVOR }}"
{{- else if eq $key "WORK_ENVIRONMENT" }}
$env.{{ $key }} = "{{ $.WORK_ENVIRONMENT }}"
{{- else if eq $key "CHEZMOI_INTERACTIVE" }}
$env.{{ $key }} = "{{ if $.INTERACTIVE }}1{{ else }}0{{ end }}"
{{- else if eq $key "GIT_NAME" }}
$env.{{ $key }} = "{{ $.git.config.name }}"
{{- else if eq $key "GITHUB_USERNAME" }}
$env.{{ $key }} = "{{ $.git.config.username }}"
{{- else if eq $key "GIT_EMAIL" }}
$env.{{ $key }} = "{{ $.git.config.email }}"
{{- else if eq $key "FNM_DIR" }}
$env.{{ $key }} = "{{ $.chezmoi.homeDir }}/.local/share/fnm"
{{- else if eq $key "SDKROOT" }}
$env.{{ $key }} = (^xcrun --sdk macosx --show-sdk-path | str trim)
{{- else if or (eq $key "CPATH") (eq $key "LIBRARY_PATH") }}
$env.{{ $key }} = $env.SDKROOT | path join "{{ trimPrefix "$SDKROOT/" $value }}"
{{- else if eq $key "MANPAGER" }}
# Skip MANPAGER as it has complex quoting that breaks nushell
{{- else }}
$env.{{ $key }} = "{{ $value }}"
{{- end }}
{{ end }}

##
## THEME ENVIRONMENT VARIABLES
##
$env.CATPPUCCIN_FLAVOR = "{{ .CATPPUCCIN_FLAVOR }}"

##
## GIT ENVIRONMENT VARIABLES
##
$env.GIT_CLONE_DIRECTORY = $env.XDG_HOME | path join "source"
$env.GIT_NAME = "{{ .git.config.name }}"
$env.GITHUB_USERNAME = "{{ .git.config.username }}"
$env.GIT_EMAIL = "{{ .git.config.email }}"

##
## PATH
##
$env.PATH = ($env.PATH | split row (char esep) | prepend [
{{ range $path.path -}}
{{- if contains "$XDG_HOME" . }}
    ($env.XDG_HOME | path join "{{ trimPrefix "$XDG_HOME/" . }}")
{{- else if contains "$HOME" . }}
    ($env.HOME | path join "{{ trimPrefix "$HOME/" . }}")
{{- else if contains "$XDG_CONFIG_HOME" . }}
    ($env.XDG_CONFIG_HOME | path join "{{ trimPrefix "$XDG_CONFIG_HOME/" . }}")
{{- else if contains "$XDG_DATA_HOME" . }}
    ($env.XDG_DATA_HOME | path join "{{ trimPrefix "$XDG_DATA_HOME/" . }}")
{{- else if contains "$GOPATH" . }}
    ($env.GOPATH | path join "{{ trimPrefix "$GOPATH/" . }}")
{{- else }}
    "{{ . }}"
{{- end }}
{{ end }}
] | uniq )

# Shell-specific configuration
$env.SHELL = "/opt/homebrew/bin/nu"
$env."config.buffer_editor" = "nvim"

##
## WORK ENVIRONMENT
##
{{ if and (hasKey . "WORK_ENVIRONMENT") (eq .WORK_ENVIRONMENT true) -}}
{{ if hasKey . "work" -}}
{{ range $key, $value := .work -}}
{{- if eq $key "WORK_ENVIRONMENT" }}
$env.{{ $key }} = "{{ $.WORK_ENVIRONMENT | default false }}"
{{- else if and $value (not (hasPrefix "{{" (toString $value))) }}
$env.{{ $key }} = "{{ $value }}"
{{- end -}}
{{ end -}}
{{ end -}}
{{ end }}

{{ range $cond_name, $cond_data := $shared.conditionals -}}
{{- if $cond_data.condition }}
##
## {{ upper (replace $cond_name "_" " ") }}
##
{{ range $var_name, $var_value := $cond_data.variables -}}
{{- if $var_value }}
$env.{{ $var_name }} = "{{ $var_value }}"
{{ end -}}
{{ end -}}
{{ end -}}
{{ end }}

