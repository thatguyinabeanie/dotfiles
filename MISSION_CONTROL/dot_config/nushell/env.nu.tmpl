##
## XDG Base Directory Specification
##
## https://specifications.freedesktop.org/basedir-spec/latest
##
$env.XDG_HOME        = $env.HOME
$env.XDG_CONFIG_HOME = $env.XDG_HOME | path join ".config"
$env.XDG_DATA_HOME   = $env.XDG_HOME | path join ".local/share"
$env.XDG_STATE_HOME  = $env.XDG_HOME | path join ".local/state"
$env.XDG_CACHE_HOME  = $env.XDG_HOME | path join ".cache"
$env.XDG_DATA_DIRS   = ""
$env.XDG_CONFIG_DIRS = ""

##
## CHEZMOI ENVIRONMENT VARIABLES
##
$env.DOTFILES_DIR = $env.XDG_DATA_HOME | path join "chezmoi"
$env.WORK_ENVIRONMENT = "{{ .WORK_ENVIRONMENT }}"
$env.CHEZMOI_INTERACTIVE = "{{ if .INTERACTIVE }}1{{ else }}0{{ end }}"

##
## GIT ENVIRONMENT VARIABLES
##
$env.GIT_CLONE_DIRECTORY = $env.XDG_HOME | path join "source"
$env.GIT_NAME = "{{ .git.config.name }}"
$env.GITHUB_USERNAME = "{{ .git.config.username }}"
$env.GIT_EMAIL = "{{ .git.config.email }}"

##
## PATH
##
$env.PATH = ($env.PATH | split row (char esep) | prepend [
    '/usr/local/bin'
    '/Library/Developer/CommandLineTools/usr/bin'
    '/opt/homebrew/bin'
    '/opt/homebrew/sbin'
    '/opt/homebrew/opt/libpq/bin'
    '/opt/homebrew/opt/unzip/bin'
    '/opt/homebrew/opt/gnu-sed/libexec/gnubin'
    ($env.HOME | path join ".cargo/bin")
    ($env.HOME | path join ".local/bin")
    ($env.HOME | path join ".local/share/mise/shims")
  ] |  uniq )

##
## COMPILATION FLAGS
##
$env.SDKROOT        = (xcrun --sdk macosx --show-sdk-path | str trim)
$env.CPATH          = $env.SDKROOT | path join "usr/include"
$env.LIBRARY_PATH   = $env.SDKROOT | path join "usr/lib"
$env.LDFLAGS        = "-L/opt/homebrew/opt/openssl@3/lib"
$env.CPPFLAGS       = "-I/opt/homebrew/opt/openssl@3/include"

##
## EDITOR RELATED ENVIRONMENT VARIABLES
##
$env.EDITOR               = 'nvim'
$env.VISUAL               = 'nvim'
$env.SHELL                =  '/opt/homebrew/bin/nu'
$env.config.buffer_editor = "nvim"

##
## GO ENVIRONMENT VARIABLES
##
$env.GOPATH = $env.XDG_CONFIG_HOME | path join "go"
$env.GOBIN  = $env.GOPATH | path join "bin"
$env.GOMODCACHE = $env.GOPATH | path join "pkg/mod"

##
## NUSHELL
##
$env.NU_CONFIG_DIR = $env.XDG_CONFIG_HOME | path join "nushell"

##
## TMUX
##
$env.TMUX_CONFIG_DIR = $env.XDG_CONFIG_HOME | path join "tmux"
$env.TMUX_PLUGIN_MANAGER_PATH = $env.TMUX_CONFIG_DIR | path join "plugins"
$env.TMUX_CONF = $env.TMUX_CONFIG_DIR | path join "tmux.conf"

##
## K9S
##
$env.K9S_CONFIG_DIR = $env.XDG_CONFIG_HOME | path join "k9s"

##
## STARSHIP
##
$env.STARSHIP_CONFIG = $env.XDG_CONFIG_HOME | path join "starship/starship.toml"

##
## BAT
##
$env.BAT_THEME = "Catppuccin {{ title .CATPPUCCIN_FLAVOR }}"
$env.MANPAGER = "sh -c 'sed -u -e \"s/\\x1B[[0-9;]*m//g; s/.\\x08//g\" | bat -p -lman'"
# $env.MANPATH = $"/usr/local/man:($env.MANPATH | str trim)"

##
## IDE ENVIRONMENT VARIABLES
##
$env.CODECOMPANION_TOKEN_PATH = $env.XDG_CONFIG_HOME;
$env.VSCODE_USER_DATA_DIR = $env.XDG_CONFIG_HOME | path join "code"
$env.VSCODE_INSIDERS_USER_DATA_DIR = $env.XDG_CONFIG_HOME | path join "code-insiders"

##
## CARAPACE
##
$env.CARAPACE_BRIDGES = 'zsh,bash,inshellisense'
carapace _carapace nushell | save -f ~/.cache/carapace/init.nu

if ($env.WORK_ENVIRONMENT? == "true") {
    $env.DOCKER_DEFAULT_PLATFORM = "linux/amd64"
}
