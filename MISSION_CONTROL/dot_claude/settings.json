{
  "mcpServers": {
    "mcphub": {
      "command": "mcp-hub",
      "args": ["--port", "37373", "--config", "~/.config/mcphub/servers.json"],
      "env": {}
    }
  },
  "permissions": {
    "allow": [
      "Bash(rm:*)",
      "Bash(pnpm dev:*)",
      "Bash(grep:*)",
      "Bash(pkill:*)",
      "Bash(true)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm config set:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker pull:*)",
      "Bash(docker inspect:*)",
      "Bash(docker search:*)",
      "Bash(node:*)",
      "Bash(chmod:*)",
      "Bash(pnpm remove:*)",
      "Bash(ls:*)",
      "Bash(pnpm lint:*)",
      "Bash(git rm:*)",
      "Bash(npx tsc:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(sed:*)",
      "Bash(cp:*)",
      "Bash(rg:*)",
      "Bash(mv:*)",
      "WebFetch(domain:daypicker.dev)",
      "mcp__ide__getDiagnostics",
      "Bash(cat:*)",
      "WebFetch(domain:ui.shadcn.com)",
      "Bash(kill:*)",
      "Bash(npm view:*)",
      "Bash(docker-compose down:*)",
      "Bash(npx supabase:*)",
      "Bash(supabase init:*)",
      "Bash(supabase start:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(pnpm run:*)",
      "Bash(VERCEL=1 pnpm run prepare)",
      "Bash(NODE_ENV=production pnpm run prepare)",
      "Bash(touch:*)",
      "Bash(git add:*)",
      "Bash(NODE_ENV=development pnpm build)"
    ]
  }
}
