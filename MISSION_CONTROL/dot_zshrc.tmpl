#!/bin/zsh

autoload -U add-zsh-hook



# Initialize completion system early
autoload -Uz compinit
compinit

# Environment variables are automatically sourced from .zshenv before .zshrc

# Source additional configuration files
ZSH_SYNTAX_HIGHLIGHTING_PATH="/opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
if [ -f "$ZSH_SYNTAX_HIGHLIGHTING_PATH" ]; then
  source "$ZSH_SYNTAX_HIGHLIGHTING_PATH"
fi

source ~/.config/zsh/work.zsh
source ~/.config/zsh/secrets.zsh
source ~/.config/zsh/aliases.zsh



# PNPM configuration
export PNPM_HOME="$HOME/.pnpm-global"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Starship configuration
export STARSHIP_CONFIG=~/.config/starship/starship.toml

# Initialize tools
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
# Initialize fzf if available
if command -v fzf >/dev/null 2>&1; then
	source <(fzf --zsh)
fi

# Source FZF theme
if [[ -f "$HOME/.config/fzf/fzf-theme.sh" ]]; then
    source "$HOME/.config/fzf/fzf-theme.sh"
fi

# Source Cargo environment if available
if [ -f "$HOME/.cargo/env" ]; then
	source "$HOME/.cargo/env"
fi

# Source Carapace
if command -v carapace >/dev/null 2>&1; then
  export CARAPACE_BRIDGES='zsh,bash,inshellisense' # optional
  zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
  source <(carapace _carapace)
fi

# Docker CLI completions setup
fpath=({{ .chezmoi.homeDir }}/.docker/completions $fpath)

# Display system info with Pokemon and fastfetch if available
# if command -v pokeget >/dev/null 2>&1 && command -v fastfetch >/dev/null 2>&1; then
#   pokeget random --hide-name | fastfetch --file-raw -
