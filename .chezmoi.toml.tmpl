{{- /*
Only the work/personal answer is persisted outside chezmoi.toml, in the macOS defaults domain
com.chezmoi.config, so deleting ~/.config/chezmoi and re-running `chezmoi init` needs no answers.
Precedence: env WORK_ENVIRONMENT > defaults > promptBoolOnce. The defaults value is written back
only when it changes.
The defaults read and write are macOS-only; other OSes skip both (no `defaults` binary). Everything else is an env override with a literal default.
*/ -}}
{{- $current_hostname := output "hostname" | trim -}}
{{- $stored := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $stored = output "sh" "-c" "defaults read com.chezmoi.config work_environment 2>/dev/null || true" | trim -}}
{{- end -}}

{{- $work := false -}}
{{- if env "WORK_ENVIRONMENT" -}}
{{-   $work = eq "true" (env "WORK_ENVIRONMENT") -}}
{{- else if $stored -}}
{{-   $work = eq "true" $stored -}}
{{- else -}}
{{-   $work = promptBoolOnce . "WORK_ENVIRONMENT" "Is this a work machine" false -}}
{{- end -}}

{{- if and (eq .chezmoi.os "darwin") (ne $stored (toString $work)) -}}
{{-   $_ := output "defaults" "write" "com.chezmoi.config" "work_environment" "-string" (toString $work) -}}
{{- end }}

{{- /* Fallbacks come from .chezmoidata/defaults.yaml so each default lives in one place.
`.` does not include .chezmoidata here, so the file is read directly, like opencode.yaml below. */}}
{{- $defaults_file := joinPath .chezmoi.sourceDir ".chezmoidata" "defaults.yaml" }}
{{- $d := dict }}
{{- if stat $defaults_file }}
{{- $d = (include $defaults_file | fromYaml) }}
{{- end }}
{{- $ui := $d.ui | default dict }}
{{- $gitcfg := (($d.git | default dict).config) | default dict }}

[data]
hostname                   = {{ $current_hostname | quote }}
SHELL                      = {{ (env "SHELL_PREF") | default $d.SHELL | quote }}
WORK_ENVIRONMENT           = {{ $work }}
PERSONAL_ENVIRONMENT       = {{ not $work }}
MANAGE_BREW_SERVICES       = {{ (env "MANAGE_BREW_SERVICES") | default $d.MANAGE_BREW_SERVICES | quote }}
CATPPUCCIN_FLAVOR          = {{ (env "CATPPUCCIN_FLAVOR") | default $d.CATPPUCCIN_FLAVOR | quote }}

THEME_MODE                 = {{ $d.THEME_MODE | quote }}
THEME_LIGHT                = {{ $d.THEME_LIGHT | quote }}
THEME_DARK                 = {{ $d.THEME_DARK | quote }}

SUDO_TOUCHID               = {{ (env "SUDO_TOUCHID") | default $d.SUDO_TOUCHID | quote }}
INTERACTIVE                = {{ $d.INTERACTIVE }}

{{- $opencode_file := joinPath .chezmoi.sourceDir ".chezmoidata" "opencode.yaml" }}
{{- $opencode_data := dict }}
{{- if stat $opencode_file }}
{{- $opencode_data = (include $opencode_file | fromYaml) }}
{{- end }}
{{- $opencode := $opencode_data.opencode | default dict }}

[data.opencode]
model                      = {{ (env "OPENCODE_MODEL") | default ($opencode.model | default "github-copilot/claude-sonnet-4") | quote }}
small_model                = {{ (env "OPENCODE_SMALL_MODEL") | default ($opencode.small_model | default "github-copilot/o3-mini") | quote }}

[data.ui]
opacity                    = {{ (env "UI_OPACITY") | default $ui.opacity | quote }}
blur                       = {{ (env "UI_BLUR") | default $ui.blur | quote }}
font_size                  = {{ (env "UI_FONT_SIZE") | default $ui.font_size | quote }}
font_family                = {{ (env "UI_FONT_FAMILY") | default $ui.font_family | quote }}
{{- /* No window size default: written only when the env var is set, otherwise the Ghostty and
WezTerm templates omit it and each terminal picks its own size. */}}
{{- if env "UI_WINDOW_HEIGHT" }}
window_height              = {{ env "UI_WINDOW_HEIGHT" | quote }}
{{- end }}
{{- if env "UI_WINDOW_WIDTH" }}
window_width               = {{ env "UI_WINDOW_WIDTH" | quote }}
{{- end }}
font_thicken               = {{ (env "UI_FONT_THICKEN") | default $ui.font_thicken }}
cursor_style               = {{ (env "UI_CURSOR_STYLE") | default $ui.cursor_style | quote }}
cursor_blink               = {{ (env "UI_CURSOR_BLINK") | default $ui.cursor_blink }}

[data.git.config]
name                       = {{ (env "GIT_NAME") | default $gitcfg.name | quote }}
username                   = {{ (env "GITHUB_USERNAME") | default $gitcfg.username | quote }}
email                      = {{ (env "GIT_EMAIL") | default $gitcfg.email | quote }}
defaultRefreshPeriod       = {{ (env "GIT_REFRESH_PERIOD") | default $gitcfg.defaultRefreshPeriod | quote }}
signing_key                = {{ $gitcfg.signing_key | quote }}
work_org                   = {{ (env "WORK_ORG") | default $gitcfg.work_org | quote }}
work_environment           = {{ $work }}

{{- /* 
LAZY LOADING OPTIMIZATION: YAML data files are no longer loaded in .chezmoi.toml.tmpl
for performance reasons. Individual templates can load specific YAML files as needed
using the helper template functions below.

To load YAML data in a template, use:
{{ $data := (include (printf "%s/.chezmoidata/tools.yaml" .chezmoi.sourceDir) | fromYaml) }}

Available YAML files:
- parsers.yaml
- lsp.yaml  
- formatters.yaml
- linters.yaml
- tools.yaml
- opencode.yaml
*/ -}}
