{{- $current_hostname := output "hostname" | trim -}}
[data]
{{/* ===== CORE PREFERENCES ===== */}}
hostname                   = {{ env "HOSTNAME" | default $current_hostname | quote }}
SHELL                      = {{ env "SHELL_PREF" | default "nu" | quote }}
WORK_ENVIRONMENT           = {{ env "WORK_ENVIRONMENT" | default "false" }}
PERSONAL_ENVIRONMENT       = {{ env "PERSONAL_ENVIRONMENT" | default "false" }}
INSTALL_SKETCHY_BAR        = {{ env "INSTALL_SKETCHY_BAR" | default "true" | quote }}
MANAGE_BREW_SERVICES       = {{ env "MANAGE_BREW_SERVICES" | default "true" | quote }}
CATPPUCCIN_FLAVOR          = {{ env "CATPPUCCIN_FLAVOR" | default "mocha" | quote }}

{{/* ===== THEME SYSTEM CONFIGURATION ===== */}}
{{/* These control the advanced theme switching system */}}
THEME_MODE                 = {{ env "THEME_MODE" | default "dark" | quote }}
THEME_LIGHT                = {{ env "THEME_LIGHT" | default "catppuccin-latte" | quote }}
THEME_DARK                 = {{ env "THEME_DARK" | default "catppuccin-mocha" | quote }}

{{/* ===== APPLICATION SETTINGS ===== */}}
OBSIDIAN_VAULT_PERSONAL    = "obsidian-vault"
OBSIDIAN_VAULT_WORK        = "obsidian-vault-work"
YAZI_CATPPUCCIN_COLOR      = "blue"
SUDO_TOUCHID               = "true"
INTERACTIVE                = false


{{/* ===== CONSOLIDATED UI CONFIGURATION ===== */}}
[data.ui]
opacity                    = {{ env "UI_OPACITY" | default "0.5" | quote }}
blur                       = {{ env "UI_BLUR" | default "255" | quote }}
font_size                  = {{ env "UI_FONT_SIZE" | default "20" | quote }}
font_family                = {{ env "UI_FONT_FAMILY" | default "Dank Mono" | quote }}
window_height              = {{ env "UI_WINDOW_HEIGHT" | default "65" | quote }}
window_width               = {{ env "UI_WINDOW_WIDTH" | default "160" | quote }}
font_thicken               = {{ env "UI_FONT_THICKEN" | default "true" }}
cursor_style               = {{ env "UI_CURSOR_STYLE" | default "block_hollow" | quote }}

{{/* ===== GIT & GITHUB CONFIGURATION ===== */}}
[data.git.config]
name                       = {{ env "GIT_NAME" | default "Gabe Mendoza" | quote }}
username                   = {{ env "GITHUB_USERNAME" | default "thatguyinabeanie" | quote }}
email                      = {{ env "GIT_EMAIL" | default "thatguyin@beanie.gg" | quote }}
defaultRefreshPeriod       = {{ env "GIT_REFRESH_PERIOD" | default "168h" | quote }}
work_org                   = {{ env "WORK_ORG" | default "" | quote }}
work_environment           = {{ env "WORK_ENVIRONMENT" | default "false" }}

