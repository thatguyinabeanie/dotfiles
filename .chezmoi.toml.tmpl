
{{- $current_hostname := output "hostname" | trim -}}
{{- $config_helper := joinPath .chezmoi.sourceDir ".chezmoitemplates" "utilities" "config-persistence.sh" -}}
{{- $backup_script := joinPath .chezmoi.sourceDir ".scripts" "utilities" "chezmoi-backup-config" -}}

# Hooks - automatically backup configuration after apply
[hooks.apply.post]
command = "{{ $backup_script }}"
args = ["--silent"]

[data]
hostname                   = {{ $current_hostname | quote }}
SHELL                      = {{ (env "SHELL_PREF") | default (output "bash" "-c" (printf "%s read shell_pref" ($config_helper | quote)) | trim) | default "zsh" | quote }}
WORK_ENVIRONMENT           = {{ eq "true" ((env "WORK_ENVIRONMENT") | default (output "bash" "-c" (printf "%s read work_environment" ($config_helper | quote)) | trim) | default "false") }}
PERSONAL_ENVIRONMENT       = {{ eq "true" ((env "PERSONAL_ENVIRONMENT") | default (output "bash" "-c" (printf "%s read personal_environment" ($config_helper | quote)) | trim) | default "false") }}
ACTIVE_PROFILES            = {{ (env "ACTIVE_PROFILES") | default (output "bash" "-c" (printf "%s read active_profiles" ($config_helper | quote)) | trim) | default "default" | quote }}
INSTALL_SKETCHY_BAR        = {{ (env "INSTALL_SKETCHY_BAR") | default (output "bash" "-c" (printf "%s read install_sketchy_bar" ($config_helper | quote)) | trim) | default "true" | quote }}
MANAGE_BREW_SERVICES       = {{ (env "MANAGE_BREW_SERVICES") | default (output "bash" "-c" (printf "%s read manage_brew_services" ($config_helper | quote)) | trim) | default "true" | quote }}
CATPPUCCIN_FLAVOR          = {{ (env "CATPPUCCIN_FLAVOR") | default (output "bash" "-c" (printf "%s read catppuccin_flavor" ($config_helper | quote)) | trim) | default "mocha" | quote }}

THEME_MODE                 = "dark"
THEME_LIGHT                = "Catppuccin Latte"
THEME_DARK                 = "Catppuccin Mocha"

SUDO_TOUCHID               = {{ (env "SUDO_TOUCHID") | default (output "bash" "-c" (printf "%s read sudo_touchid" ($config_helper | quote)) | trim) | default "true" | quote }}
INTERACTIVE                = false

{{- $opencode_file := joinPath .chezmoi.sourceDir ".chezmoidata" "opencode.yaml" }}
{{- $opencode_data := dict }}
{{- if stat $opencode_file }}
{{- $opencode_data = (include $opencode_file | fromYaml) }}
{{- end }}
{{- $opencode := $opencode_data.opencode | default dict }}

[data.opencode]
model                      = {{ (env "OPENCODE_MODEL") | default ($opencode.model | default "github-copilot/claude-sonnet-4") | quote }}
small_model                = {{ (env "OPENCODE_SMALL_MODEL") | default ($opencode.small_model | default "github-copilot/o3-mini") | quote }}

[data.ui]
opacity                    = {{ (env "UI_OPACITY") | default (output "bash" "-c" (printf "%s read ui_opacity" ($config_helper | quote)) | trim) | default "0.5" | quote }}
blur                       = {{ (env "UI_BLUR") | default (output "bash" "-c" (printf "%s read ui_blur" ($config_helper | quote)) | trim) | default "255" | quote }}
font_size                  = {{ (env "UI_FONT_SIZE") | default (output "bash" "-c" (printf "%s read ui_font_size" ($config_helper | quote)) | trim) | default "20" | quote }}
font_family                = {{ (env "UI_FONT_FAMILY") | default (output "bash" "-c" (printf "%s read ui_font_family" ($config_helper | quote)) | trim) | default "Dank Mono" | quote }}
window_height              = {{ (env "UI_WINDOW_HEIGHT") | default (output "bash" "-c" (printf "%s read ui_window_height" ($config_helper | quote)) | trim) | default "65" | quote }}
window_width               = {{ (env "UI_WINDOW_WIDTH") | default (output "bash" "-c" (printf "%s read ui_window_width" ($config_helper | quote)) | trim) | default "160" | quote }}
font_thicken               = {{ (env "UI_FONT_THICKEN") | default (output "bash" "-c" (printf "%s read ui_font_thicken" ($config_helper | quote)) | trim) | default "true" }}
cursor_style               = {{ (env "UI_CURSOR_STYLE") | default (output "bash" "-c" (printf "%s read ui_cursor_style" ($config_helper | quote)) | trim) | default "block_hollow" | quote }}
cursor_blink               = {{ (env "UI_CURSOR_BLINK") | default (output "bash" "-c" (printf "%s read ui_cursor_blink" ($config_helper | quote)) | trim) | default "true" }}

[data.git.config]
name                       = {{ (env "GIT_NAME") | default (output "bash" "-c" (printf "%s read git_name" ($config_helper | quote)) | trim) | default "Gabe Mendoza" | quote }}
username                   = {{ (env "GITHUB_USERNAME") | default (output "bash" "-c" (printf "%s read github_username" ($config_helper | quote)) | trim) | default "thatguyinabeanie" | quote }}
email                      = {{ (env "GIT_EMAIL") | default (output "bash" "-c" (printf "%s read git_email" ($config_helper | quote)) | trim) | default "thatguyin@beanie.gg" | quote }}
defaultRefreshPeriod       = {{ (env "GIT_REFRESH_PERIOD") | default (output "bash" "-c" (printf "%s read git_refresh_period" ($config_helper | quote)) | trim) | default "168h" | quote }}
signing_key                = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMxfnYZGk9sVpabkMlNgvX487e3M7iOnFDB98iIPocbI"
work_org                   = {{ (env "WORK_ORG") | default (output "bash" "-c" (printf "%s read work_org" ($config_helper | quote)) | trim) | default "" | quote }}
work_environment           = {{ eq "true" ((env "WORK_ENVIRONMENT") | default (output "bash" "-c" (printf "%s read git_work_environment" ($config_helper | quote)) | trim) | default "false") }}

{{- $jankyborders_file := joinPath .chezmoi.sourceDir ".chezmoidata" "apps" "jankyborders.yaml" }}
{{- if stat $jankyborders_file }}
{{- $jankyborders_data := (include $jankyborders_file | fromYaml) }}
{{- $jankyborders := $jankyborders_data.jankyborders }}
[data.jankyborders]
style = {{ $jankyborders.style | quote }}
width = {{ $jankyborders.width }}
hidpi = {{ $jankyborders.hidpi }}
ax_focus = {{ $jankyborders.ax_focus }}

[data.jankyborders.colors]
active = {{ $jankyborders.colors.active | quote }}
inactive = {{ $jankyborders.colors.inactive | quote }}

{{- if $jankyborders.blacklist }}
[data.jankyborders.blacklist]
{{- range $i, $app := $jankyborders.blacklist }}
item{{ $i }} = {{ $app | quote }}
{{- end }}
{{- end }}

{{- if $jankyborders.animations }}
[data.jankyborders.animations]
enabled = {{ $jankyborders.animations.enabled }}
duration = {{ $jankyborders.animations.duration }}
{{- end }}
{{- end }}

{{- /* 
LAZY LOADING OPTIMIZATION: YAML data files are no longer loaded in .chezmoi.toml.tmpl
for performance reasons. Individual templates can load specific YAML files as needed
using the helper template functions below.

To load YAML data in a template, use:
{{ $data := (include (printf "%s/.chezmoidata/tools.yaml" .chezmoi.sourceDir) | fromYaml) }}

Available YAML files:
- parsers.yaml
- lsp.yaml  
- formatters.yaml
- linters.yaml
- tools.yaml
- opencode.yaml
*/ -}}
