{{- /*
Only the work/personal answer is persisted outside chezmoi.toml, in the macOS defaults domain
com.chezmoi.config, so deleting ~/.config/chezmoi and re-running `chezmoi init` needs no answers.
Precedence: env WORK_ENVIRONMENT > defaults > promptBoolOnce. The defaults value is written back
only when it changes. Everything else is an env override with a literal default.
*/ -}}
{{- $current_hostname := output "hostname" | trim -}}
{{- $stored := output "sh" "-c" "defaults read com.chezmoi.config work_environment 2>/dev/null || true" | trim -}}

{{- $work := false -}}
{{- if env "WORK_ENVIRONMENT" -}}
{{-   $work = eq "true" (env "WORK_ENVIRONMENT") -}}
{{- else if $stored -}}
{{-   $work = eq "true" $stored -}}
{{- else -}}
{{-   $work = promptBoolOnce . "WORK_ENVIRONMENT" "Is this a work machine" false -}}
{{- end -}}

{{- if ne $stored (toString $work) -}}
{{-   $_ := output "defaults" "write" "com.chezmoi.config" "work_environment" "-string" (toString $work) -}}
{{- end }}

[data]
hostname                   = {{ $current_hostname | quote }}
SHELL                      = {{ (env "SHELL_PREF") | default "zsh" | quote }}
WORK_ENVIRONMENT           = {{ $work }}
PERSONAL_ENVIRONMENT       = {{ not $work }}
INSTALL_SKETCHY_BAR        = {{ (env "INSTALL_SKETCHY_BAR") | default "true" | quote }}
MANAGE_BREW_SERVICES       = {{ (env "MANAGE_BREW_SERVICES") | default "true" | quote }}
CATPPUCCIN_FLAVOR          = {{ (env "CATPPUCCIN_FLAVOR") | default "mocha" | quote }}

THEME_MODE                 = "dark"
THEME_LIGHT                = "Catppuccin Latte"
THEME_DARK                 = "Catppuccin Mocha"

SUDO_TOUCHID               = {{ (env "SUDO_TOUCHID") | default "true" | quote }}
INTERACTIVE                = false

{{- $opencode_file := joinPath .chezmoi.sourceDir ".chezmoidata" "opencode.yaml" }}
{{- $opencode_data := dict }}
{{- if stat $opencode_file }}
{{- $opencode_data = (include $opencode_file | fromYaml) }}
{{- end }}
{{- $opencode := $opencode_data.opencode | default dict }}

[data.opencode]
model                      = {{ (env "OPENCODE_MODEL") | default ($opencode.model | default "github-copilot/claude-sonnet-4") | quote }}
small_model                = {{ (env "OPENCODE_SMALL_MODEL") | default ($opencode.small_model | default "github-copilot/o3-mini") | quote }}

[data.ui]
opacity                    = {{ (env "UI_OPACITY") | default "0.5" | quote }}
blur                       = {{ (env "UI_BLUR") | default "255" | quote }}
font_size                  = {{ (env "UI_FONT_SIZE") | default "20" | quote }}
font_family                = {{ (env "UI_FONT_FAMILY") | default "Dank Mono" | quote }}
window_height              = {{ (env "UI_WINDOW_HEIGHT") | default "65" | quote }}
window_width               = {{ (env "UI_WINDOW_WIDTH") | default "160" | quote }}
font_thicken               = {{ (env "UI_FONT_THICKEN") | default "true" }}
cursor_style               = {{ (env "UI_CURSOR_STYLE") | default "block_hollow" | quote }}
cursor_blink               = {{ (env "UI_CURSOR_BLINK") | default "true" }}

[data.git.config]
name                       = {{ (env "GIT_NAME") | default "Gabe Mendoza" | quote }}
username                   = {{ (env "GITHUB_USERNAME") | default "thatguyinabeanie" | quote }}
email                      = {{ (env "GIT_EMAIL") | default "thatguyin@beanie.gg" | quote }}
defaultRefreshPeriod       = {{ (env "GIT_REFRESH_PERIOD") | default "168h" | quote }}
signing_key                = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMxfnYZGk9sVpabkMlNgvX487e3M7iOnFDB98iIPocbI"
work_org                   = {{ (env "WORK_ORG") | default "" | quote }}
work_environment           = {{ $work }}

{{- /* 
LAZY LOADING OPTIMIZATION: YAML data files are no longer loaded in .chezmoi.toml.tmpl
for performance reasons. Individual templates can load specific YAML files as needed
using the helper template functions below.

To load YAML data in a template, use:
{{ $data := (include (printf "%s/.chezmoidata/tools.yaml" .chezmoi.sourceDir) | fromYaml) }}

Available YAML files:
- parsers.yaml
- lsp.yaml  
- formatters.yaml
- linters.yaml
- tools.yaml
- opencode.yaml
*/ -}}
