
{{- $current_hostname := output "hostname" | trim -}}
{{- $config_helper := joinPath .chezmoi.sourceDir ".chezmoitemplates" "utilities" "config-persistence.sh" -}}
{{- $backup_script := joinPath .chezmoi.sourceDir ".scripts" "utilities" "chezmoi-backup-config" -}}

{{- /* Bulk-load all persistent config values in a single subprocess call */ -}}
{{- $cfg := output "bash" "-c" (printf "%s list-json" ($config_helper | quote)) | trim | fromJson -}}

# Hooks - automatically backup configuration after apply
[hooks.apply.post]
command = "{{ $backup_script }}"
args = ["--silent"]

[data]
hostname                   = {{ $current_hostname | quote }}
SHELL                      = {{ (env "SHELL_PREF") | default (index $cfg "shell_pref") | default "zsh" | quote }}
WORK_ENVIRONMENT           = {{ eq "true" ((env "WORK_ENVIRONMENT") | default (index $cfg "work_environment") | default "false") }}
PERSONAL_ENVIRONMENT       = {{ eq "true" ((env "PERSONAL_ENVIRONMENT") | default (index $cfg "personal_environment") | default "false") }}
ACTIVE_PROFILES            = {{ (env "ACTIVE_PROFILES") | default (index $cfg "active_profiles") | default "default" | quote }}
INSTALL_SKETCHY_BAR        = {{ (env "INSTALL_SKETCHY_BAR") | default (index $cfg "install_sketchy_bar") | default "true" | quote }}
MANAGE_BREW_SERVICES       = {{ (env "MANAGE_BREW_SERVICES") | default (index $cfg "manage_brew_services") | default "true" | quote }}
CATPPUCCIN_FLAVOR          = {{ (env "CATPPUCCIN_FLAVOR") | default (index $cfg "catppuccin_flavor") | default "mocha" | quote }}

THEME_MODE                 = "dark"
THEME_LIGHT                = "Catppuccin Latte"
THEME_DARK                 = "Catppuccin Mocha"

SUDO_TOUCHID               = {{ (env "SUDO_TOUCHID") | default (index $cfg "sudo_touchid") | default "true" | quote }}
INTERACTIVE                = false

{{- $opencode_file := joinPath .chezmoi.sourceDir ".chezmoidata" "opencode.yaml" }}
{{- $opencode_data := dict }}
{{- if stat $opencode_file }}
{{- $opencode_data = (include $opencode_file | fromYaml) }}
{{- end }}
{{- $opencode := $opencode_data.opencode | default dict }}

[data.opencode]
model                      = {{ (env "OPENCODE_MODEL") | default ($opencode.model | default "github-copilot/claude-sonnet-4") | quote }}
small_model                = {{ (env "OPENCODE_SMALL_MODEL") | default ($opencode.small_model | default "github-copilot/o3-mini") | quote }}

[data.ui]
opacity                    = {{ (env "UI_OPACITY") | default (index $cfg "ui_opacity") | default "0.5" | quote }}
blur                       = {{ (env "UI_BLUR") | default (index $cfg "ui_blur") | default "255" | quote }}
font_size                  = {{ (env "UI_FONT_SIZE") | default (index $cfg "ui_font_size") | default "20" | quote }}
font_family                = {{ (env "UI_FONT_FAMILY") | default (index $cfg "ui_font_family") | default "Dank Mono" | quote }}
window_height              = {{ (env "UI_WINDOW_HEIGHT") | default (index $cfg "ui_window_height") | default "65" | quote }}
window_width               = {{ (env "UI_WINDOW_WIDTH") | default (index $cfg "ui_window_width") | default "160" | quote }}
font_thicken               = {{ (env "UI_FONT_THICKEN") | default (index $cfg "ui_font_thicken") | default "true" }}
cursor_style               = {{ (env "UI_CURSOR_STYLE") | default (index $cfg "ui_cursor_style") | default "block_hollow" | quote }}
cursor_blink               = {{ (env "UI_CURSOR_BLINK") | default (index $cfg "ui_cursor_blink") | default "true" }}

[data.git.config]
name                       = {{ (env "GIT_NAME") | default (index $cfg "git_name") | default "Gabe Mendoza" | quote }}
username                   = {{ (env "GITHUB_USERNAME") | default (index $cfg "github_username") | default "thatguyinabeanie" | quote }}
email                      = {{ (env "GIT_EMAIL") | default (index $cfg "git_email") | default "thatguyin@beanie.gg" | quote }}
defaultRefreshPeriod       = {{ (env "GIT_REFRESH_PERIOD") | default (index $cfg "git_refresh_period") | default "168h" | quote }}
signing_key                = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMxfnYZGk9sVpabkMlNgvX487e3M7iOnFDB98iIPocbI"
work_org                   = {{ (env "WORK_ORG") | default (index $cfg "work_org") | default "" | quote }}
work_environment           = {{ eq "true" ((env "WORK_ENVIRONMENT") | default (index $cfg "git_work_environment") | default "false") }}

{{- $jankyborders_file := joinPath .chezmoi.sourceDir ".chezmoidata" "apps" "jankyborders.yaml" }}
{{- if stat $jankyborders_file }}
{{- $jankyborders_data := (include $jankyborders_file | fromYaml) }}
{{- $jankyborders := $jankyborders_data.jankyborders }}
[data.jankyborders]
style = {{ $jankyborders.style | quote }}
width = {{ $jankyborders.width }}
hidpi = {{ $jankyborders.hidpi }}
ax_focus = {{ $jankyborders.ax_focus }}

[data.jankyborders.colors]
active = {{ $jankyborders.colors.active | quote }}
inactive = {{ $jankyborders.colors.inactive | quote }}

{{- if $jankyborders.blacklist }}
[data.jankyborders.blacklist]
{{- range $i, $app := $jankyborders.blacklist }}
item{{ $i }} = {{ $app | quote }}
{{- end }}
{{- end }}

{{- if $jankyborders.animations }}
[data.jankyborders.animations]
enabled = {{ $jankyborders.animations.enabled }}
duration = {{ $jankyborders.animations.duration }}
{{- end }}
{{- end }}

{{- /* 
LAZY LOADING OPTIMIZATION: YAML data files are no longer loaded in .chezmoi.toml.tmpl
for performance reasons. Individual templates can load specific YAML files as needed
using the helper template functions below.

To load YAML data in a template, use:
{{ $data := (include (printf "%s/.chezmoidata/tools.yaml" .chezmoi.sourceDir) | fromYaml) }}

Available YAML files:
- parsers.yaml
- lsp.yaml  
- formatters.yaml
- linters.yaml
- tools.yaml
- opencode.yaml
*/ -}}
