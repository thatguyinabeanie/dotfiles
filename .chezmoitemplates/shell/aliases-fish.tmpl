{{- /*
  Fish abbreviations generator
  Reads from .chezmoidata/aliases.yaml and generates Fish abbreviation syntax

  Tool availability is checked at template-time via lookPath (during
  chezmoi apply) rather than at shell startup via type -q. This
  eliminates subprocess forks per interactive shell.

  Usage in a .tmpl file:
    {{ template "shell/aliases-fish.tmpl" . }}
*/ -}}
{{- range $category, $data := .aliases }}
{{- $categoryAvailable := true }}
{{- if hasKey $data "requires" }}
{{- $categoryAvailable = lookPath $data.requires }}
{{- end }}
{{- if $categoryAvailable }}

    # ─────────────────────────────────────────────────────────────────────────
    # {{ $data.description }}
    # ─────────────────────────────────────────────────────────────────────────
{{- range $data.items }}
{{- if hasKey . "requires" }}
{{- if lookPath .requires }}
    abbr -a {{ .name }} '{{ .command }}'
{{- end }}
{{- else }}
    abbr -a {{ .name }} '{{ .command }}'
{{- end }}
{{- end }}
{{- end }}
{{- end }}
