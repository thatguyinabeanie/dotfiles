# Shared Homebrew setup and initialization
# Ensures Homebrew is installed and properly configured

# Check if Homebrew is installed, install if not
if ! command_exists "brew"; then
    log_info "Installing Homebrew Package Manager for macOS"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    log_success "Homebrew Package Manager installed"
else
    log_debug "Homebrew is already installed"
fi

# Ensure PATH is configured for Homebrew
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
