{{- /* Template for loading 1Password secrets into environment variables */ -}}
{{- /* This template generates shell code to automatically load secrets from 1Password */ -}}
{{- /* Usage: Include this template in shell integration files */ -}}

{{- $env_type := "" -}}
{{- if eq .WORK_ENVIRONMENT true -}}
  {{- $env_type = "work" -}}
{{- else if eq .PERSONAL_ENVIRONMENT true -}}
  {{- $env_type = "personal" -}}
{{- end -}}

{{- if ne $env_type "" -}}
  {{- $secrets := (index .onepassword $env_type).secrets -}}
  {{- if $secrets -}}
    {{- if gt (len $secrets) 0 -}}

# Auto-load 1Password secrets ({{ $env_type }} environment)
# Cache file to avoid repeated CLI calls
_OP_SECRETS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/op-secrets.cache"
_OP_SECRETS_TTL=3600  # Cache for 1 hour

# Function to load secrets from 1Password
_op_load_secrets() {
    local cache_file="$_OP_SECRETS_CACHE"
    local current_time=$(date +%s)

    # Check if cache exists and is fresh
    if [[ -f "$cache_file" ]]; then
        local cache_time=$(stat -f %m "$cache_file" 2>/dev/null || stat -c %Y "$cache_file" 2>/dev/null)
        local cache_age=$((current_time - cache_time))

        if [[ $cache_age -lt $_OP_SECRETS_TTL ]]; then
            # Load from cache
            source "$cache_file" 2>/dev/null
            return 0
        fi
    fi

    # Create cache directory if needed
    mkdir -p "$(dirname "$cache_file")"

    # Create new cache file with secure permissions
    : > "$cache_file"
    chmod 600 "$cache_file"

    # Load secrets and write to cache
    local loaded=0
    local failed=0
      {{- range $secrets }}

    # Load: {{ .env_var }} from {{ .vault }}/{{ .item }}
    if _secret=$(op-helper get "{{ .vault }}" "{{ .item }}" "{{ .field }}" 2>/dev/null); then
        export {{ .env_var }}="$_secret"
        echo "export {{ .env_var }}='REDACTED'" >> "$cache_file"
        ((loaded++))
    else
        ((failed++))
      {{- end }}
    fi

    if [[ $loaded -gt 0 ]]; then
        echo "✓ Loaded $loaded secret(s) from 1Password" >&2
    fi

    if [[ $failed -gt 0 ]]; then
        echo "⚠️  Failed to load $failed secret(s)" >&2
    fi
}

# Load secrets on shell startup (only if op-helper is available)
if command -v op-helper &>/dev/null; then
    _op_load_secrets
fi

    {{- end -}}
  {{- end -}}
{{- end -}}
