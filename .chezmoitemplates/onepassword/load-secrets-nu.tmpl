{{- /* Template for loading 1Password secrets into environment variables (Nushell) */ -}}
{{- /* This template generates Nushell code to automatically load secrets from 1Password */ -}}
{{- /* Usage: Include this template in Nushell configuration files */ -}}

{{- $env_type := "" -}}
{{- if eq .WORK_ENVIRONMENT true -}}
  {{- $env_type = "work" -}}
{{- else if eq .PERSONAL_ENVIRONMENT true -}}
  {{- $env_type = "personal" -}}
{{- end -}}

{{- if ne $env_type "" -}}
  {{- $secrets := (index .onepassword $env_type).secrets -}}
  {{- if $secrets -}}
    {{- if gt (len $secrets) 0 -}}

# Auto-load 1Password secrets ({{ $env_type }} environment)
# Cache file to avoid repeated CLI calls
let op_secrets_cache = ($env.XDG_CACHE_HOME? | default ($env.HOME | path join ".cache") | path join "op-secrets.cache")
let op_secrets_ttl = 3600  # Cache for 1 hour

# Function to load secrets from 1Password
def _op_load_secrets [] {
    let cache_file = $op_secrets_cache
    let current_time = (date now | format date "%s" | into int)

    # Check if cache exists and is fresh
    if ($cache_file | path exists) {
        let cache_info = (ls -l $cache_file | first)
        let cache_time = ($cache_info.modified | format date "%s" | into int)
        let cache_age = ($current_time - $cache_time)

        if $cache_age < $op_secrets_ttl {
            # Load from cache
            try {
                source $cache_file
                return
            }
        }
    }

    # Create cache directory if needed
    mkdir ($cache_file | path dirname)

    # Create new cache file with secure permissions
    touch $cache_file
    chmod 600 $cache_file

    # Load secrets and write to cache
    mut loaded = 0
    mut failed = 0
      {{- range $secrets }}

    # Load: {{ .env_var }} from {{ .vault }}/{{ .item }}
    try {
        let secret = (^op-helper get "{{ .vault }}" "{{ .item }}" "{{ .field }}" | complete | get stdout | str trim)
        if ($secret | is-not-empty) {
            $env.{{ .env_var }} = $secret
            echo "$env.{{ .env_var }} = 'REDACTED'" | save --append $cache_file
            $loaded = $loaded + 1
        } else {
            $failed = $failed + 1
        }
    } catch {
        $failed = $failed + 1
    }
      {{- end }}

    if $loaded > 0 {
        print $"(ansi green)✓ Loaded ($loaded) secret\(s\) from 1Password(ansi reset)"
    }

    if $failed > 0 {
        print $"(ansi yellow)⚠️  Failed to load ($failed) secret\(s\)(ansi reset)"
    }
}

# Load secrets on shell startup (only if op-helper is available)
if (which op-helper | is-not-empty) {
    _op_load_secrets
}

    {{- end -}}
  {{- end -}}
{{- end -}}
