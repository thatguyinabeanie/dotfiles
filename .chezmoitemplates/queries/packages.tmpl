{{- /*
Generic package query template - the ONLY query template needed!
Usage: {{ template "queries/packages.tmpl" (dict "PackageManager" "npm" "root" .) }}
Supported managers: cargo, npm, pip, go, gem, mise, mas

Profile filtering: packages with a "profiles" field are only included if at least one
of their profiles matches an active profile. Packages without a "profiles" field are
always included (backward compatible). The "default" profile is always active.
*/ -}}
{{- $manager := .PackageManager -}}
{{- $root := .root -}}
{{- $packages := list -}}

{{- /* Parse active profiles; "default" is always active */ -}}
{{- $active_profiles := splitList "," (index $root "ACTIVE_PROFILES" | default "default") -}}
{{- if not (has "default" $active_profiles) -}}
  {{- $active_profiles = append $active_profiles "default" -}}
{{- end -}}

{{- if eq $manager "mise" -}}
  {{- /* Special case for mise: collect dev_tools */ -}}
  {{- range $root.dev_tools -}}
    {{- if has "mise" .installer -}}
      {{- $profileMatch := true -}}
      {{- if hasKey . "profiles" -}}
        {{- $profileMatch = false -}}
        {{- range .profiles -}}
          {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
        {{- end -}}
      {{- end -}}
      {{- if $profileMatch -}}
        {{- $packages = append $packages .name -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- /* Standard package managers: collect from all relevant sources */ -}}

  {{- /* Language servers */ -}}
  {{- range $root.language_servers -}}
    {{- if has $manager .installer -}}
      {{- $profileMatch := true -}}
      {{- if hasKey . "profiles" -}}
        {{- $profileMatch = false -}}
        {{- range .profiles -}}
          {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
        {{- end -}}
      {{- end -}}
      {{- if $profileMatch -}}
        {{- if and (eq $manager "go") .install_command -}}
          {{- $packages = append $packages .install_command -}}
        {{- else if eq $manager "go" -}}
          {{- $packages = append $packages (printf "%s@latest" .name) -}}
        {{- else -}}
          {{- $packages = append $packages .name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* Formatters */ -}}
  {{- range $root.formatters -}}
    {{- if has $manager .installer -}}
      {{- $profileMatch := true -}}
      {{- if hasKey . "profiles" -}}
        {{- $profileMatch = false -}}
        {{- range .profiles -}}
          {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
        {{- end -}}
      {{- end -}}
      {{- if $profileMatch -}}
        {{- if and (eq $manager "go") .install_command -}}
          {{- $packages = append $packages .install_command -}}
        {{- else if eq $manager "go" -}}
          {{- $packages = append $packages (printf "%s@latest" .name) -}}
        {{- else -}}
          {{- $packages = append $packages .name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* Linters */ -}}
  {{- range $root.linters -}}
    {{- if has $manager .installer -}}
      {{- $profileMatch := true -}}
      {{- if hasKey . "profiles" -}}
        {{- $profileMatch = false -}}
        {{- range .profiles -}}
          {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
        {{- end -}}
      {{- end -}}
      {{- if $profileMatch -}}
        {{- if and (eq $manager "go") .install_command -}}
          {{- $packages = append $packages .install_command -}}
        {{- else if eq $manager "go" -}}
          {{- $packages = append $packages (printf "%s@latest" .name) -}}
        {{- else -}}
          {{- $packages = append $packages .name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* Dev tools (cargo only, others handled by mise) */ -}}
  {{- if eq $manager "cargo" -}}
    {{- range $root.dev_tools -}}
      {{- if has "cargo" .installer -}}
        {{- $profileMatch := true -}}
        {{- if hasKey . "profiles" -}}
          {{- $profileMatch = false -}}
          {{- range .profiles -}}
            {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if $profileMatch -}}
          {{- $packages = append $packages .name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* AI agents and MCP servers (npm/pip only) */ -}}
  {{- if or (eq $manager "npm") (eq $manager "pip") -}}
    {{- range $root.agents -}}
      {{- if has $manager .installer -}}
        {{- $profileMatch := true -}}
        {{- if hasKey . "profiles" -}}
          {{- $profileMatch = false -}}
          {{- range .profiles -}}
            {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if $profileMatch -}}
          {{- $packages = append $packages .name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- range $root.mcp_servers -}}
      {{- if has $manager .installer -}}
        {{- $profileMatch := true -}}
        {{- if hasKey . "profiles" -}}
          {{- $profileMatch = false -}}
          {{- range .profiles -}}
            {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if $profileMatch -}}
          {{- $packages = append $packages .name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* Mac App Store applications (mas only) */ -}}
  {{- if eq $manager "mas" -}}
    {{- if $root.applications.shared -}}
      {{- range $root.applications.shared -}}
        {{- if has "mas" .installer -}}
          {{- $profileMatch := true -}}
          {{- if hasKey . "profiles" -}}
            {{- $profileMatch = false -}}
            {{- range .profiles -}}
              {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
            {{- end -}}
          {{- end -}}
          {{- if $profileMatch -}}
            {{- $packages = append $packages .app_id -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if $root.applications.personal -}}
      {{- range $root.applications.personal -}}
        {{- if has "mas" .installer -}}
          {{- $profileMatch := true -}}
          {{- if hasKey . "profiles" -}}
            {{- $profileMatch = false -}}
            {{- range .profiles -}}
              {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
            {{- end -}}
          {{- end -}}
          {{- if $profileMatch -}}
            {{- $packages = append $packages .app_id -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if $root.applications.work -}}
      {{- range $root.applications.work -}}
        {{- if has "mas" .installer -}}
          {{- $profileMatch := true -}}
          {{- if hasKey . "profiles" -}}
            {{- $profileMatch = false -}}
            {{- range .profiles -}}
              {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
            {{- end -}}
          {{- end -}}
          {{- if $profileMatch -}}
            {{- $packages = append $packages .app_id -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $packages | sortAlpha | uniq | join " " -}}
