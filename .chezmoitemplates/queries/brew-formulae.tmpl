{{- end -}}

{{- /* Collect from dev_tools */ -}}
{{- range .dev_tools -}}
  {{- if has "brew" .installer -}}
    {{- $profileMatch := true -}}
    {{- if hasKey . "profiles" -}}
      {{- $profileMatch = false -}}
