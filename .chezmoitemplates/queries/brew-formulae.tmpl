        {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if $profileMatch -}}
      {{- $packages = append $packages .name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Collect from agents */ -}}
{{- range .agents -}}
  {{- if has "brew" .installer -}}
    {{- $profileMatch := true -}}
    {{- if hasKey . "profiles" -}}
      {{- $profileMatch = false -}}
      {{- range .profiles -}}
        {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if $profileMatch -}}
      {{- $packages = append $packages .name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Return sorted unique list */ -}}
{{- $packages | sortAlpha | uniq | join " " -}}
