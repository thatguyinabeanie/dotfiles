{{- range .linters -}}
  {{- if has "brew" .installer -}}
    {{- $profileMatch := true -}}
    {{- if hasKey . "profiles" -}}
      {{- $profileMatch = false -}}
      {{- range .profiles -}}
        {{- if has . $active_profiles -}}{{- $profileMatch = true -}}{{- end -}}
