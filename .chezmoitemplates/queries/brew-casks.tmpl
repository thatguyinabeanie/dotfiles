{{- /* Query template for Homebrew casks (GUI applications) */ -}}
{{- $packages := list -}}

{{- /* Collect from dev_tools */ -}}
{{- range .dev_tools -}}
  {{- if and (has "brew_cask" .installer) (ne (toString (get . "install")) "false") -}}
    {{- $packages = append $packages .name -}}
  {{- end -}}
{{- end -}}

{{- /* Collect from agents */ -}}
{{- range .agents -}}
  {{- if and (has "brew_cask" .installer) (ne (toString (get . "install")) "false") -}}
    {{- $packages = append $packages .name -}}
  {{- end -}}
{{- end -}}

{{- /* Collect from applications (shared context) */ -}}
{{- if .applications.shared -}}
  {{- range .applications.shared -}}
    {{- if and (has "brew_cask" .installer) (ne (toString (get . "install")) "false") -}}
      {{- $packages = append $packages .name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Collect from applications (personal context) */ -}}
{{- if .applications.personal -}}
  {{- range .applications.personal -}}
    {{- if and (has "brew_cask" .installer) (ne (toString (get . "install")) "false") -}}
      {{- $packages = append $packages .name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Collect from applications (work context) */ -}}
{{- if .applications.work -}}
  {{- range .applications.work -}}
    {{- if and (has "brew_cask" .installer) (ne (toString (get . "install")) "false") -}}
      {{- $packages = append $packages .name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Return sorted unique list */ -}}
{{- $packages | sortAlpha | uniq | join " " -}}
