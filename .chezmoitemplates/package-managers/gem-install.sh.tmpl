#!/bin/bash
# Ruby gem installer - installs packages not managed by mise or Mason

{{ template "utilities/error-handling.sh" }}

# Ensure Ruby is available via mise
if ! mise which ruby >/dev/null 2>&1; then
    log_error "Ruby not found. Please run mise installation first."
    exit 1
fi

log_header "Installing Ruby gem packages"

# Collect gem packages not managed by Mason
GEM_PACKAGES=()

# Language servers not managed by Mason
{{- range .language_servers }}
{{- if and (eq .install_via "gem") (not .mason_ensure_installed) }}
GEM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Formatters not managed by Mason
{{- range .formatters }}
{{- if and (eq .install_via "gem") (not .mason_ensure_installed) }}
GEM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Linters not managed by Mason
{{- range .linters }}
{{- if and (eq .install_via "gem") (not .mason_ensure_installed) }}
GEM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

if [[ ${#GEM_PACKAGES[@]} -eq 0 ]]; then
    log_info "No gem packages to install (all handled by Mason or mise)"
    exit 0
fi

log_step "Installing ${#GEM_PACKAGES[@]} gem packages"

for package in "${GEM_PACKAGES[@]}"; do
    log_substep "Installing $package"
    if gem list -i "$package" >/dev/null 2>&1; then
        log_debug "✓ $package already installed"
    elif gem install "$package" >/dev/null 2>&1; then
        log_debug "✓ $package installed successfully"
    else
        log_error "✗ Failed to install $package"
    fi
done

log_success "Ruby gem package installation completed"