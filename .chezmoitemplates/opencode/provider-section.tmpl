{{/*
OpenCode Provider Section Template
Generates the provider configuration block for opencode.jsonc.

OpenCode auto-discovers model metadata (context limits, capabilities, etc.)
from models.dev via the AI SDK for standard providers. No manual model
definitions are needed — just declare the provider with an empty object.

Usage:
{{- template "opencode/provider-section.tmpl" (dict "provider" .opencode.provider) }}
*/}}

{{- $provider := .provider -}}
{{- $keys := keys $provider | sortAlpha -}}
{{- range $i, $key := $keys }}
{{- if $i }},{{ end }}
    "{{ $key }}": {}
{{- end }}
