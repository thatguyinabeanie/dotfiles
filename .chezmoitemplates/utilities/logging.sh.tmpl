# Enhanced logging utilities with verbosity control and file logging

# Log file configuration
LOG_DIR="${HOME}/.local/log"
LOG_FILE="${LOG_DIR}/chezmoi-install.log"
CHEZMOI_VERBOSE="${CHEZMOI_VERBOSE:-0}"

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Initialize log file with timestamp
if [[ ! -f "$LOG_FILE" ]] || [[ $(find "$LOG_FILE" -mtime +1 2>/dev/null) ]]; then
    echo "=== Chezmoi Installation Log ===" > "$LOG_FILE"
    echo "Started: $(date)" >> "$LOG_FILE"
    echo "" >> "$LOG_FILE"
fi

# Log to file (always)
log_to_file() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

# Show only in verbose mode
log_detail() {
    log_to_file "DETAIL: $*"
    if [[ "${CHEZMOI_VERBOSE}" == "1" ]]; then
        echo "  $*"
    fi
}

# Always show, log to file
log_summary() {
    log_to_file "SUMMARY: $*"
    echo "$*"
}

# Section header with visual separator
log_section() {
    local message="$1"
    local separator="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    log_to_file "SECTION: $message"
    echo ""
    echo "$separator"
    echo "$message"
    echo "$separator"
}

# Emit ✓ or ✗ for a single package install result
log_install_result() {
    local status="$1"   # "ok" or "fail"
    local name="$2"
    if [[ "$status" == "ok" ]]; then
        echo "  ✓ $name"
    else
        echo "  ✗ $name"
    fi
    log_to_file "${status}: $name"
}

# Emit − or ✗ for a single package removal result
log_uninstall_result() {
    local status="$1"   # "ok" or "fail"
    local name="$2"
    if [[ "$status" == "ok" ]]; then
        echo "  − $name (removed)"
    else
        echo "  ✗ $name (remove failed)"
    fi
    log_to_file "uninstall ${status}: $name"
}

# Colored status messages and small helpers used by the brew scripts and ensure-brew.sh.tmpl
log_info() {
    echo -e "\033[0;34m[INFO]\033[0m $1"
}

log_success() {
    echo -e "\033[0;32m[SUCCESS]\033[0m $1"
}

log_warning() {
    echo -e "\033[1;33m[WARNING]\033[0m $1"
}

log_error() {
    echo -e "\033[0;31m[ERROR]\033[0m $1" >&2
}

log_debug() {
    if [[ "${DEBUG:-false}" == "true" ]]; then
        echo -e "\033[0;90m[DEBUG]\033[0m $1" >&2
    fi
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Export functions for use in other scripts
export -f log_to_file
export -f log_detail
export -f log_summary
export -f log_section
export -f log_install_result
export -f log_uninstall_result
export -f log_info
export -f log_success
export -f log_warning
export -f log_error
export -f log_debug
export -f command_exists
