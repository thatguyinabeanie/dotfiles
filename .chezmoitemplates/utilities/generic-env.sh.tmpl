{{- $shell := .shell -}}
{{- $dot := .data -}}

{{- $shared := (include ".chezmoidata/shared.yaml" | fromYaml) -}}
{{- $work := (include ".chezmoidata/work.yaml" | fromYaml) -}}
{{- $personal := (include ".chezmoidata/personal.yaml" | fromYaml) -}}

# Generated from consolidated environment configuration
# Edit .chezmoidata/shared.yaml, work.yaml, personal.yaml files to modify

#
# SIMPLE VARIABLES
#
{{- range $key, $value := $shared.env_shared.variables }}
export {{ $key }}="{{ $value }}"
{{- end }}

##
## TEMPLATE VARIABLES
##
export BAT_THEME="Catppuccin {{ title $dot.CATPPUCCIN_FLAVOR }}"
export WORK_ENVIRONMENT="{{ $dot.WORK_ENVIRONMENT }}"
export GIT_NAME="{{ $dot.git.config.name }}"
export GITHUB_USERNAME="{{ $dot.git.config.username }}"
export GIT_EMAIL="{{ $dot.git.config.email }}"

##
## PATH-BASED VARIABLES
##
{{- range $key, $config := $shared.env_shared.path_variables }}
{{- if hasKey $config "path" }}
export {{ $key }}="${{ trimPrefix "$" $config.base }}/{{ $config.path }}"
{{- else }}
export {{ $key }}="${{ trimPrefix "$" $config.base }}"
{{- end }}
{{- end }}


##
## GROUPED PATH VARIABLES
##
{{- range $group_name, $group_config := $shared.env_shared.path_groups }}
{{- range $var_name, $var_path := $group_config.paths }}
export {{ $var_name }}="${{ trimPrefix "$" $group_config.base }}/{{ $var_path }}"
{{- end }}
{{- end }}


##
## THEME VARIABLES
##
export CATPPUCCIN_FLAVOR="{{ $dot.CATPPUCCIN_FLAVOR }}"

##
## PATH
##
{{- range $entry := $shared.env_shared.env_paths.path }}
{{- if contains "$HOME" $entry }}
export PATH="{{ $entry }}:$PATH"
{{- else if contains "$XDG_CONFIG_HOME" $entry }}
export PATH="{{ $entry }}:$PATH"
{{- else if contains "$XDG_DATA_HOME" $entry }}
export PATH="{{ $entry }}:$PATH"
{{- else }}
export PATH="{{ $entry }}:$PATH"
{{- end }}
{{- end }}


# Shell-specific configuration
{{- if eq $dot.chezmoi.os "darwin" }}
export SHELL="/opt/homebrew/bin/zsh"
{{- else }}
export SHELL="/bin/zsh"
{{- end }}
export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" | bat -p -lman'"

##
## WORK ENVIRONMENT
##
{{- if and (hasKey $dot "WORK_ENVIRONMENT") (eq $dot.WORK_ENVIRONMENT true) }}
{{- if hasKey $work "env_work" }}

# Work variables
{{- range $key, $value := $work.env_work.variables }}
{{- if eq $key "WORK_ENVIRONMENT" }}
export {{ $key }}="{{ $dot.WORK_ENVIRONMENT | default false }}"
{{- else if and $value (not (hasPrefix "{{" (toString $value))) }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}


# Work paths
{{- if hasKey $work.env_work "paths" }}
{{- range $key, $value := $work.env_work.paths }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}


# Work development environment
{{- if hasKey $work.env_work "development" }}
{{- if hasKey $work.env_work.development "git" }}
{{- range $key, $value := $work.env_work.development.git }}
{{- if and $value (not (hasPrefix "{{" (toString $value))) }}
export WORK_GIT_{{ upper $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- end }}
{{- if hasKey $work.env_work.development "ssh" }}
{{- range $key, $value := $work.env_work.development.ssh }}
export WORK_SSH_{{ upper $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- if hasKey $work.env_work.development "security" }}
{{- range $key, $value := $work.env_work.development.security }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- end }}

# Work cloud configuration
{{- if hasKey $work.env_work "cloud" }}
{{- range $provider_name, $provider_config := $work.env_work.cloud }}
{{- range $key, $value := $provider_config }}
{{- if and $value (not (hasPrefix "{{" (toString $value))) }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}


{{- end }}
{{- end }}

# Work environment overrides
{{- if hasKey $work.env_work "overrides" }}
{{- range $key, $value := $work.env_work.overrides }}
export {{ $key }}="{{ $value }}"
{{- end }}

{{- end }}
{{- end }}
{{- end }}


##
## PERSONAL ENVIRONMENT
##
{{- if eq ($dot.PERSONAL_ENVIRONMENT | default false) true }}
{{- if hasKey $personal "env_personal" }}

# Personal variables
{{- range $key, $value := $personal.env_personal.variables }}
{{- if eq $key "PERSONAL_ENVIRONMENT" }}
export {{ $key }}="{{ $dot.PERSONAL_ENVIRONMENT | default true }}"
{{- else if and $value (not (hasPrefix "{{" (toString $value))) }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}


# Personal paths
{{- if hasKey $personal.env_personal "paths" }}
{{- range $key, $value := $personal.env_personal.paths }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}


# Personal development environment
{{- if hasKey $personal.env_personal "development" }}
{{- if hasKey $personal.env_personal.development "git" }}
{{- range $key, $value := $personal.env_personal.development.git }}
{{- if and $value (not (hasPrefix "{{" (toString $value))) }}
export PERSONAL_GIT_{{ upper $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- end }}
{{- if hasKey $personal.env_personal.development "ssh" }}
{{- range $key, $value := $personal.env_personal.development.ssh }}
export PERSONAL_SSH_{{ upper $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- end }}

# Personal applications
{{- if hasKey $personal.env_personal "applications" }}
{{- range $app_category, $app_config := $personal.env_personal.applications }}
{{- range $key, $value := $app_config }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- end }}

# Personal cloud configuration
{{- if hasKey $personal.env_personal "cloud" }}
{{- range $provider_name, $provider_config := $personal.env_personal.cloud }}
{{- range $key, $value := $provider_config }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}

{{- end }}

{{- end }}
{{- end }}

{{ template "utilities/platform-storage.tmpl" (dict "syntax" "export" "context" $dot) }}
