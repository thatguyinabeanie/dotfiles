{{- $shell := .shell -}}
{{- $dot := .data -}}

{{- $shared := (include ".chezmoidata/shared.yaml" | fromYaml) -}}
{{- $work := (include ".chezmoidata/work.yaml" | fromYaml) -}}
{{- $personal := (include ".chezmoidata/personal.yaml" | fromYaml) -}}

# Generated from consolidated environment configuration
# Edit .chezmoidata/shared.yaml, work.yaml, personal.yaml files to modify

##
## SIMPLE VARIABLES
##
{{- range $key, $value := $shared.env_shared.variables }}
{{- if eq $shell "nushell" }}
$env.{{ $key }} = "{{ $value }}"
{{- else }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}

##
## TEMPLATE VARIABLES
##
{{- if eq $shell "nushell" }}
$env.BAT_THEME = "Catppuccin {{ title $dot.CATPPUCCIN_FLAVOR }}"
$env.WORK_ENVIRONMENT = "{{ $dot.WORK_ENVIRONMENT }}"
$env.GIT_NAME = "{{ $dot.git.config.name }}"
$env.GITHUB_USERNAME = "{{ $dot.git.config.username }}"
$env.GIT_EMAIL = "{{ $dot.git.config.email }}"
{{- else }}
export BAT_THEME="Catppuccin {{ title $dot.CATPPUCCIN_FLAVOR }}"
export WORK_ENVIRONMENT="{{ $dot.WORK_ENVIRONMENT }}"
export GIT_NAME="{{ $dot.git.config.name }}"
export GITHUB_USERNAME="{{ $dot.git.config.username }}"
export GIT_EMAIL="{{ $dot.git.config.email }}"
{{- end }}

##
## PATH-BASED VARIABLES
##
{{- range $key, $config := $shared.env_shared.path_variables }}
{{- if eq $shell "nushell" }}
{{- if hasKey $config "path" }}
$env.{{ $key }} = ($env.{{ trimPrefix "$" $config.base }} | path join "{{ $config.path }}")
{{- else }}
$env.{{ $key }} = $env.{{ trimPrefix "$" $config.base }}
{{- end }}
{{- else }}
{{- if hasKey $config "path" }}
export {{ $key }}="${{ trimPrefix "$" $config.base }}/{{ $config.path }}"
{{- else }}
export {{ $key }}="${{ trimPrefix "$" $config.base }}"
{{- end }}
{{- end }}
{{- end }}

##
## GROUPED PATH VARIABLES
##
{{- range $group_name, $group_config := $shared.env_shared.path_groups }}
{{- range $var_name, $var_path := $group_config.paths }}
{{- if eq $shell "nushell" }}
$env.{{ $var_name }} = ($env.{{ trimPrefix "$" $group_config.base }} | path join "{{ $var_path }}")
{{- else }}
export {{ $var_name }}="${{ trimPrefix "$" $group_config.base }}/{{ $var_path }}"
{{- end }}
{{- end }}
{{- end }}

##
## COMMAND-BASED VARIABLES
##
{{- if eq $shell "nushell" }}
{{- range $key, $config := $shared.env_shared.command_variables }}
{{- if typeIs "string" $config }}
$env.{{ $key }} = (^{{ $config }} | str trim)
{{- else }}
$env.{{ $key }} = ({{ $config.command }})
{{- end }}
{{- end }}
{{- end }}

##
## DERIVED PATH VARIABLES
##
{{- range $key, $config := $shared.env_shared.derived_path_variables }}
{{- if eq $shell "nushell" }}
{{- if hasKey $config "path" }}
$env.{{ $key }} = ($env.{{ trimPrefix "$" $config.base }} | path join "{{ $config.path }}")
{{- else }}
$env.{{ $key }} = $env.{{ trimPrefix "$" $config.base }}
{{- end }}
{{- else }}
{{- if hasKey $config "path" }}
export {{ $key }}="${{ trimPrefix "$" $config.base }}/{{ $config.path }}"
{{- else }}
export {{ $key }}="${{ trimPrefix "$" $config.base }}"
{{- end }}
{{- end }}
{{- end }}

##
## THEME VARIABLES
##
{{- if eq $shell "nushell" }}
$env.CATPPUCCIN_FLAVOR = "{{ $dot.CATPPUCCIN_FLAVOR }}"
{{- else }}
export CATPPUCCIN_FLAVOR="{{ $dot.CATPPUCCIN_FLAVOR }}"
{{- end }}

##
## PATH
##
{{- if eq $shell "nushell" }}
$env.PATH = ($env.PATH | split row (char esep) | prepend [
{{- range $path.env_paths.path }}
{{- if contains "$XDG_HOME" . }}
    ($env.XDG_HOME | path join "{{ trimPrefix "$XDG_HOME/" . }}")
{{- else if contains "$HOME" . }}
    ($env.HOME | path join "{{ trimPrefix "$HOME/" . }}")
{{- else if contains "$XDG_CONFIG_HOME" . }}
    ($env.XDG_CONFIG_HOME | path join "{{ trimPrefix "$XDG_CONFIG_HOME/" . }}")
{{- else if contains "$XDG_DATA_HOME" . }}
    ($env.XDG_DATA_HOME | path join "{{ trimPrefix "$XDG_DATA_HOME/" . }}")
{{- else if contains "$GOPATH" . }}
    ($env.GOPATH | path join "{{ trimPrefix "$GOPATH/" . }}")
{{- else }}
    "{{ . }}"
{{- end }}
{{- end }}
] | uniq )
{{- else }}
{{- range $entry := $path.env_paths.path }}
{{- if contains "$HOME" $entry }}
export PATH="{{ $entry }}:$PATH"
{{- else if contains "$XDG_CONFIG_HOME" $entry }}
export PATH="{{ $entry }}:$PATH"
{{- else if contains "$XDG_DATA_HOME" $entry }}
export PATH="{{ $entry }}:$PATH"
{{- else }}
export PATH="{{ $entry }}:$PATH"
{{- end }}
{{- end }}
{{- end }}

# Shell-specific configuration
{{- if eq $shell "nushell" }}
{{- if eq $dot.chezmoi.os "darwin" }}
$env.SHELL = "/opt/homebrew/bin/nu"
{{- else }}
$env.SHELL = "/usr/bin/nu"
{{- end }}
$env."config.buffer_editor" = "nvim"
{{- else }}
{{- if eq $dot.chezmoi.os "darwin" }}
export SHELL="/opt/homebrew/bin/zsh"
{{- else }}
export SHELL="/bin/zsh"
{{- end }}
export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" | bat -p -lman'"
{{- end }}

##
## WORK ENVIRONMENT
##
{{- if and (hasKey $dot "WORK_ENVIRONMENT") (eq $dot.WORK_ENVIRONMENT true) }}
{{- if hasKey $work "env_work" }}
{{- range $key, $value := $work.env_work.variables }}
{{- if eq $key "WORK_ENVIRONMENT" }}
{{- if eq $shell "nushell" }}
$env.{{ $key }} = "{{ $dot.WORK_ENVIRONMENT | default false }}"
{{- else }}
export {{ $key }}="{{ $dot.WORK_ENVIRONMENT | default false }}"
{{- end }}
{{- else if and $value (not (hasPrefix "{{" (toString $value))) }}
{{- if eq $shell "nushell" }}
$env.{{ $key }} = "{{ $value }}"
{{- else }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

##
## PERSONAL ENVIRONMENT
##
{{- if eq ($dot.PERSONAL_ENVIRONMENT | default false) true }}
{{- if hasKey $personal "env_personal" }}
{{- range $key, $value := $personal.env_personal.variables }}
{{- if eq $key "PERSONAL_ENVIRONMENT" }}
{{- if eq $shell "nushell" }}
$env.{{ $key }} = "{{ $dot.PERSONAL_ENVIRONMENT | default true }}"
{{- else }}
export {{ $key }}="{{ $dot.PERSONAL_ENVIRONMENT | default true }}"
{{- end }}
{{- else if and $value (not (hasPrefix "{{" (toString $value))) }}
{{- if eq $shell "nushell" }}
$env.{{ $key }} = "{{ $value }}"
{{- else }}
export {{ $key }}="{{ $value }}"
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{ end }}

{{- if eq $shell "nushell" }}
{{- template "utilities/platform-storage.tmpl" (dict "syntax" "nushell" "context" $dot) }}

$env.CARAPACE_BRIDGES = 'zsh,bash,inshellisense'
carapace _carapace nushell | save -f ~/.cache/carapace/init.nu
mkdir $nu.data-dir
if not (($nu.data-dir | path join "vendor/autoload/mise_activate.nu") | path exists) {
    mise activate nu | save -f ($nu.data-dir | path join "vendor/autoload/mise_activate.nu")
}
if not (($nu.data-dir | path join "vendor/autoload/zoxide.nu") | path exists) {
    zoxide init nushell | save -f ($nu.data-dir | path join "vendor/autoload/zoxide.nu")
}
if not (($nu.data-dir | path join "vendor/autoload/starship.nu") | path exists) {
    starship init nu | save -f ($nu.data-dir | path join "vendor/autoload/starship.nu")
}
if ($env.HOME | path join ".cargo/env.nu" | path exists) {
    cp ($env.HOME | path join ".cargo/env.nu") ($nu.data-dir | path join "vendor/autoload")
}
{{- else }}
{{- template "utilities/platform-storage.tmpl" (dict "syntax" "export" "context" $dot) }}
{{- end }}
