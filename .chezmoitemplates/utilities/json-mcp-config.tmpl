{{/*
JSON MCP Configuration Template
Generates MCP server configurations with proper JSON structure

Usage:
{{- template "utilities/json-mcp-config.tmpl" .mcp_data }}
*/}}

{{- $mcpData := . -}}
{{- if $mcpData }}
  "mcp": {
{{- $serverNames := keys $mcpData | sortAlpha -}}
{{- range $i, $serverName := $serverNames }}
{{- $serverConfig := index $mcpData $serverName }}
    "{{ $serverName }}": {
{{- if hasKey $serverConfig "type" }}
      "type": "{{ $serverConfig.type }}",
{{- end }}
{{- if hasKey $serverConfig "url" }}
      "url": "{{ $serverConfig.url }}",
{{- end }}
{{- if hasKey $serverConfig "command" }}
      "command": [{{ range $j, $cmd := $serverConfig.command }}{{ if gt $j 0 }}, {{ end }}"{{ $cmd }}"{{ end }}],
{{- end }}
{{- if hasKey $serverConfig "headers" }}
      "headers": {
{{- $headerKeys := keys $serverConfig.headers | sortAlpha -}}
{{- range $k, $headerKey := $headerKeys }}
        "{{ $headerKey }}": "{{ index $serverConfig.headers $headerKey }}"{{ if lt $k (sub (len $headerKeys) 1) }},{{ end }}
{{- end }}
      },
{{- end }}
{{- if hasKey $serverConfig "enabled" }}
      "enabled": {{ $serverConfig.enabled }}
{{- end }}
    }{{ if lt $i (sub (len $serverNames) 1) }},{{ end }}
{{- end }}
  },
{{- end -}}