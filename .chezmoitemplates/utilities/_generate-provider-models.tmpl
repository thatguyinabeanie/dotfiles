{{- /*
  Generates the JSON model object for a single provider.
  Loads model data from .chezmoidata/ai/<provider>.yaml
  Expects: Provider (string), SourceDir (path), Indent (int)
*/ -}}
{{- $provider := .Provider -}}
{{- $yamlPath := printf "%s/.chezmoidata/ai/%s.yaml" .SourceDir $provider -}}
{{- $providerData := (index (fromYaml (include $yamlPath)) $provider) -}}
{{- $modelsObj := dict -}}
{{- range $providerData.models -}}
  {{- $modelsObj = set $modelsObj .name (dict "limit" .limit) -}}
{{- end -}}
{{- toPrettyJson $modelsObj | indent .Indent -}}
