install_cargo_tools() {
    local category="$1"
    shift
    local tools=("$@")

    if [[ ${#tools[@]} -eq 0 ]]; then
        log_debug "No $category cargo tools to install"
        return 0
    fi

    # Ensure rust is available
    if ! mise which rust >/dev/null 2>&1; then
        log_substep "Installing Rust via mise"
        mise install rust@latest
        mise use rust@latest
    fi

    log_step "Installing $category tools via cargo"

    for tool_spec in "${tools[@]}"; do
        # Check if this is a custom install command
        if [[ "$tool_spec" == *"cargo install"* ]]; then
            # Extract tool name from the command for checking if already installed
            tool_name=$(echo "$tool_spec" | sed -n 's/.*--git.*\/\([^/]*\)\.git \([^ ]*\).*/\2/p')
            if [[ -z "$tool_name" ]]; then
                # Fallback: extract last argument as tool name
                tool_name=$(echo "$tool_spec" | awk '{print $NF}')
            fi

            log_substep "Installing $tool_name"
            if cargo install --list | grep -q "^$tool_name "; then
                log_debug "✓ $tool_name already installed"
            elif eval "$tool_spec" >/dev/null 2>&1; then
                log_debug "✓ $tool_name installed successfully"
            else
                log_error "Failed to install $tool_name via cargo"
            fi
        else
            # Standard cargo install
            log_substep "Installing $tool_spec"
            if cargo install --list | grep -q "^$tool_spec "; then
                log_debug "✓ $tool_spec already installed"
            elif cargo install "$tool_spec" >/dev/null 2>&1; then
                log_debug "✓ $tool_spec installed successfully"
            else
                log_error "Failed to install $tool_spec via cargo"
            fi
        fi
    done

    log_success "$category cargo tools installation completed"
}

install_mise_tools() {
    local category="$1"
    shift
    local tools=("$@")

    if [[ ${#tools[@]} -eq 0 ]]; then
        log_debug "No $category mise tools to install"
        return 0
    fi

    log_step "Installing $category tools via mise"

    for tool in "${tools[@]}"; do
        log_substep "Installing $tool"
        # Check if tool already has version specified
        if [[ "$tool" == *"@"* ]]; then
            # Tool already has version, install as-is
            if mise install "$tool" 2>/dev/null; then
                log_debug "✓ $tool installed successfully"
            else
                log_error "Failed to install $tool via mise"
            fi
        else
            # Tool doesn't have version, try with @latest first
            if mise install "$tool@latest" 2>/dev/null; then
                log_debug "✓ $tool installed successfully"
            else
                log_warning "Failed to install $tool@latest, trying without version"
                if mise install "$tool" 2>/dev/null; then
                    log_debug "✓ $tool installed successfully"
                else
                    log_error "Failed to install $tool via mise"
                fi
            fi
        fi
    done

    log_success "$category mise tools installation completed"
}

