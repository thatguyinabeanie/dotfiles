# Function to install tools via different package managers
install_npm_tools() {
    local category="$1"
    shift
    local tools=("$@")

    if [[ ${#tools[@]} -eq 0 ]]; then
        log_debug "No $category npm tools to install"
        return 0
    fi

    # Ensure node is available
    if ! mise which node >/dev/null 2>&1; then
        log_substep "Installing Node.js via mise"
        mise install node@latest
        mise use node@latest
    fi

    log_step "Installing $category tools via npm"

    for tool in "${tools[@]}"; do
        log_substep "Installing $tool"
        if npm list -g "$tool" >/dev/null 2>&1; then
            log_debug "✓ $tool already installed"
        elif npm install -g "$tool" >/dev/null 2>&1; then
            log_debug "✓ $tool installed successfully"
        else
            log_error "Failed to install $tool via npm"
        fi
    done

    log_success "$category npm tools installation completed"
}

