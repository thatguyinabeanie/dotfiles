#!/bin/sh

{{ if eq .platform.is_mac true -}}
echo "🟠 Setting up TouchID for sudo..."
if [ ! -f "/etc/pam.d/sudo_local" ]; then
  echo "auth       sufficient     pam_tid.so" | sudo tee /etc/pam.d/sudo
  echo "🔵 TouchID sudo enabled."
else
  echo "TouchID sudo already configured."
fi
{{ else -}}
echo "TouchID is only available on macOS. Skipping."
{{ end -}}
