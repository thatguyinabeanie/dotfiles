#!/bin/bash

set -euo pipefail

# taskwarrior-restore
# Pulls the latest task backup from GitHub and imports it into Taskwarrior.
#
# Usage: taskwarrior-restore

BACKUP_DIR="${HOME}/.task/backup"
TASKS_FILE="${BACKUP_DIR}/tasks.json"

if [ ! -d "$BACKUP_DIR/.git" ]; then
  echo "ERROR: No backup repo found at $BACKUP_DIR"
  echo "Run taskwarrior-backup first to initialize the repo."
  exit 1
fi

if [ ! -f "$TASKS_FILE" ]; then
  echo "ERROR: No tasks.json found in $BACKUP_DIR"
  echo "The backup repo exists but may be empty. Try: cd $BACKUP_DIR && git pull"
  exit 1
fi

echo "Pulling latest backup from GitHub..."
cd "$BACKUP_DIR"
git pull origin main 2>/dev/null || echo "Warning: could not pull latest (proceeding with local backup)"

echo "Importing tasks from $TASKS_FILE..."
task import "$TASKS_FILE"
echo "Restore complete."
