{{- /* Inline mise architecture configuration */ -}}
{{- $mise := dict "dev_mise_architectures" (dict
  "architectures" (dict
    "native" (dict
      "binary" "mise"
      "launchagent" "com.user.mise-update"
    )
    "x64_variant" (dict
      "binary" "mise-x64"
      "arch" "x64"
      "description" "x64 compatibility"
      "launchagent" "com.user.mise-x64-update"
      "install_on_arm64" true
    )
  )
  "schedule" (dict
    "native" (dict "hour" 9 "minute" 0)
    "x64_variant" (dict "hour" 9 "minute" 15)
  )
) -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.mise-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/mise-install-or-update.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MISE_INSTALL_ARCH</key>
        <string>{{ if eq .chezmoi.arch "amd64" }}x64{{ else }}arm64{{ end }}</string>
        <key>MISE_INSTALL_PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin/{{ $mise.dev_mise_architectures.architectures.native.binary }}</string>
        <key>MISE_QUIET</key>
        <string>true</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{ $mise.dev_mise_architectures.schedule.native.hour }}</integer>
        <key>Minute</key>
        <integer>{{ $mise.dev_mise_architectures.schedule.native.minute }}</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/log/mise-update.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/log/mise-update.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>