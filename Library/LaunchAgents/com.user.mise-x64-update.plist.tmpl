<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.mise-x64-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/mise-install-or-update.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MISE_INSTALL_ARCH</key>
        <string>{{ .architectures.x64_variant.arch }}</string>
        <key>MISE_INSTALL_PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin/{{ .architectures.x64_variant.binary }}</string>
        <key>MISE_QUIET</key>
        <string>true</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{ .schedule.x64_variant.hour }}</integer>
        <key>Minute</key>
        <integer>{{ .schedule.x64_variant.minute }}</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/log/mise-x64-update.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/log/mise-x64-update.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>