{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read(~/.local/share/chezmoi/**)",
      "Read(/tmp/**)",

      "WebSearch",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:dotfiles.substack.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:opencode.ai)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:starship.rs)",
      "WebFetch(domain:yazi-rs.github.io)",

      "Skill(update-config)",
      "mcp__plugin_context7_context7__query-docs",

      "Bash(chezmoi apply:*)",
      "Bash(chezmoi data:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi doctor:*)",
      "Bash(chezmoi init:*)",
      "Bash(chezmoi managed:*)",
      "Bash(chezmoi status:*)",
      "Bash(~/.local/share/chezmoi/.chezmoitemplates/utilities/config-persistence.sh read:*)",

      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git mv:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(git stash push:*)",

      "Bash(gh --version)",
      "Bash(gh issue view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",

      "Bash(brew autoremove:*)",
      "Bash(brew info:*)",
      "Bash(brew leaves:*)",
      "Bash(brew list:*)",
      "Bash(brew search:*)",

      "Bash(mise activate:*)",
      "Bash(mise registry:*)",
      "Bash(mise where:*)",

      "Bash(lefthook run:*)",
      "Bash(npx markdownlint-cli:*)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(vale sync:*)",
      "Bash(cargo:*)",

      "Bash(zsh -c 'source ~/.zshrc && which fzf && fzf --version')",
      "Bash(zsh -c 'zmodload zsh/zprof && source ~/.zshrc && zprof')",
      "Bash(zsh -n ~/.local/state/shell-init/mise-activate.zsh)",

      "Bash(carapace:*)",
      "Bash(starship:*)",
      "Bash(tmux list-keys:*)",
      "Bash(tmux source-file:*)",
      "Bash(yazi:*)",
      "Bash(find ~/.config/yazi/.catppuccin -name *.yazi -o -name flavor*)",
      "Bash(nvim --version)",
      "Bash(taskwarrior-tui --version)",

      "Bash(awk:*)",
      "Bash(cd:*)",
      "Bash(compaudit:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(plutil -convert json -o - -)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
