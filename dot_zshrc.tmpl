# ----------------------------------------------------------------------------
# SECTION 3: Completions
# Pre-generated at chezmoi apply time to avoid ~1.1s of subprocess forks
# Regenerate with: chezmoi apply --force
# ----------------------------------------------------------------------------

# Helper: source pre-generated cache file, fall back to live command
_source_cached() {
  local cache="$HOME/.local/state/shell-init/$1.zsh"
  if [[ -f "$cache" ]]; then
    source "$cache"
  else
    shift
    eval "$@"
  fi
}

{{- $dockerCompletions := printf "%s/.docker/completions/_docker" .chezmoi.homeDir }}
{{- if stat $dockerCompletions }}
fpath=({{ $dockerCompletions }} $fpath)
{{- end }}

{{- if lookPath "chezmoi" }}
_source_cached "chezmoi-completion" 'source <(chezmoi completion zsh)'
{{- end }}

{{- if lookPath "mise" }}
_source_cached "mise-completion" 'source <(mise completion zsh)'
{{- end }}

{{- if lookPath "carapace" }}
# Carapace - Multi-shell completion framework (669+ completers)
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
_source_cached "carapace-init" 'source <(carapace _carapace zsh)'
{{- end }}

