# ----------------------------------------------------------------------------
# SECTION 5: Tool Initializations (DISABLED - eval commands are expensive)
# ----------------------------------------------------------------------------

# {{- if lookPath "atuin" }}
# # atuin - Enhanced shell history
# eval "$(atuin init zsh)"
# {{- end }}

{{- if lookPath "zoxide" }}
# zoxide - Smart cd replacement (TESTING 1/3)
eval "$(zoxide init zsh)"
{{- end }}

{{- if lookPath "starship" }}
# starship - Fancy prompt (ENABLED)
{{- $starshipConfig := printf "%s/.config/starship/starship.toml" .chezmoi.homeDir }}
{{- if stat $starshipConfig }}
export STARSHIP_CONFIG="{{ .chezmoi.homeDir }}/.config/starship/starship.toml"
{{- end }}
eval "$(starship init zsh)"
{{- end }}

{{- if lookPath "mise" }}
# mise - Version manager (pre-generated activation for performance)
_MISE_ACTIVATION="$HOME/.local/state/mise/mise-activation.zsh"
if [[ -f "$_MISE_ACTIVATION" ]]; then
    source "$_MISE_ACTIVATION"
else
    # Fallback: generate if missing (first run)
    eval "$(mise activate zsh)"
fi
{{- end }}


