# ============================================================================
# OPTIMIZED ZSH CONFIG
# Full-featured configuration with performance optimizations
# ============================================================================

# Performance profiling (enable when needed)
# Uncomment to profile startup performance
# zmodload zsh/zprof

# ----------------------------------------------------------------------------
# SECTION 1: Essential Sources (ENABLED - Keep these)
# ----------------------------------------------------------------------------

{{- $zshaliases := printf "%s/.config/zsh/aliases.zsh" .chezmoi.homeDir }}
{{- if stat $zshaliases }}
# Aliases (essential for workflow)
source "{{ $zshaliases }}"
{{- end }}

{{- if lookPath "brew" }}
# Homebrew environment variables (essential)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
[ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
{{- end }}

# Add zsh-completions to fpath (must be before compinit)
{{- if lookPath "brew" }}
{{- $zshCompletionsPath := "/opt/homebrew/share/zsh-completions" }}
{{- if stat $zshCompletionsPath }}
fpath=({{ $zshCompletionsPath }} $fpath)
{{- end }}
{{- end }}

# Optimized completion system with caching
# Only run security check (compaudit) once per day for faster startup
autoload -Uz compinit
setopt EXTENDEDGLOB
for dump in ~/.zcompdump(N.mh+24); do
  compinit
done
if [[ -s "$HOME/.zcompdump" ]]; then
  compinit -C
else
  compinit
fi
unsetopt EXTENDEDGLOB

# Simple prompt (disabled - using starship instead)
# PS1='%F{blue}%~%f %# '

# ----------------------------------------------------------------------------
# SECTION 2: Additional Sources
# ----------------------------------------------------------------------------

{{- $zshHighlightPath := "/opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" }}
{{- if stat $zshHighlightPath }}
# zsh-syntax-highlighting (faster than zinit/fast-syntax-highlighting)
source "{{ $zshHighlightPath }}"
{{- end }}

{{- $zshAutosuggPath := "/opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh" }}
{{- if stat $zshAutosuggPath }}
# zsh-autosuggestions - Command suggestions as you type
source "{{ $zshAutosuggPath }}"
{{- end }}

{{- $zshOnePasswordEnv := printf "%s/.config/zsh/onepassword-env.zsh" .chezmoi.homeDir }}
{{- if stat $zshOnePasswordEnv }}
# 1Password environment configuration
source "{{ $zshOnePasswordEnv }}"
{{- end }}

{{- $kubectl_functions := printf "%s/source/civis-kubectl-configs/functions.sh" .chezmoi.homeDir }}
{{- if and (eq .WORK_ENVIRONMENT true) (stat $kubectl_functions) }}
# Work-specific kubectl functions
source "{{ $kubectl_functions }}"
{{- end }}

{{- $workShPath := printf "%s/.work.sh" .chezmoi.homeDir }}
{{- if and (eq .WORK_ENVIRONMENT true) (stat $workShPath) }}
# Work-specific shell configuration
source "{{ $workShPath }}"
{{- end }}

{{- $cargoEnvPath := printf "%s/.cargo/env" .chezmoi.homeDir }}
{{- if stat $cargoEnvPath }}
# Cargo environment (Rust toolchain)
source "{{ $cargoEnvPath }}"
{{- end }}

# ----------------------------------------------------------------------------
# SECTION 3: Completions
# ----------------------------------------------------------------------------

{{- $dockerCompletions := printf "%s/.docker/completions/_docker" .chezmoi.homeDir }}
{{- if stat $dockerCompletions }}
fpath=({{ $dockerCompletions }} $fpath)
{{- end }}

{{- if lookPath "chezmoi" }}
source <(chezmoi completion zsh)
{{- end }}

{{- if lookPath "mise" }}
source <(mise completion zsh)
{{- end }}

{{- if lookPath "carapace" }}
# Carapace - Multi-shell completion framework (669+ completers)
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)
{{- end }}

