{{- $zshaliases := printf "%s/.config/zsh/aliases.zsh" .chezmoi.homeDir }}
{{- if stat $zshaliases }}
# Aliases (essential for workflow)
source "{{ $zshaliases }}"
{{- end }}

{{- if lookPath "brew" }}
# Homebrew environment variables (essential)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
[ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
{{- end }}

# Add zsh-completions to fpath (must be before compinit)
{{- if lookPath "brew" }}
{{- $zshCompletionsPath := "/opt/homebrew/share/zsh-completions" }}
{{- if stat $zshCompletionsPath }}
fpath=({{ $zshCompletionsPath }} $fpath)
{{- end }}
{{- end }}

# Optimized completion system with aggressive caching
# - Uses -C flag to skip compaudit security check entirely (saves ~33ms)
# - Only regenerates dump file weekly instead of daily (saves additional overhead)
# - To force regeneration: rm ~/.zcompdump && exec zsh
autoload -Uz compinit
setopt EXTENDEDGLOB
if [[ -n ~/.zcompdump(#qN.mh+168) ]]; then
  # Dump file is older than 1 week, regenerate (skip security check with -u)
  compinit -u
else
  # Use cached dump without any checks
  compinit -C
fi
unsetopt EXTENDEDGLOB

# Simple prompt (disabled - using starship instead)
