{{- $zshHighlightPath := "/opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" }}
{{- if stat $zshHighlightPath }}
# Source additional configuration files
source "{{ $zshHighlightPath }}"
{{- end }}

{{- $zshaliases := printf "%s/.config/zsh/aliases.zsh" .chezmoi.homeDir }}
{{- if stat $zshaliases }}
# Source 1Password environment configuration
source "{{ $zshaliases }}"
{{- end }}

{{- $zshOnePasswordEnv := printf "%s/.config/zsh/onepassword-env.zsh" .chezmoi.homeDir }}
{{- if stat $zshOnePasswordEnv }}
# Source 1Password environment configuration
source "{{ $zshOnePasswordEnv }}"
{{- end }}

{{- $kubectl_functions := printf "%s/source/civis-kubectl-configs/functions.sh" .chezmoi.homeDir }}
{{- if and (eq .WORK_ENVIRONMENT true) (stat $kubectl_functions) }}
# Source work-specific kubectl functions if available
source "{{ $kubectl_functions }}"
{{- end }}

{{- $workShPath := printf "%s/.work.sh" .chezmoi.homeDir }}
{{- if and (eq .WORK_ENVIRONMENT true) (stat $workShPath) }}
# Source work-specific shell configuration if available
source "{{ $workShPath }}"
{{- end }}

{{- $fzfThemePath := printf "%s/.config/fzf/fzf-theme.sh" .chezmoi.homeDir }}
{{- if stat $fzfThemePath }}
# Source FZF theme
source "{{ $fzfThemePath }}"
{{- end }}

{{- $cargoEnvPath := printf "%s/.cargo/env" .chezmoi.homeDir }}
{{- if stat $cargoEnvPath }}
# Source Cargo environment
source "{{ $cargoEnvPath }}"
{{- end }}

{{- $starshipConfig := printf "%s/.config/starship/starship.toml" .chezmoi.homeDir }}
{{- if stat $starshipConfig }}
export STARSHIP_CONFIG="{{ .chezmoi.homeDir }}/.config/starship/starship.toml"
{{- end }}

{{- if lookPath "brew" }}
# Set Homebrew environment variables without modifying PATH
# (PATH is managed in .zshenv for proper priority ordering)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
[ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
{{- end }}

{{- $dockerCompletions := printf "%s/.docker/completions/_docker" .chezmoi.homeDir }}
{{- if stat $dockerCompletions }}
fpath=({{ $dockerCompletions }} $fpath)
{{- end }}

# Initialize completion system before tools that register completions
autoload -Uz compinit
compinit

{{- if lookPath "carapace" }}
# Carapace multi-shell completion framework (669+ completers)
# Load BEFORE fzf-tab so completions are available for fuzzy matching
# CARAPACE_BRIDGES enables using completions from other shell frameworks
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)
{{- end }}

# Native completions for tools not covered by carapace
{{- if lookPath "chezmoi" }}
source <(chezmoi completion zsh)
{{- end }}

{{- if lookPath "mise" }}
source <(mise completion zsh)
{{- end }}

{{- if lookPath "atuin" }}
source <(atuin gen-completions --shell zsh)
{{- end }}

{{- $zinitDir := printf "%s/.local/share/zinit/zinit.git" .chezmoi.homeDir }}
{{- if stat $zinitDir }}
# Initialize zinit plugin manager
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
source "${ZINIT_HOME}/zinit.zsh"

# Load modern ZSH plugins with turbo mode for better performance
# Note: Proper load order is critical:
# 1. Carapace + native completions (loaded above)
# 2. Additional completions (zsh-completions)
# 3. FZF tab completion (fzf-tab) - must load AFTER completions
# 4. Syntax highlighting (fast-syntax-highlighting)
# 5. Autosuggestions (zsh-autosuggestions) - must load LAST

# Additional completion definitions
zinit ice wait lucid atload"zicompinit; zicdreplay"
zinit light zsh-users/zsh-completions

# FZF-powered tab completion (replaces default completion menu)
# Custom fzf-tab configuration is loaded via atload after plugin initializes
zinit ice wait lucid atload'source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/fzf-tab.zsh"'
zinit light Aloxaf/fzf-tab

# Fast syntax highlighting (fork of zsh-syntax-highlighting with better performance)
zinit ice wait lucid atinit"ZINIT[COMPINIT_OPTS]=-C; zicompinit; zicdreplay"
zinit light zdharma-continuum/fast-syntax-highlighting

# Fish-like autosuggestions
zinit ice wait lucid atload"!_zsh_autosuggest_start"
zinit light zsh-users/zsh-autosuggestions

# Remind to use existing aliases
zinit ice wait lucid
zinit light MichaelAquilina/zsh-you-should-use
{{- end }}

{{- if lookPath "atuin" }}
# Initialize atuin for enhanced shell history
eval "$(atuin init zsh)"
{{- end }}

{{- if lookPath "zoxide" }}
eval "$(zoxide init zsh)"
{{- end }}

{{- if lookPath "starship" }}
eval "$(starship init zsh)"
{{- end }}

{{- if lookPath "mise" }}
eval "$(mise activate zsh)"
{{- end }}

{{- if lookPath "fzf" }}
eval "$(fzf --zsh)"
{{- end }}

{{- if lookPath "jira" }}
eval "$(jira completion zsh)"
{{- end }}

{{- if and (lookPath "pokeget") (lookPath "fastfetch")}}
# Display system info with Pokemon and fastfetch if available
# pokeget random --hide-name |
fastfetch --file-raw -
{{- end }}

{{- if lookPath "tmux" }}
{{- if eq (env "ZSH_AUTO_TMUX") "true" }}
# Auto-attach to tmux session for interactive shells (opt-in)
if [[ $- == *i* ]] && [ -z "$TMUX" ]; then
  exec tmux new-session -A -s 'ghostty'
fi
{{- end }}
{{- end }}
