#!/usr/bin/env bash

# Documentation Sync Validation Script
# Ensures agent and human documentation cover the same topics
#
# Usage: .scripts/utilities/doc-sync-check

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

AGENT_DIR=".docs/agent"
HUMAN_DIR=".docs/human"
ERRORS=0

echo "📚 Checking documentation sync..."
echo

# Find all agent docs
AGENT_DOCS=$(find "$AGENT_DIR" -name "*_AGENT.md" -type f 2>/dev/null | sort)

# Check if agent docs have corresponding human docs
for agent_doc in $AGENT_DOCS; do
    # Extract topic name (e.g., NEOVIM from NEOVIM_AGENT.md)
    basename=$(basename "$agent_doc")
    topic="${basename%_AGENT.md}"
    
    # Expected human doc name
    human_doc="$HUMAN_DIR/${topic}_GUIDE.md"
    
    if [[ -f "$human_doc" ]]; then
        echo -e "${GREEN}✓${NC} $topic: Both agent and human docs exist"
    else
        echo -e "${RED}✗${NC} $topic: Missing human guide at $human_doc"
        ((ERRORS++))
    fi
done

echo

# Find all human docs
HUMAN_DOCS=$(find "$HUMAN_DIR" -name "*_GUIDE.md" -type f 2>/dev/null | sort)

# Check if human docs have corresponding agent docs
for human_doc in $HUMAN_DOCS; do
    # Extract topic name (e.g., NEOVIM from NEOVIM_GUIDE.md)
    basename=$(basename "$human_doc")
    topic="${basename%_GUIDE.md}"
    
    # Expected agent doc name
    agent_doc="$AGENT_DIR/${topic}_AGENT.md"
    
    # Check if this is a new human doc without an agent doc
    if [[ ! -f "$agent_doc" ]]; then
        # Check if we already reported this in the reverse check
        if echo "$AGENT_DOCS" | grep -q "$topic"; then
            continue
        fi
        echo -e "${YELLOW}⚠${NC} $topic: Human guide exists but no agent doc (this is okay for some topics)"
    fi
done

echo
echo "📊 Summary:"
echo "   Agent docs: $(echo "$AGENT_DOCS" | wc -l | tr -d ' ')"
echo "   Human docs: $(echo "$HUMAN_DOCS" | wc -l | tr -d ' ')"

if [[ $ERRORS -gt 0 ]]; then
    echo
    echo -e "${RED}❌ Found $ERRORS missing human documentation file(s)${NC}"
    echo
    echo "To fix:"
    echo "  1. Create missing human guides in $HUMAN_DIR"
    echo "  2. Use the corresponding agent doc as reference"
    echo "  3. Focus on user-friendly explanations and examples"
    exit 1
else
    echo
    echo -e "${GREEN}✅ Documentation sync check passed!${NC}"
fi
