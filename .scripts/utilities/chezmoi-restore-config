#!/bin/bash

set -euo pipefail

# chezmoi-restore-config
# Restores chezmoi configuration from persistent storage
# This creates ~/.config/chezmoi/chezmoi.toml from backed up values

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHEZMOI_SOURCE_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"

# Generate and source the helper functions
cd "$CHEZMOI_SOURCE_DIR"
eval "$(chezmoi execute-template < .chezmoitemplates/utilities/config-persistence.sh)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

restore_config() {
    local chezmoi_config="${HOME}/.config/chezmoi/chezmoi.toml"
    local chezmoi_dir="$(dirname "$chezmoi_config")"
    local backup_file="${chezmoi_config}.backup"
    
    print_status "Restoring chezmoi configuration from persistent storage..."
    print_status "Storage method: $(detect_storage_method)"
    
    # Check if persistent config exists
    local test_value=$(read_persistent_config "backup_date" 2>/dev/null || echo "")
    if [[ -z "$test_value" ]]; then
        print_error "No persistent configuration backup found."
        print_error "Please run 'chezmoi-backup-config' first to create a backup."
        exit 1
    fi
    
    print_status "Found backup created on: $test_value"
    
    # Create config directory if it doesn't exist
    mkdir -p "$chezmoi_dir"
    
    # Backup existing config if it exists
    if [[ -f "$chezmoi_config" ]]; then
        cp "$chezmoi_config" "$backup_file"
        print_warning "Existing config backed up to: $backup_file"
    fi
    
    # Define all configuration keys to restore
    local -a config_keys=(
        # Core preferences
        "hostname"
        "shell_pref:SHELL"
        "work_environment:WORK_ENVIRONMENT"
        "personal_environment:PERSONAL_ENVIRONMENT"
        "install_sketchy_bar:INSTALL_SKETCHY_BAR"
        "manage_brew_services:MANAGE_BREW_SERVICES"
        "catppuccin_flavor:CATPPUCCIN_FLAVOR"
        
        # Theme system
        "theme_mode:THEME_MODE"
        "theme_light:THEME_LIGHT"
        "theme_dark:THEME_DARK"
        
        # Application settings
        "sudo_touchid:SUDO_TOUCHID"
        
        # UI configuration (data.ui section)
        "ui_opacity:data.ui.opacity"
        "ui_blur:data.ui.blur"
        "ui_font_size:data.ui.font_size"
        "ui_font_family:data.ui.font_family"
        "ui_window_height:data.ui.window_height"
        "ui_window_width:data.ui.window_width"
        "ui_font_thicken:data.ui.font_thicken"
        "ui_cursor_style:data.ui.cursor_style"
        
        # Git configuration (data.git.config section)
        "git_name:data.git.config.name"
        "github_username:data.git.config.username"
        "git_email:data.git.config.email"
        "git_refresh_period:data.git.config.defaultRefreshPeriod"
        "work_org:data.git.config.work_org"
        "git_work_environment:data.git.config.work_environment"
    )
    
    print_status "Creating chezmoi configuration..."
    
    # Start building the TOML file
    cat > "$chezmoi_config" << 'EOF'
# Generated by chezmoi-restore-config
# This file was restored from persistent storage

[data]
EOF
    
    local restored_count=0
    local missing_count=0
    
    # Restore main data section values
    for config_mapping in "${config_keys[@]}"; do
        local persistent_key="${config_mapping%%:*}"
        local toml_key="${config_mapping##*:}"
        
        # Skip nested sections for now
        if [[ "$toml_key" == data.* ]]; then
            continue
        fi
        
        local value=$(read_persistent_config "$persistent_key")
        
        if [[ -n "$value" ]]; then
            # Handle boolean values
            if [[ "$value" == "true" || "$value" == "false" ]]; then
                echo "$toml_key = $value" >> "$chezmoi_config"
            else
                echo "$toml_key = \"$value\"" >> "$chezmoi_config"
            fi
            print_status "Restored $toml_key = $value"
            ((restored_count++))
        else
            print_warning "Missing value for $persistent_key"
            ((missing_count++))
        fi
    done
    
    # Add UI section
    echo "" >> "$chezmoi_config"
    echo "[data.ui]" >> "$chezmoi_config"
    
    for config_mapping in "${config_keys[@]}"; do
        local persistent_key="${config_mapping%%:*}"
        local toml_key="${config_mapping##*:}"
        
        # Only process UI section
        if [[ "$toml_key" != data.ui.* ]]; then
            continue
        fi
        
        local ui_key="${toml_key#data.ui.}"
        local value=$(read_persistent_config "$persistent_key")
        
        if [[ -n "$value" ]]; then
            if [[ "$value" == "true" || "$value" == "false" ]]; then
                echo "$ui_key = $value" >> "$chezmoi_config"
            else
                echo "$ui_key = \"$value\"" >> "$chezmoi_config"
            fi
            ((restored_count++))
        else
            ((missing_count++))
        fi
    done
    
    # Add Git section
    echo "" >> "$chezmoi_config"
    echo "[data.git.config]" >> "$chezmoi_config"
    
    for config_mapping in "${config_keys[@]}"; do
        local persistent_key="${config_mapping%%:*}"
        local toml_key="${config_mapping##*:}"
        
        # Only process git config section
        if [[ "$toml_key" != data.git.config.* ]]; then
            continue
        fi
        
        local git_key="${toml_key#data.git.config.}"
        local value=$(read_persistent_config "$persistent_key")
        
        if [[ -n "$value" ]]; then
            if [[ "$value" == "true" || "$value" == "false" ]]; then
                echo "$git_key = $value" >> "$chezmoi_config"
            else
                echo "$git_key = \"$value\"" >> "$chezmoi_config"
            fi
            ((restored_count++))
        else
            ((missing_count++))
        fi
    done
    
    # Add metadata
    echo "" >> "$chezmoi_config"
    echo "# Restore metadata" >> "$chezmoi_config"
    echo "# Original backup date: $(read_persistent_config 'backup_date')" >> "$chezmoi_config"
    echo "# Restored on: $(date -Iseconds)" >> "$chezmoi_config"
    
    print_success "Configuration restore completed!"
    print_success "Restored: $restored_count values"
    if [[ $missing_count -gt 0 ]]; then
        print_warning "Missing: $missing_count values (will use template defaults)"
    fi
    
    print_status ""
    print_status "Configuration saved to: $chezmoi_config"
    print_status "To apply the restored configuration, run: chezmoi apply"
    
    if [[ -f "$backup_file" ]]; then
        print_status "Previous config backed up to: $backup_file"
    fi
}

show_help() {
    cat << EOF
chezmoi-restore-config - Restore chezmoi configuration from persistent storage

USAGE:
    chezmoi-restore-config [OPTIONS]

DESCRIPTION:
    This command restores your chezmoi configuration from persistent storage
    back to ~/.config/chezmoi/chezmoi.toml. This is useful when:
    
    - You've deleted your chezmoi config file accidentally
    - You're setting up chezmoi on a new machine
    - You want to revert to a previously backed up configuration
    
    The restored configuration includes:
    - Core preferences (shell, work environment, etc.)
    - Theme configuration
    - UI settings (font, opacity, window size, etc.)
    - Git configuration
    - Application settings

OPTIONS:
    -h, --help    Show this help message

EXAMPLES:
    # Restore configuration from backup
    chezmoi-restore-config
    
    # Apply the restored configuration
    chezmoi apply

STORAGE:
    Configuration is read from platform-appropriate storage:
    - macOS: defaults (com.chezmoi.config)
    - Linux: dconf, gsettings, or XDG config (fallback)

SAFETY:
    - Existing chezmoi.toml is backed up before restoration
    - Missing values will use template defaults when chezmoi applies

SEE ALSO:
    chezmoi-backup-config     Backup configuration to persistent storage
    config-persistence-helpers.sh          Low-level config persistence helpers
EOF
}

main() {
    case "${1:-}" in
        -h|--help)
            show_help
            exit 0
            ;;
        "")
            restore_config
            ;;
        *)
            print_error "Unknown option: $1"
            print_error "Use -h or --help for usage information"
            exit 1
            ;;
    esac
}

main "$@"