##
## WINDOW SETTINGS
##
window-height = {{ .ui.window_height }}
window-width = {{ .ui.window_width }}
background-opacity = {{ .ui.opacity }}
background-blur = {{ .ui.blur }}
quit-after-last-window-closed=true
window-padding-y = 4
#window-padding-x = 4

##
## GENERAL SETTINGS
##
desktop-notifications = true
shell-integration-features = true
auto-update = download

##
## STARTUP OPTIONS
##

# On every new Ghostty window, attaches to the TMUX session 'ghostty' if it exists,
# otherwise creates it (set GHOSTTY_NO_TMUX to opt out; see ghostty-init.zsh)
initial-command = ~/.config/ghostty/ghostty-init.zsh

##
## MACOS SPECIFIC SETTINGS
##
mouse-hide-while-typing = true
macos-option-as-alt = true
macos-titlebar-style = hidden

##
## THEME
##
#bold-is-bright = true
# Static theme fallback: catppuccin-{{ .CATPPUCCIN_FLAVOR }}
{{ if eq .THEME_MODE "system" -}}
theme = light:{{ .THEME_LIGHT }},dark:{{ .THEME_DARK }}
{{ else if eq .THEME_MODE "dark" -}}
theme = {{ .THEME_DARK }}
{{ else if eq .THEME_MODE "light" -}}
theme = {{ .THEME_LIGHT }}
{{ end -}}

##
## FONT + CURSOR
##
font-family = {{ .ui.font_family }}
font-thicken = {{ .ui.font_thicken }}
font-size = {{ .ui.font_size }}
cursor-style = {{ .ui.cursor_style }}
cursor-style-blink = {{ .ui.cursor_blink }}

##
## CUSTOM KEYBINDS
##

# new tab opens tmux window ("tab") in existing tmux session (sends Ctrl+a c)
#keybind = super+t=text:\x01c

# closes tmux window in existing tmux session (sends Ctrl+a X)
keybind = super+ctrl+w=text:\x01X

