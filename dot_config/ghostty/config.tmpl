##
## WINDOW SETTINGS
##
window-height = {{ .ui.window_height }}
window-width = {{ .ui.window_width }}
background-opacity = {{ .ui.opacity }}
background-blur = {{ .ui.blur }}
quit-after-last-window-closed=true
window-padding-y = 4
#window-padding-x = 4

##
## GENERAL SETTINGS
##
app-notifications = true
shell-integration-features = true
auto-update = download

##
## STARTUP OPTIONS
##

# Runs only on the first time Ghostty is opened,
# Attaches to TMUX session 'ghostty' if it exists, otherwise creates a new session, then attaches
# COMMENTED OUT: tmux logic moved to shell configs for per-window attachment

{{ if and (hasKey . "SHELL") (eq .SHELL "nu") -}}
initial-command = ~/.config/ghostty/ghostty-init.nu
{{ else -}}
initial-command = ~/.config/ghostty/ghostty-init.zsh
{{ end -}}


##
## MACOS SPECIFIC SETTINGS
##
mouse-hide-while-typing = true
macos-option-as-alt = true
macos-titlebar-style = hidden

##
## THEME
##
#bold-is-bright = true
# Static theme fallback: catppuccin-{{ .CATPPUCCIN_FLAVOR }}
{{ if eq .THEME_MODE "system" -}}
theme = light:{{ .THEME_LIGHT }},dark:{{ .THEME_DARK }}
{{ else if eq .THEME_MODE "dark" -}}
theme = {{ .THEME_DARK }}
{{ else if eq .THEME_MODE "light" -}}
theme = {{ .THEME_LIGHT }}
{{ end -}}

##
## FONT + CURSOR
##
font-family = {{ .ui.font_family }}
font-thicken = {{ .ui.font_thicken }}
font-size = {{ .ui.font_size }}
cursor-style = {{ .ui.cursor_style }}
cursor-style-blink = true

##
## CUSTOM KEYBINDS
##

#new tab opens tmux window in existing tmux session
keybind = super+t=text:\x01c

#closes tmux window in existing tmux session
keybind = super+w=text:\x01X

#closes ghostty window when not in tmux
keybind = super+ctrl+w=close_window

