themes {
  terminal-match {
    // Base colors
    fg "#cdd6f4"   // Catppuccin text
    red "#f38ba8"
    green "#a6e3a1"
    blue "#89b4fa"
    yellow "#f9e2af"
    magenta "#f5c2e7"
    orange "#fab387"
    cyan "#89dceb"
    white "#cdd6f4"
    
    // Match your terminal background exactly
    bg "#1e1e2e"    // Change this to your exact terminal bg color
    black "#1e1e2e" // Same as bg for minimal contrast
  }
}