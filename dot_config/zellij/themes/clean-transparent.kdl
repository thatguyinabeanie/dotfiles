themes {
    clean-mocha {
        // Base Catppuccin Mocha colors
        fg "#cdd6f4" // Text
        red "#f38ba8"
        green "#a6e3a1"
        blue "#89b4fa"
        yellow "#f9e2af"
        magenta "#f5c2e7" // Pink
        orange "#fab387" // Peach
        cyan "#89dceb" // Sky
        white "#cdd6f4" // Text
        
        // Custom background - make it much darker/transparent-looking
        bg "#1e1e2e"    // Catppuccin base instead of surface2
        black "#11111b" // Catppuccin crust for true dark
    }
}