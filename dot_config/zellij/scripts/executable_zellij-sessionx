#!/usr/bin/env bash
#
# SessionX-like session manager for Zellij
# Provides fuzzy finding, session creation, and directory management
# Usage: zellij-sessionx [directory]

set -euo pipefail

# Configuration - match your tmux SessionX settings
CUSTOM_PATHS=(
    "$HOME/source"
    "$HOME/.config"
    "$HOME/.local/share/chezmoi"
)

# Colors for output (Catppuccin Mocha)
RED='\033[38;2;243;139;168m'
GREEN='\033[38;2;166;227;161m'
BLUE='\033[38;2;137;180;250m'
YELLOW='\033[38;2;249;226;175m'
PURPLE='\033[38;2;203;166;247m'
CYAN='\033[38;2;137;220;235m'
RESET='\033[0m'

# Helper functions
log_info() {
    echo -e "${BLUE}ℹ️  $1${RESET}" >&2
}

log_success() {
    echo -e "${GREEN}✅ $1${RESET}" >&2
}

log_error() {
    echo -e "${RED}❌ $1${RESET}" >&2
}

log_warning() {
    echo -e "${YELLOW}⚠️  $1${RESET}" >&2
}

# Check if zellij is available
check_dependencies() {
    if ! command -v zellij &> /dev/null; then
        log_error "zellij is not installed or not in PATH"
        exit 1
    fi
    
    if ! command -v fzf &> /dev/null; then
        log_error "fzf is required for session selection"
        exit 1
    fi
}

# Get existing sessions
get_existing_sessions() {
    zellij list-sessions 2>/dev/null | grep -v "EXITED" | awk '{print $1}' || true
}

# Get directories from custom paths and zoxide
get_session_candidates() {
    local candidates=()
    
    # Add existing sessions with indicator
    while IFS= read -r session; do
        if [[ -n "$session" ]]; then
            candidates+=("🔗 $session")
        fi
    done < <(get_existing_sessions)
    
    # Add custom paths
    for path in "${CUSTOM_PATHS[@]}"; do
        if [[ -d "$path" ]]; then
            local basename=$(basename "$path")
            candidates+=("📁 $basename ($path)")
        fi
    done
    
    # Add zoxide directories if available
    if command -v zoxide &> /dev/null; then
        while IFS= read -r dir; do
            if [[ -d "$dir" && "$dir" != "$HOME" ]]; then
                local basename=$(basename "$dir")
                candidates+=("📂 $basename ($dir)")
            fi
        done < <(zoxide query -l 2>/dev/null | head -20 || true)
    fi
    
    # Add common project directories
    for project_dir in "$HOME/source"/* "$HOME/projects"/* "$HOME/dev"/*; do
        if [[ -d "$project_dir" ]]; then
            local basename=$(basename "$project_dir")
            candidates+=("💼 $basename ($project_dir)")
        fi
    done 2>/dev/null || true
    
    # Remove duplicates and sort
    printf '%s\n' "${candidates[@]}" | sort -u
}

# Create session name from directory
create_session_name() {
    local dir="$1"
    # Replace problematic characters for session names
    basename "$dir" | tr '.' '_' | tr ' ' '_' | tr '-' '_'
}

# Preview function for fzf
create_preview() {
    local selection="$1"
    
    # Parse selection type and path
    if [[ "$selection" =~ ^🔗[[:space:]]+(.+)$ ]]; then
        # Existing session
        local session="${BASH_REMATCH[1]}"
        echo -e "${GREEN}📊 Active Session: $session${RESET}"
        echo ""
        zellij list-sessions 2>/dev/null | grep "^$session" || echo "Session details unavailable"
        echo ""
        echo -e "${CYAN}Press Enter to attach to this session${RESET}"
    elif [[ "$selection" =~ \(([^)]+)\)$ ]]; then
        # Directory path
        local dir="${BASH_REMATCH[1]}"
        if [[ -d "$dir" ]]; then
            echo -e "${BLUE}📁 Directory: $dir${RESET}"
            echo ""
            if [[ -f "$dir/.git/config" ]]; then
                echo -e "${PURPLE}🔧 Git Repository${RESET}"
                if command -v git &> /dev/null; then
                    cd "$dir" && git status --porcelain 2>/dev/null | head -5 || true
                fi
                echo ""
            fi
            echo -e "${YELLOW}📂 Contents:${RESET}"
            ls -la "$dir" 2>/dev/null | head -10 || echo "Cannot read directory"
            echo ""
            echo -e "${CYAN}Press Enter to create/attach session here${RESET}"
        else
            echo -e "${RED}❌ Directory does not exist: $dir${RESET}"
        fi
    fi
}

# Main session selection
select_session() {
    log_info "Loading session candidates..."
    
    local selection
    selection=$(get_session_candidates | fzf \
        --height 80% \
        --layout reverse \
        --no-border \
        --margin 1 \
        --padding 1 \
        --info inline \
        --prompt "🧩 Select/Create Session: " \
        --header $'┌─ Zellij Session Manager ─┐\n│ Enter: Select/Create │ Esc: Cancel │ Ctrl-C: Exit │\n└─────────────────────────────┘\n' \
        --preview 'echo {} | $HOME/.config/zellij/scripts/zellij-sessionx-preview' \
        --preview-window 'right:50%' \
        --bind 'ctrl-d:preview-page-down,ctrl-u:preview-page-up' \
        --color 'bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#94e2d5,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8' \
        --ansi)
    
    if [[ -z "$selection" ]]; then
        log_warning "No selection made"
        exit 0
    fi
    
    handle_selection "$selection"
}

# Handle the user's selection
handle_selection() {
    local selection="$1"
    
    if [[ "$selection" =~ ^🔗[[:space:]]+(.+)$ ]]; then
        # Existing session
        local session="${BASH_REMATCH[1]}"
        log_info "Attaching to existing session: $session"
        exec zellij attach "$session"
    elif [[ "$selection" =~ \(([^)]+)\)$ ]]; then
        # Directory path
        local dir="${BASH_REMATCH[1]}"
        local session_name=$(create_session_name "$dir")
        
        log_info "Creating session '$session_name' in directory: $dir"
        
        # Change to directory and start session
        cd "$dir" || {
            log_error "Cannot change to directory: $dir"
            exit 1
        }
        
        # Check if session already exists
        if get_existing_sessions | grep -q "^$session_name$"; then
            log_info "Session '$session_name' already exists, attaching..."
            exec zellij attach "$session_name"
        else
            log_success "Creating new session: $session_name"
            exec zellij --session "$session_name"
        fi
    else
        log_error "Invalid selection format"
        exit 1
    fi
}

# Create preview script for fzf
create_preview_script() {
    cat > "$HOME/.config/zellij/scripts/zellij-sessionx-preview" << 'EOF'
#!/usr/bin/env bash
# Preview script for zellij-sessionx

selection="$1"

# Colors
RED='\033[38;2;243;139;168m'
GREEN='\033[38;2;166;227;161m'
BLUE='\033[38;2;137;180;250m'
YELLOW='\033[38;2;249;226;175m'
PURPLE='\033[38;2;203;166;247m'
CYAN='\033[38;2;137;220;235m'
RESET='\033[0m'

if [[ "$selection" =~ ^🔗[[:space:]]+(.+)$ ]]; then
    # Existing session
    session="${BASH_REMATCH[1]}"
    echo -e "${GREEN}📊 Active Session: $session${RESET}"
    echo ""
    zellij list-sessions 2>/dev/null | grep "^$session" || echo "Session details unavailable"
    echo ""
    echo -e "${CYAN}Press Enter to attach to this session${RESET}"
elif [[ "$selection" =~ \(([^)]+)\)$ ]]; then
    # Directory path
    dir="${BASH_REMATCH[1]}"
    if [[ -d "$dir" ]]; then
        echo -e "${BLUE}📁 Directory: $dir${RESET}"
        echo ""
        if [[ -f "$dir/.git/config" ]]; then
            echo -e "${PURPLE}🔧 Git Repository${RESET}"
            if command -v git &> /dev/null; then
                cd "$dir" && git status --porcelain 2>/dev/null | head -5 || true
            fi
            echo ""
        fi
        echo -e "${YELLOW}📂 Contents:${RESET}"
        ls -la "$dir" 2>/dev/null | head -10 || echo "Cannot read directory"
        echo ""
        echo -e "${CYAN}Press Enter to create/attach session here${RESET}"
    else
        echo -e "${RED}❌ Directory does not exist: $dir${RESET}"
    fi
fi
EOF
    chmod +x "$HOME/.config/zellij/scripts/zellij-sessionx-preview"
}

# Main function
main() {
    check_dependencies
    create_preview_script
    
    if [[ $# -gt 0 ]]; then
        # Direct directory argument
        local dir="$1"
        if [[ ! -d "$dir" ]]; then
            log_error "Directory does not exist: $dir"
            exit 1
        fi
        
        local session_name=$(create_session_name "$dir")
        cd "$dir"
        
        if get_existing_sessions | grep -q "^$session_name$"; then
            log_info "Attaching to existing session: $session_name"
            exec zellij attach "$session_name"
        else
            log_success "Creating new session: $session_name"
            exec zellij --session "$session_name"
        fi
    else
        # Interactive selection
        select_session
    fi
}

# Run main function
main "$@"
