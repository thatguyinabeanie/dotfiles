// ============================================================================
// Zellij Configuration (KDL Format)
// ============================================================================
// Terminal multiplexer with tmux-like keybindings (Ctrl+a prefix)
// Documentation: https://zellij.dev/documentation/
// ============================================================================

// ============================================================================
// THEME - Catppuccin {{ title .CATPPUCCIN_FLAVOR }}
// ============================================================================
theme "catppuccin-{{ .CATPPUCCIN_FLAVOR }}"

// ============================================================================
// DEFAULT SHELL
// ============================================================================
default_shell "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/zsh{{ else }}/bin/zsh{{ end }}"

// Ensure basic system paths are available (fixes locale not found warning)
env {
    PATH "/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
}

// ============================================================================
// APPEARANCE
// ============================================================================

// Clean, minimal UI with visible pane borders
simplified_ui true
pane_frames true
default_layout "compact"

// Rounded corners when frames are shown
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// ============================================================================
// BEHAVIOR
// ============================================================================

copy_on_select true
mouse_mode true
scroll_buffer_size 50000
on_force_close "quit"
mirror_session false

// Session persistence
session_serialization true
pane_viewport_serialization true
scrollback_lines_to_serialize 5000

// ============================================================================
// KEYBINDINGS
// ============================================================================
// Prefix: Ctrl+a (tmux-like)
// Note: Alt+key bindings avoided to prevent conflicts with Aerospace
// ============================================================================

keybinds clear-defaults=true {

    // ========================================================================
    // NORMAL MODE
    // ========================================================================
    normal {
        // Enter tmux mode with Ctrl+a
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    // ========================================================================
    // TMUX MODE - Activated with Ctrl+a
    // ========================================================================
    tmux {
        // Double Ctrl+a sends literal Ctrl+a
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Exit tmux mode
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }

        // ------------------------------
        // TAB MANAGEMENT
        // ------------------------------
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }

        // Break pane to new tab
        bind "!" { BreakPane; SwitchToMode "Normal"; }

        // Move tab left/right
        bind "<" { MoveTab "Left"; SwitchToMode "Normal"; }
        bind ">" { MoveTab "Right"; SwitchToMode "Normal"; }

        // Toggle between last tabs
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }

        // ------------------------------
        // PANE MANAGEMENT
        // ------------------------------
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }

        // Vim-style focus
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }

        // Swap/Move panes (Shift + vim keys)
        bind "H" { MovePane "Left"; SwitchToMode "Normal"; }
        bind "J" { MovePane "Down"; SwitchToMode "Normal"; }
        bind "K" { MovePane "Up"; SwitchToMode "Normal"; }
        bind "L" { MovePane "Right"; SwitchToMode "Normal"; }

        // Floating panes
        bind "Space" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "f" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }

        // Sync panes (send input to all)
        bind "e" { TogglePaneFrames; SwitchToMode "Normal"; }

        // ------------------------------
        // MODE SWITCHES
        // ------------------------------
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "s" { SwitchToMode "Session"; }
        bind "t" { SwitchToMode "Tab"; }
        bind ":" { SwitchToMode "EnterSearch"; SearchInput 0; }

        // ------------------------------
        // SESSION
        // ------------------------------
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        // ------------------------------
        // PLUGINS
        // ------------------------------
        bind "P" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        // File browser
        bind "b" {
            LaunchOrFocusPlugin "strider" {
                floating true
            };
            SwitchToMode "Normal"
        }

        // Command runner
        bind "R" { SwitchToMode "RenamePane"; PaneNameInput 0; }

        // Quick run command in new pane
        bind ";" {
            Run "zsh" "-c" "read -r cmd && eval $cmd" {
                floating true
            };
            SwitchToMode "Normal"
        }

        // ------------------------------
        // FLOATING TOOLS (Quick Access)
        // ------------------------------

        // LazyGit - Git management
        bind "g" {
            Run "lazygit" {
                floating true
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            };
            SwitchToMode "Normal"
        }

        // Yazi - File browser/picker
        bind "y" {
            Run "yazi" {
                floating true
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            };
            SwitchToMode "Normal"
        }

        // LazyDocker - Container management (Ctrl+a Shift+D since d=detach)
        bind "D" {
            Run "lazydocker" {
                floating true
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            };
            SwitchToMode "Normal"
        }

        // btop - System monitor (Ctrl+a Shift+M since m=move mode)
        bind "M" {
            Run "btop" {
                floating true
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            };
            SwitchToMode "Normal"
        }

        // ------------------------------
        // PANE MANAGEMENT HELPERS
        // ------------------------------

        // Toggle pane zoom (fullscreen) - alternative to 'z'
        bind "_" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
    }

    // ========================================================================
    // RESIZE MODE
    // ========================================================================
    resize {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        // Increase size
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }

        // Decrease size (Shift)
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }

        // Balanced resize
        bind "=" { Resize "Increase"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    // ========================================================================
    // MOVE MODE
    // ========================================================================
    move {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }

        bind "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
    }

    // ========================================================================
    // SCROLL / COPY MODE
    // ========================================================================
    scroll {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }

        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }

        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "v" { EditScrollback; SwitchToMode "Normal"; }
    }

    // ========================================================================
    // SEARCH MODE
    // ========================================================================
    entersearch {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Ctrl c" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    search {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }

        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    // ========================================================================
    // TAB MODE
    // ========================================================================
    tab {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "h" "Left" { GoToPreviousTab; }
        bind "l" "Right" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
    }

    // ========================================================================
    // SESSION MODE
    // ========================================================================
    session {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }

    // ========================================================================
    // RENAME MODES
    // ========================================================================
    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // ========================================================================
    // SHARED BINDINGS
    // ========================================================================
    shared_except "normal" "tmux" "entersearch" "renametab" "renamepane" {
        bind "Esc" { SwitchToMode "Normal"; }
    }

    shared_except "normal" "entersearch" "renametab" "renamepane" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }
}

// ============================================================================
// PLUGINS
// ============================================================================

plugins {
    // Built-in plugins
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    plugin-manager location="zellij:plugin-manager"
    configuration location="zellij:configuration"

    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }

    filepicker location="zellij:strider" {
        cwd "/"
    }

    // Auto-lock when Neovim is focused (enables seamless Ctrl+h/j/k/l navigation)
    autolock location="https://github.com/fresh2dev/zellij-autolock/releases/latest/download/zellij-autolock.wasm" {
        triggers "nvim|vim|vi|nv"              // Lock when these programs open
        watch_triggers "fzf|zoxide|atuin"      // Also lock for these
        watch_interval "1.0"                   // Check every second
    }
}
