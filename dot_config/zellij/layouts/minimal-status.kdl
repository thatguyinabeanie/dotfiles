layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar" {
                show_window_icons false
                show_session_name false
                prefix_separator ""
                suffix_separator ""
                format_left ""
                format_right ""
                format_center "{name}"
                format_precedence "CRL"
                hide_session_name true
                disable_click true
                tabs_display_count 4
            }
        }
        children
    }
    tab name="main"
}