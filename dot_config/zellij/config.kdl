// Zellij Configuration - Tmux-like Workflow
// Complete tmux replacement with vim integration and session management

keybinds clear-defaults=true {
    normal {
        // ===============================
        // VIM NAVIGATION (replaces vim-tmux-navigator)
        // ===============================
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "left";
                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "right";
                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }

        // ===============================
        // TMUX-LIKE KEY BINDINGS (Ctrl+a prefix style)
        // ===============================
        bind "Ctrl a" { SwitchToMode "tmux"; }
        
        // ===============================
        // DIRECT ACCESS (no prefix needed)
        // ===============================
        
        // Session management (replaces SessionX Ctrl+o)
        bind "Ctrl o" { 
            LaunchOrFocusPlugin "session-manager" {
                floating true;
                move_to_focused_tab true;
            };
        }
        
        // Pane splitting (match tmux: v, |, -, s)
        bind "Alt v" { NewPane "Right"; SwitchToMode "normal"; }
        bind "Alt s" { NewPane "Down"; SwitchToMode "normal"; }
        bind "Alt |" { NewPane "Right"; SwitchToMode "normal"; }
        bind "Alt -" { NewPane "Down"; SwitchToMode "normal"; }
        
        // Tab/Window management
        bind "Alt c" { NewTab; SwitchToMode "normal"; }
        bind "Alt x" { CloseFocus; }
        bind "Alt X" { CloseTab; }
        bind "Alt z" { ToggleFocusFullscreen; }
        
        // Window swapping (match tmux Ctrl+Shift+n/p)
        bind "Ctrl Shift p" { GoToPreviousTab; }
        bind "Ctrl Shift n" { GoToNextTab; }
        
        // Chezmoi shortcuts (match tmux Ctrl+d, Ctrl+e)
        bind "Ctrl d" { 
            NewTab {
                cwd "/Users/beanie/.local/share/chezmoi";
            };
        }
        bind "Ctrl e" { 
            NewTab {
                cwd "/Users/beanie/.local/share/chezmoi";
            };
            WriteChars "nvim\n";
        }
        
        // Lock mode for when vim needs raw keys
        bind "Ctrl g" { SwitchToMode "locked"; }
        
        // Clear screen (match tmux Ctrl+Shift+k)
        bind "Ctrl Shift k" { 
            WriteChars "clear\n";
        }
        
        // Toggle status bar (match tmux 't')
        bind "Alt t" { ToggleTab; }
        
        // Quit
        bind "Ctrl q" { Quit; }
        
        // Quick resize
        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        
        // Mode switches for advanced operations
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl r" { SwitchToMode "resize"; }
        bind "Ctrl s" { SwitchToMode "scroll"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
    }
    
    // ===============================
    // TMUX MODE (Ctrl+a prefix)
    // ===============================
    tmux {
        bind "Ctrl a" "Esc" { SwitchToMode "normal"; }
        
        // Session management
        bind "o" { 
            LaunchOrFocusPlugin "session-manager" {
                floating true;
                move_to_focused_tab true;
            };
            SwitchToMode "normal";
        }
        bind "S" { 
            LaunchOrFocusPlugin "session-manager" {
                floating true;
                move_to_focused_tab true;
            };
            SwitchToMode "normal";
        }
        
        // Window/tab operations (match tmux exactly)
        bind "\"" { SwitchToMode "tab"; }
        bind "w" { SwitchToMode "tab"; }
        bind "Ctrl w" { SwitchToMode "tab"; }
        bind "Ctrl a" { GoToPreviousTab; SwitchToMode "normal"; }
        bind "c" { NewTab; SwitchToMode "normal"; }
        
        // Pane operations (match tmux exactly)
        bind "v" { NewPane "Right"; SwitchToMode "normal"; }
        bind "|" { NewPane "Right"; SwitchToMode "normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "normal"; }
        bind "s" { NewPane "Down"; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "x" { CloseFocus; SwitchToMode "normal"; }
        bind "X" { CloseFocus; SwitchToMode "normal"; }
        
        // Pane navigation (prefix mode)
        bind "h" { MoveFocus "Left"; SwitchToMode "normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "normal"; }
        
        // Resize operations
        bind "," { Resize "Increase Left"; }
        bind "." { Resize "Increase Right"; }
        bind "-" { Resize "Increase Down"; }
        bind "=" { Resize "Increase Up"; }
        
        // Reload config (match tmux 'r')
        bind "r" {
            LaunchOrFocusPlugin "configuration-reload" {
                floating true;
            };
            SwitchToMode "normal";
        }
        
        // Rename window
        bind "R" { SwitchToMode "RenameTab"; TabNameInput 0; }
        
        // Detach (like tmux detach)
        bind "d" { Detach; }
        
        // Toggle status
        bind "t" { ToggleTab; SwitchToMode "normal"; }
        
        // List clients/sessions
        bind "*" { 
            LaunchOrFocusPlugin "session-manager" {
                floating true;
                move_to_focused_tab true;
            };
            SwitchToMode "normal";
        }
        
        // Command prompt
        bind ":" { SwitchToMode "normal"; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    
    pane {
        bind "Ctrl p" "Enter" "Esc" { SwitchToMode "normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "n" { NewPane; }
        bind "x" { CloseFocus; }
        bind "z" { ToggleFocusFullscreen; }
        bind "v" { NewPane "Right"; }
        bind "s" { NewPane "Down"; }
        bind "|" { NewPane "Right"; }
        bind "-" { NewPane "Down"; }
    }
    
    tab {
        bind "Ctrl t" "Enter" "Esc" { SwitchToMode "normal"; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "n" { NewTab; }
        bind "x" { CloseTab; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "1" { GoToTab 1; }
        bind "2" { GoToTab 2; }
        bind "3" { GoToTab 3; }
        bind "4" { GoToTab 4; }
        bind "5" { GoToTab 5; }
        bind "6" { GoToTab 6; }
        bind "7" { GoToTab 7; }
        bind "8" { GoToTab 8; }
        bind "9" { GoToTab 9; }
        bind "w" { 
            LaunchOrFocusPlugin "tab-switcher" {
                floating true;
            };
        }
    }
    
    resize {
        bind "Ctrl r" "Enter" "Esc" { SwitchToMode "normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "," { Resize "Increase Left"; }
        bind "." { Resize "Increase Right"; }
    }
    
    scroll {
        bind "Ctrl s" "Enter" "Esc" { SwitchToMode "normal"; }
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
    
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }
    
    search {
        bind "Ctrl s" "Esc" { SwitchToMode "normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    
    renametab {
        bind "Ctrl c" { SwitchToMode "normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    
    session {
        bind "Ctrl o" "Enter" "Esc" { SwitchToMode "normal"; }
        bind "d" { Detach; }
    }
}

// ===============================
// CORE SETTINGS
// ===============================
simplified_ui false  // Enable status bar like tmux
default_shell "zsh"
default_cwd "~"
mouse_mode true
copy_clipboard "system"
copy_on_select false
scrollback_editor "nvim"
session_serialization true
auto_layout true
mirror_session true

// ===============================
// UI CONFIGURATION (no borders)
// ===============================
pane_frames false
theme "catppuccin-mocha-dark"

ui {
    pane_frames {
        rounded_corners false
        hide_session_name false
    }
}

// ===============================
// DEFAULT LAYOUT WITH STATUS ON TOP
// ===============================
default_layout "tmux-like"