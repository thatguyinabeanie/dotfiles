[tools]
# Core development runtimes (with specified versions from tools.yaml)
{{- range $tool := .dev_tools }}
{{- if eq $tool.install_via "mise" }}
{{- if or (eq $tool.name "node") (eq $tool.name "python") (eq $tool.name "go") (eq $tool.name "rust") }}
{{ $tool.name | quote }} = {{ if hasKey $tool "version" }}{{ $tool.version | quote }}{{ else }}"latest"{{ end }}
{{- end }}
{{- end }}
{{- end }}

# Development tools that install via mise (excluding core runtimes)
{{- range $tool := .dev_tools }}
{{- if eq $tool.install_via "mise" }}
{{- if and $tool.name (not (or (eq $tool.name "node") (eq $tool.name "python") (eq $tool.name "go") (eq $tool.name "rust"))) }}
{{ $tool.name | quote }} = {{ if hasKey $tool "version" }}{{ $tool.version | quote }}{{ else }}"latest"{{ end }}
{{- end }}
{{- end }}
{{- end }}

# Language servers managed via mise (not Mason)
{{- range $lsp := .language_servers }}
{{- if and (eq $lsp.install_via "mise") (not $lsp.mason_ensure_installed) }}
{{ template "mise/tool-entry.tmpl" $lsp }}
{{- end }}
{{- end }}

# Formatters managed via mise (not Mason)
{{- range $formatter := .formatters }}
{{- if and (eq $formatter.install_via "mise") (not $formatter.mason_ensure_installed) }}
{{ template "mise/tool-entry.tmpl" $formatter }}
{{- end }}
{{- end }}

# Linters managed via mise (not Mason)
{{- range $linter := .linters }}
{{- if and (eq $linter.install_via "mise") (not $linter.mason_ensure_installed) }}
{{ template "mise/tool-entry.tmpl" $linter }}
{{- end }}
{{- end }}

# AI agents managed via mise
{{- range $agent := .agents }}
{{- if eq $agent.install_via "mise" }}
{{ template "mise/tool-entry.tmpl" $agent }}
{{- end }}
{{- end }}

# MCP servers managed via mise
{{- range $mcp := .mcp_servers }}
{{- if eq $mcp.install_via "mise" }}
{{ template "mise/tool-entry.tmpl" $mcp }}
{{- end }}
{{- end }}

[settings]
{{ if env "CODESPACES" | not | not -}}
jobs                                = 2                     # limit parallel jobs in Codespaces
{{ else -}}
jobs                                = 10                    # number of plugins or runtimes to install in parallel
{{ end -}}
always_keep_download                = false         # deleted after install by default
http_timeout                        = "30s"         # set the timeout for http requests as duration string
python.uv_venv_auto                 = true          # automatically create virtual environments with uv
trusted_config_paths                = ['~/.config']  # trusted paths for config files
env_file                            = '.env'        # environment file to load
experimental                        = true          # enable experimental features
verbose                             = false         # set to true to see full installation output
raw                                 = false         # set to true to directly pipe plugins to stdin/stdout/stderr
yes                                 = true          # automatically answer yes to all prompts
cargo.binstall                      = true          # use cargo-binstall for faster installations when available
idiomatic_version_file_enable_tools = ["ruby", "node"]
