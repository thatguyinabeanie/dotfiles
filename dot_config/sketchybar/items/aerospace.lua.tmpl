local colors = require("colors")

-- App icon mapping (simplified version matching icon_map.sh)
local app_icons = {
	["Finder"] = "󰀶",
	["Safari"] = "",
	["Firefox"] = "󰈹",
	["Chrome"] = "",
	["Google Chrome"] = "",
	["Terminal"] = "",
	["Code"] = "󰨞",
	["Visual Studio Code"] = "󰨞",
	["Xcode"] = "",
	["Spotify"] = "",
	["Discord"] = "󰙯",
	["Slack"] = "󰒱",
	["Notion"] = "󰈦",
	["Notes"] = "󰠮",
	["Mail"] = "󰇮",
	["Calendar"] = "󰃭",
	["System Preferences"] = "",
	["System Settings"] = "",
	["Activity Monitor"] = "󰄨",
	["Default"] = "󰀏",
}

-- Add event listener for AeroSpace workspace changes
sbar.add("event", "aerospace_workspace_change")

-- Create observer item for AeroSpace events
local aerospace_observer = sbar.add("item", {
	drawing = false,
	updates = true,
})

-- Subscribe to AeroSpace workspace change events
aerospace_observer:subscribe("aerospace_workspace_change", function(env)
	local focused_workspace = env.FOCUSED_WORKSPACE
	local prev_workspace = env.PREV_WORKSPACE

	-- Update the highlighted workspace
	if prev_workspace then
		sbar.set("space." .. prev_workspace, { icon = { highlight = false }, label = { highlight = false } })
	end

	if focused_workspace then
		sbar.set("space." .. focused_workspace, { icon = { highlight = true }, label = { highlight = true } })
	end

	-- Update app icons for all workspaces
	sbar.exec("aerospace list-workspaces --monitor focused --format '%{workspace}'", function(workspaces_output)
		local workspaces = {}
		for workspace in workspaces_output:gmatch("[^\r\n]+") do
			table.insert(workspaces, workspace)
		end

		for _, workspace in ipairs(workspaces) do
			sbar.exec(
				"aerospace list-windows --workspace " .. workspace .. " --format '%{app-name}'",
				function(apps_output)
					local icon_strip = " "
					local apps = {}
					for app in apps_output:gmatch("[^\r\n]+") do
						if app ~= "" then
							table.insert(apps, app)
						end
					end

					-- Get app icons
					for _, app in ipairs(apps) do
						local app_icon = app_icons[app] or app_icons["Default"]
						icon_strip = icon_strip .. " " .. app_icon
					end

					if #apps == 0 then
						icon_strip = " —"
					end

					sbar.set("space." .. workspace, { label = { string = icon_strip, drawing = true } })
				end
			)
		end
	end)
end)
