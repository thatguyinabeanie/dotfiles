{{- if eq .WORK_ENVIRONMENT true }}
# 1Password Service Account Configuration (Work Environment)
# This file configures 1Password CLI to use service account authentication
# Service account provides limited, non-interactive access to specific vaults

# Note: OP_SERVICE_ACCOUNT_TOKEN should be set in ~/.config/nushell/env.local.nu
# Example: $env.OP_SERVICE_ACCOUNT_TOKEN = 'ops_your_token_here'
#
# The token is intentionally NOT managed by chezmoi to prevent accidental commits

# Verify service account token is available (non-blocking)
if ($env.OP_SERVICE_ACCOUNT_TOKEN? | is-empty) {
    # Check if token file exists (fallback)
    let token_file = ($env.HOME | path join ".config" "op" "service-account-token")

    if ($token_file | path exists) {
        $env.OP_SERVICE_ACCOUNT_TOKEN = (open $token_file | str trim)
    } else {
        # Only show warning once per session
        if ($env._OP_TOKEN_WARNING_SHOWN? | is-empty) {
            print $"(ansi yellow)⚠️  1Password service account token not configured(ansi reset)"
            print $"   See: ($env.HOME)/.local/share/chezmoi/.docs/human/ONEPASSWORD_SERVICE_ACCOUNT.md"
            $env._OP_TOKEN_WARNING_SHOWN = true
        }
    }
}

# Add op-helper to PATH
let op_helper_dir = ($env.HOME | path join ".local" "share" "chezmoi" ".scripts" "utilities")
if ($op_helper_dir | path exists) {
    $env.PATH = ($env.PATH | prepend $op_helper_dir)
}

# Aliases for convenience
alias op-status = op-helper status
alias op-get = op-helper get
alias op-validate = op-helper validate

{{- else if eq .PERSONAL_ENVIRONMENT true }}
# 1Password Desktop App Configuration (Personal Environment)
# Uses interactive authentication with 1Password Desktop App

# SSH Agent configuration is handled in ~/.ssh/config
# Socket: ~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock

# Add op-helper to PATH (useful for scripts)
let op_helper_dir = ($env.HOME | path join ".local" "share" "chezmoi" ".scripts" "utilities")
if ($op_helper_dir | path exists) {
    $env.PATH = ($env.PATH | prepend $op_helper_dir)
}

# Helper function for 1Password sign-in (wraps op CLI)
def op-signin [] {
    # Perform the standard sign-in
    let signin_output = (^op signin --raw)

    # Parse the session token from output
    if ($signin_output | is-not-empty) {
        # Set the session environment variable
        let session_var = (^env | lines | find OP_SESSION | first | split column "=" | get column1.0)
        if ($session_var | is-not-empty) {
            $env.$session_var = $signin_output
            print $"(ansi green)✓ 1Password session authenticated(ansi reset)"
        }
    }
}

{{- end }}
