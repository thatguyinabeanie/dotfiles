# Function to show system information with a random Pokémon image
# Combines pokeget (random Pokémon) with fastfetch (system info) for a fun display
# Usage: poke_system_info
# Requires: pokeget, fastfetch
def poke_system_info [] {
  pokeget random --hide-name | fastfetch --file-raw -
}

