##
## GIT COMMIT EMOJI SELECTOR
##

# Interactive emoji selector for semantic commit messages
# Uses fzf for interactive selection of commit type with emoji prefix
# Usage: git_emoji_commit "your commit message"
# Example: git_emoji_commit "add user authentication" -> "✨ feat: add user authentication"
# Requires: fzf for interactive selection
def git_emoji_commit [msg: string] {
  # Define semantic commit types with corresponding emojis
  let emojis = [
    { emoji: "✨", desc: "feat: A new feature" }
    { emoji: "🐛", desc: "fix: A bug fix" }
    { emoji: "📝", desc: "docs: Documentation only changes" }
    { emoji: "🎨", desc: "style: Code style changes" }
    { emoji: "🔥", desc: "remove: Remove code or files" }
    { emoji: "🚀", desc: "perf: Performance improvements" }
    { emoji: "✅", desc: "test: Adding tests" }
    { emoji: "🔧", desc: "chore: Maintenance" }
    { emoji: "🔀", desc: "merge: Merge branches" }
    { emoji: "⬆️", desc: "upgrade: Dependency upgrades" }
  ]
  
  # Use fzf for interactive selection
  let choice = ($emojis | each {|e| $"($e.emoji) ($e.desc)" } | fzf --prompt="Select commit type: ")
  
  # Extract emoji (first token) and create commit
  if ($choice | is-empty) {
    print "No commit type selected. Aborting."
    return
  }
  
  let emoji = ($choice | split row " " | get 0)
  git commit -m $"($emoji) ($msg)"
}

