{{- template "utilities/generic-env.sh.tmpl" (dict "shell" "nushell" "data" .) -}}

{{- $nuDataDir := printf "%s/.local/share/nushell" .chezmoi.homeDir }}
{{- $vendorAutoloadDir := printf "%s/vendor/autoload" $nuDataDir }}

{{- if not (stat $nuDataDir) }}
mkdir $nu.data-dir
{{- end }}

{{- if not (stat $vendorAutoloadDir) }}
mkdir {{ $vendorAutoloadDir }}
{{- end }}

{{- $miseActivatePath := printf "%s/mise_activate.nu" $vendorAutoloadDir }}
{{- if not (stat $miseActivatePath) }}
mise activate nu | save -f {{ $miseActivatePath }}
{{- end }}

{{- $zoxidePath := printf "%s/zoxide.nu" $vendorAutoloadDir }}
{{- if not (stat $zoxidePath) }}
zoxide init nushell | save -f {{ $zoxidePath }}
{{- end }}

{{- $starshipPath := printf "%s/starship.nu" $vendorAutoloadDir }}
{{- if not (stat $starshipPath) }}
starship init nu | save -f {{ $starshipPath }}
{{- end }}

{{- $cargoEnvPath := printf "%s/.cargo/env.nu" .chezmoi.homeDir }}
{{- if not (stat $cargoEnvPath) }}
cp {{ $cargoEnvPath }} {{ $vendorAutoloadDir }}
{{- end }}

{{- $carapaceInitNuPath := printf "%s/.cache/carapace/init.nu" .chezmoi.homeDir }}
{{- if and (lookPath "carapace") (not (stat $carapaceInitNuPath)) }}
$env.CARAPACE_BRIDGES = 'zsh,fish,bash,inshellisense'
carapace _carapace nushell | save -f {{ .chezmoi.homeDir }}/.cache/carapace/init.nu
{{- end }}

