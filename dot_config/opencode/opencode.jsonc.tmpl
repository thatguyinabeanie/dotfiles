{{- $opencode := (include ".chezmoidata/ai/ai-opencode.yaml" | fromYaml).ai_opencode }}
{{- $github_copilot := (include ".chezmoidata/ai/ai-github-copilot.yaml" | fromYaml).ai_github_copilot }}
{{- $anthropic := (include ".chezmoidata/ai/ai-anthropic.yaml" | fromYaml).ai_anthropic }}
{{- $google := (include ".chezmoidata/ai/ai-google.yaml" | fromYaml).ai_google }}
{{- $openrouter := (include ".chezmoidata/ai/ai-openrouter.yaml" | fromYaml).ai_openrouter }}
{
  "$schema": "https://opencode.ai/config.json",

  "model": "{{ $opencode.provider }}/{{ $opencode.model }}",
  "small_model": "{{ $opencode.provider }}/{{ $opencode.small_model }}",

  // Auto-sharing for collaboration
  "share": "{{ $opencode.share }}",
  "autoupdate": {{ $opencode.autoupdate }},
  "provider": {
    "github-copilot": {
      "models": {
{{- $modelCount := 0 }}
{{- range $modelName, $modelConfig := $github_copilot.models }}
{{- if gt $modelCount 0 }},{{ end }}
        "{{ $modelName }}": {
          "limit": {
            "context": {{ $modelConfig.limit.context }},
            "output": {{ $modelConfig.limit.output }}
          }
        }
{{- $modelCount = add $modelCount 1 }}
{{- end }}
      }
    },
    "anthropic": {
      "models": {
{{- $modelCount := 0 }}
{{- range $anthropic.Anthropic }}
{{- if gt $modelCount 0 }},{{ end }}
        "{{ .name }}": {
          "limit": {
            "context": {{ .limit.context }},
            "output": {{ .limit.output }}
          }
        }
{{- $modelCount = add $modelCount 1 }}
{{- end }}
      }
    },
    "google": {
      "models": {
{{- $modelCount := 0 }}
{{- range $google.Google }}
{{- if gt $modelCount 0 }},{{ end }}
        "{{ .name }}": {
          "limit": {
            "context": {{ .limit.context }},
            "output": {{ .limit.output }}
          }
        }
{{- $modelCount = add $modelCount 1 }}
{{- end }}
      }
    },
    "openrouter": {
      "models": {
{{- $modelCount := 0 }}
{{- range $openrouter.OpenRouter }}
{{- if gt $modelCount 0 }},{{ end }}
        "{{ .name }}": {
          "limit": {
            "context": {{ .limit.context }},
            "output": {{ .limit.output }}
          }
        }
{{- $modelCount = add $modelCount 1 }}
{{- end }}
      }
    }
  }
}
