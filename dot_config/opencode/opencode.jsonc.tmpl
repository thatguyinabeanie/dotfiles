{{- $opencode := (include ".chezmoidata/opencode.yaml" | fromYaml).ai_opencode }}
{
  "$schema": "https://opencode.ai/config.json",

  "model": "{{ $opencode.provider }}/{{ $opencode.model }}",
  "small_model": "{{ $opencode.provider }}/{{ $opencode.small_model }}",

  // Auto-sharing for collaboration
  "share": "{{ $opencode.share }}",
  "autoupdate": {{ $opencode.autoupdate }},

  // Simplified provider configuration using consolidated data
  "provider": {
{{- range $providerName, $providerConfig := $opencode.provider_configs }}
    "{{ $providerName }}": {
      "enabled": {{ $providerConfig.enabled }},
      "model": "{{ $providerConfig.model }}",
      "temperature": {{ $providerConfig.temperature }},
      "max_tokens": {{ $providerConfig.max_tokens }}
{{- if hasKey $providerConfig "api_version" }},
      "api_version": "{{ $providerConfig.api_version }}"
{{- end }}
{{- if hasKey $providerConfig "safety_settings" }},
      "safety_settings": {
{{- range $key, $value := $providerConfig.safety_settings }}
        "{{ $key }}": "{{ $value }}"{{ if ne $key (keys $providerConfig.safety_settings | last) }},{{ end }}
{{- end }}
      }
{{- end }}
{{- if hasKey $providerConfig "site_url" }},
      "site_url": "{{ $providerConfig.site_url }}"
{{- end }}
    }{{ if ne $providerName (keys $opencode.provider_configs | last) }},{{ end }}
{{- end }}
}
