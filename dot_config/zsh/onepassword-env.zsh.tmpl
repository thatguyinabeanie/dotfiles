# Common 1Password setup for all environments
# Add op-helper to PATH
_OP_HELPER_DIR="$HOME/.local/share/chezmoi/.scripts/utilities"
if [[ -d "$_OP_HELPER_DIR" ]] && [[ ! "$PATH" == *"$_OP_HELPER_DIR"* ]]; then
    export PATH="$_OP_HELPER_DIR:$PATH"
fi

{{- if eq .WORK_ENVIRONMENT true }}
# 1Password Service Account Configuration (Work Environment)
# This configuration uses service account authentication for non-interactive access

# Note: OP_SERVICE_ACCOUNT_TOKEN should be set in ~/.zshenv or ~/.zshrc.local
# Example: export OP_SERVICE_ACCOUNT_TOKEN='ops_your_token_here'
# The token is intentionally NOT managed by chezmoi to prevent accidental commits

# Verify service account token is available (non-blocking)
if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    # Check if token file exists (fallback)
    _OP_TOKEN_FILE="$HOME/.config/op/service-account-token"
    if [[ -f "$_OP_TOKEN_FILE" ]]; then
        export OP_SERVICE_ACCOUNT_TOKEN=$(cat "$_OP_TOKEN_FILE")
    else
        # Only show warning once per session
        if [[ -z "${_OP_TOKEN_WARNING_SHOWN:-}" ]]; then
            echo "⚠️  1Password service account token not configured" >&2
            echo "   See: ~/.local/share/chezmoi/.docs/human/ONEPASSWORD_SERVICE_ACCOUNT.md" >&2
            export _OP_TOKEN_WARNING_SHOWN=1
        fi
    fi
fi

# Aliases for convenience
alias op-status='op-helper status'
alias op-get='op-helper get'
alias op-validate='op-helper validate'
alias op-rotate='op-helper rotate-token'

# Check token age and warn if approaching expiry
if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    _op_check_token_age() {
        local token_date=$(defaults read com.chezmoi.config op_token_created_date 2>/dev/null || echo "")
        if [[ -n "$token_date" ]]; then
            local current_date=$(date +%s)
            local token_age=$(( (current_date - token_date) / 86400 ))  # Days
            local warning_threshold=85

            if [[ $token_age -ge $warning_threshold ]]; then
                # Only show warning once per day
                local last_warning=$(defaults read com.chezmoi.config op_token_last_warning 2>/dev/null || echo "0")
                local days_since_warning=$(( (current_date - last_warning) / 86400 ))

                if [[ $days_since_warning -ge 1 ]]; then
                    echo "⚠️  1Password service account token is $token_age days old" >&2
                    echo "   Consider rotating soon (recommended: every 90 days)" >&2
                    echo "   Run: op-rotate" >&2
                    defaults write com.chezmoi.config op_token_last_warning -int $current_date
                fi
            fi
        fi
    }
    _op_check_token_age
fi

{{- else if eq .PERSONAL_ENVIRONMENT true }}
# 1Password Desktop App Configuration (Personal Environment)
# Uses interactive authentication with 1Password Desktop App
# SSH Agent configuration is handled in ~/.ssh/config
# Socket: ~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock

# op-signin function is defined in aliases.zsh
# Usage: op-signin  # Signs in and propagates session to tmux

{{- end }}

# Load secrets from 1Password (applies to all environments)
{{- template "onepassword/load-secrets.sh.tmpl" . }}
