# Function to sign in to 1Password and update the tmux environment
op-signin() {
  # 1. Perform the standard sign-in and get the session token
  eval $(op signin)

  # 2. Check if we are inside a tmux session
  if [ -n "$TMUX" ]; then
    # 3. Extract the session variable name and value
    #    (e.g., OP_SESSION_my_account and its token)
    op_session_var=$(env | grep OP_SESSION)

    if [ -n "$op_session_var" ]; then
      # 4. Tell tmux to set this variable for all future panes/windows
      tmux set-environment -g "$op_session_var"
      echo "1Password session token exported to tmux environment."
    fi
  fi
}

# Kill process(es) using specified port(s)
# Usage: killport 3000
#        killport 3000 8080 9000
# Tries graceful shutdown (SIGTERM) first, then force kill (SIGKILL) after 2 seconds
killport() {
  if [ $# -eq 0 ]; then
    echo "❌ Usage: killport <port> [port2] [port3] ..."
    return 1
  fi
  
  for port in "$@"; do
    echo "🔍 Checking port $port..."
    
    local pids=$(lsof -ti:$port 2>/dev/null)
    
    if [ -z "$pids" ]; then
      echo "   ℹ️  No process on port $port"
      continue
    fi
    
    # Get process names for feedback
    local process_info=$(echo "$pids" | xargs ps -p 2>/dev/null | tail -n +2 | awk '{print $1 " (" $4 ")"}' | tr '\n' ',' | sed 's/,$//')
    
    # Try graceful shutdown first
    echo "   🎯 Killing: $process_info"
    echo "$pids" | xargs kill -15 2>/dev/null
    
    # Wait briefly then force kill if still running
    sleep 2
    local remaining=$(lsof -ti:$port 2>/dev/null)
    if [ -n "$remaining" ]; then
      echo "   💥 Force killing remaining process(es)..."
      echo "$remaining" | xargs kill -9 2>/dev/null
    fi
    
    echo "   ✅ Port $port freed"
  done
}


# Ensure the repo's committed .gitignore excludes the worktrees dir (idempotent)
_gwt_ensure_gitignore() {
  local repo_root="$1" subdir="$2"
  local gi="$repo_root/.gitignore"
  local entry="${subdir}/"

  [ -f "$gi" ] || : > "$gi"

  if grep -qxF "$entry" "$gi" 2>/dev/null; then
    return 0
  fi

  printf '%s\n' "$entry" >> "$gi"
  echo "📝 Added '$entry' to .gitignore"
}

# Create a git worktree, mirroring `git worktree add`'s flags, under .claude/worktrees
# (if .claude/ exists at the repo root) or .worktrees/ otherwise. Auto-runs mise trust
# if mise.toml is present, auto-symlinks .env* files, and cd's into the new worktree.
# Usage: gwta [git-worktree-add flags] <path> [<commit-ish>]
gwta() {
  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -z "$repo_root" ]; then
    echo "❌ Not inside a git repository"
    return 1
  fi

  local -a passthrough newbranch resetbranch
  zparseopts -D -E -a passthrough -- \
    f -force -no-force \
    d -detach -no-detach \
    -checkout -no-checkout \
    -orphan -no-orphan \
    -lock -no-lock \
    -reason: \
    q -quiet -no-quiet \
    -track -no-track \
    -guess-remote -no-guess-remote \
    -relative-paths -no-relative-paths \
    b:=newbranch \
    B:=resetbranch \
    || { echo "❌ Failed to parse options"; return 1; }

  if [ -n "$newbranch" ] && [ -n "$resetbranch" ]; then
    echo "❌ Cannot combine -b and -B"
    return 1
  fi

  if [ $# -lt 1 ]; then
    echo "❌ Usage: gwta [flags] <path> [<commit-ish>]"
    return 1
  fi
  local wt_path="$1"
  local commit_ish="$2"

  local worktrees_subdir=".worktrees"
  [ -d "$repo_root/.claude" ] && worktrees_subdir=".claude/worktrees"
  local full_path="$repo_root/$worktrees_subdir/$wt_path"

  _gwt_ensure_gitignore "$repo_root" "$worktrees_subdir"

  echo "🌲 Adding worktree at $full_path..."
  git worktree add "${passthrough[@]}" "${newbranch[@]}" "${resetbranch[@]}" \
    "$full_path" ${commit_ish:+"$commit_ish"} || return $?

  # If a mise.toml is present at the repo root, run `mise trust` in the worktree
  if [ -f "$repo_root/mise.toml" ]; then
    if command -v mise >/dev/null 2>&1; then
      echo "🔒 Running mise trust..."
      mise trust "$full_path" || echo "⚠️ mise trust failed"
    else
      echo "⚠️ 'mise' not found in PATH; cannot run mise trust"
    fi
  fi

  # Symlink any .env* files from the repo root into the new worktree (if they exist)
  for env in "$repo_root"/.env*(N); do
    [ -e "$env" ] || continue
    local fname
    fname=$(basename "$env")
    local dest="$full_path/$fname"

    if [ -L "$dest" ]; then
      local target
      target=$(readlink "$dest")
      if [ "$target" = "$env" ]; then
        echo "🔗 Symlink already exists: $dest -> $env"
        continue
      else
        echo "⚠️ $dest exists as symlink to $target; skipping"
        continue
      fi
    elif [ -e "$dest" ]; then
      echo "⚠️ $dest already exists and is not a symlink; skipping"
      continue
    else
      ln -s "$env" "$dest" && echo "🔗 Created symlink: $dest -> $env" || echo "❌ Failed to create symlink $dest"
    fi
  done

  cd "$full_path" || return $?
}

