{{- if eq .chezmoi.os "darwin" -}}
{{- $brew_prefix := "/opt/homebrew" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{- $brew_prefix = "/usr/local" -}}
{{- end -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE typemap [
  <!ELEMENT typemap (type+)>
  <!ELEMENT type (#PCDATA)>
  <!ATTLIST type
    name CDATA #REQUIRED
    fullname CDATA #IMPLIED
    family CDATA #IMPLIED
    foundry CDATA #IMPLIED
    weight CDATA #IMPLIED
    style CDATA #IMPLIED
    stretch CDATA #IMPLIED
    format CDATA #IMPLIED
    metrics CDATA #IMPLIED
    glyphs CDATA #REQUIRED
    size CDATA #IMPLIED
    version CDATA #IMPLIED
    encoding CDATA #IMPLIED
    antialias CDATA #IMPLIED
  >
]>
<typemap>
  <!-- Helvetica / Nimbus Sans -->
  <type
    name="Helvetica"
    fullname="Nimbus Sans Regular"
    family="Helvetica"
    foundry="URW"
    weight="400"
    style="Normal"
    stretch="Normal"
    format="Type1"
    metrics="{{ $brew_prefix }}/share/ghostscript/fonts/n019003l.afm"
    glyphs="{{ $brew_prefix }}/share/ghostscript/fonts/n019003l.pfb"
  />
  <type
    name="Helvetica-Bold"
    fullname="Nimbus Sans Bold"
    family="Helvetica"
    foundry="URW"
    weight="700"
    style="Normal"
    stretch="Normal"
    format="Type1"
    metrics="{{ $brew_prefix }}/share/ghostscript/fonts/n019004l.afm"
    glyphs="{{ $brew_prefix }}/share/ghostscript/fonts/n019004l.pfb"
  />
  <type
    name="Helvetica-Oblique"
