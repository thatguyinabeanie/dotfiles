-- Auto-generated language tooling configuration
-- Sources: .chezmoidata/packages/cross-platform-tools.yaml and .chezmoidata/development/neovim-treesitter.yaml
-- Generated: {{ now }}
{{- $tools := (include ".chezmoidata/packages/cross-platform-tools.yaml" | fromYaml) }}
{{- $treesitter := (include ".chezmoidata/development/neovim-treesitter.yaml" | fromYaml) }}

return {
  treesitter = {
    parsers = {
{{- range $treesitter.neovim_treesitter.parsers }}
      "{{ . }}",
{{- end }}
    },
  },

  mason = {
    core_tools = {
{{- range $tools.cross_platform_tools.language_servers.core_tools }}
      "{{ .name }}",
{{- end }}
    },
    exploration_tools = {
{{- range $tools.cross_platform_tools.language_servers.exploration_tools }}
      "{{ .name }}",
{{- end }}
    },
    cli_tools = {
{{- range $tools.cross_platform_tools.language_servers.cli_tools }}
      "{{ .name }}",
{{- end }}
    },
  },

  filetypes = {
    templates = {
{{- range $lang, $templates := $treesitter.neovim_treesitter.filetypes.templates }}
  {{- if kindIs "slice" $templates }}
      {{ $lang }} = { {{- range $templates }}"{{ . }}", {{- end }} },
  {{- else }}
      {{ $lang }} = "{{ $templates }}",
  {{- end }}
{{- end }}
    },

    lsp_servers = {
{{- range $filetype, $server := $treesitter.neovim_treesitter.filetypes.lsp_servers }}
      {{ $filetype }} = "{{ $server }}",
{{- end }}
    },

    web_frameworks = {
{{- range $treesitter.neovim_treesitter.filetypes.web_frameworks }}
      "{{ . }}",
{{- end }}
    },

    typescript_stack = {
{{- range $treesitter.neovim_treesitter.filetypes.typescript_stack }}
      "{{ . }}",
{{- end }}
    },
  },
}
