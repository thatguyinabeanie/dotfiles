{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4",
  "small_model": "github-copilot/grok-code-fast-1",
  "autoupdate": false,
  "share": "manual",
  "theme": "system",

  "instructions": [
    "AGENTS.md",
  ],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-1db3caba-c719-444d-8a35-07ce703f86e8"
      },
      "enabled": true
    }
  },
  "formatter": {
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    },
    "stylua": {
      "command": ["stylua", "$FILE"],
      "extensions": [".lua"]
    },
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".yaml", ".yml", ".md", ".json"]
    }
  },

  "lsp": {
    "lua_ls": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "gopls": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "yamlls": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "jsonls": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "marksman": {
      "command": ["marksman", "server"],
      "extensions": [".md"]
    },
    "bashls": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".zsh"]
    },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    },
    "nushell": {
      "command": ["nu", "--lsp"],
      "extensions": [".nu"]
    }
  }
}
