{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4",
  "small_model": "github-copilot/grok-code-fast-1",
  "autoupdate": false,
  "share": "manual",
  "theme": "system",

  "instructions": [
    "AGENTS.md",
  ],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-1db3caba-c719-444d-8a35-07ce703f86e8"
      },
      "enabled": true
    }
  },
  "formatters": {
    "go": "go fmt $FILE",
    "lua": "stylua $FILE",
    "shell": "shellcheck $FILE",
    "yaml": "prettier --parser yaml --write $FILE",
    "markdown": "prettier --parser markdown --write $FILE"
  }
}
