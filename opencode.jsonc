{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4",
  "small_model": "opencode/code-supernova",
  "autoupdate": false,
  "share": "auto",
  "theme": "system",
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask"
    }
  },
  "lsp": {
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": ["sh", "zsh"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": ["lua"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": ["json", "jsonc"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": ["yaml", "yml"]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "extensions": ["md"]
    }
  },
  "formatter": {
    "shfmt": {
      "command": ["shfmt", "-i", "2", "-bn", "-ci", "-sr"],
      "extensions": ["sh", "zsh"]
    },
    "prettierd": {
      "command": ["prettierd", "{file}"],
      "extensions": ["json", "jsonc", "yaml", "yml", "md", "tmpl"]
    },
    "taplo": {
      "command": ["taplo", "format", "-"],
      "extensions": ["toml"]
    }
  }
}
