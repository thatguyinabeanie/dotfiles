{
  "context": {
    "fileName": "AGENTS.md"
  },
  "general": {
    "preferredEditor": "nvim"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "GitHub"
  },
  "mcpServers": {
{{- if .env_personal.api_keys.context7_api_key }}
    "context7": {
      "httpUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ .env_personal.api_keys.context7_api_key }}",
        "Accept": "application/json, text/event-stream"
      },
      "trust": true
    },
{{- end }}
     "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp@latest",
        "--browser", "chrome",
        "--headless",
        "--isolated", "--save-trace"
      ],
      "timeout": 30000,
      "trust": true
    },

    "convex": {
      "command": "bunx",
      "args": [
        "convex@latest",
        "mcp",
        "start"
      ]
    }
  }
}