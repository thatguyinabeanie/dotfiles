#!/bin/bash
# Clone and set up open-clawsidian (second brain CLI tool)
# Hash: open-clawsidian-setup-v1

set -euo pipefail

REPO_DIR="${HOME}/source/open-clawsidian"
REPO_URL="https://github.com/thatguyinabeanie/open-clawsidian.git"

# Clone the tool repo if it doesn't exist
if [ ! -d "${REPO_DIR}" ]; then
  echo "Cloning open-clawsidian..."
  mkdir -p "$(dirname "${REPO_DIR}")"
  git clone "${REPO_URL}" "${REPO_DIR}"
else
  echo "open-clawsidian already cloned at ${REPO_DIR}"
fi

# Install dependencies and link the CLI
if command -v bun &>/dev/null; then
  echo "Installing open-clawsidian dependencies..."
  cd "${REPO_DIR}"
  bun install
  bun link
  bun run install-capture
  echo "open-clawsidian CLI linked and capture script installed"
else
  echo "Warning: bun not found — skipping open-clawsidian setup (install bun first)"
fi
