#!/bin/bash

{{- $gh_extensions := (include ".chezmoidata/packages/gh-extensions.yaml" | fromYaml) }}

# This script runs when gh extensions change and applies package installations
# run_onchange: {{ $gh_extensions | toJson | sha256sum }}

set -euo pipefail

#=============================================================================
# GH EXTENSION INSTALLATION
#=============================================================================

if command -v gh >/dev/null 2>&1; then
  gh config set git_protocol https
  echo "🔧 Installing and upgrading gh extensions..."
  {{- range $gh_extensions.extensions }}
  if ! gh extension list | grep -q "{{ . }}"; then
    echo "Installing gh extension: {{ . }}..."
    gh extension install "https://github.com/{{ . }}"
  else
    echo "Upgrading gh extension: {{ . }}..."
    gh extension upgrade "{{ . }}"
  fi
  {{- end }}
  echo "✅ gh extensions installed and upgraded"
fi
