#!/bin/bash

{{- $gh_extensions := (include ".chezmoidata/github-extensions.yaml" | fromYaml) }}

# This script runs when gh extensions change and applies package installations
# run_onchange: {{ $gh_extensions | toJson | sha256sum }}

set -euo pipefail

#=============================================================================
# GH EXTENSION INSTALLATION
#=============================================================================

# Only install GitHub extensions if explicitly enabled
if [[ "{{ .INSTALL_GH_EXTENSIONS }}" != "true" ]]; then
  exit 0
fi
if command -v gh >/dev/null 2>&1; then
  gh config set git_protocol https
  echo "🔧 Installing GitHub CLI extensions..."
  {{- range $gh_extensions.github_extensions }}
  echo "  Installing {{ .name }}"
  if ! gh extension list | grep -q "{{ .name }}"; then
    gh extension install "{{ .name }}"
    echo "  ✅ {{ .name }} installed"
  else
    echo "  ✅ {{ .name }} already installed"
  fi
  {{- end }}
  echo "✅ GitHub CLI extensions installation completed"
else
  echo "⚠️ GitHub CLI not found, skipping extensions installation"
fi