#!/bin/bash
# Install Cursor Agent CLI

set -euo pipefail

# Check if cursor-agent is already installed and up to date
CURSOR_VERSION="2025.08.27-24c29c1"
CURSOR_AGENT_PATH="$HOME/.local/bin/cursor-agent"
CURSOR_INSTALL_DIR="$HOME/.local/share/cursor-agent/versions/$CURSOR_VERSION"

if [ -x "$CURSOR_AGENT_PATH" ] && [ -d "$CURSOR_INSTALL_DIR" ]; then
    echo "🟢 Cursor Agent CLI ($CURSOR_VERSION) is already installed"
    exit 0
fi

echo "🚀 Installing Cursor Agent CLI..."

# Detect OS and Architecture
OS="$(uname -s)"
case "${OS}" in
    Linux*)     OS="linux";;
    Darwin*)    OS="darwin";;
    *)
        echo "❌ Unsupported operating system: ${OS}"
        exit 1
        ;;
esac

ARCH="$(uname -m)"
case "${ARCH}" in
    x86_64|amd64)  ARCH="x64";;
    arm64|aarch64) ARCH="arm64";;
    *)
        echo "❌ Unsupported architecture: ${ARCH}"
        exit 1
        ;;
esac

echo "🔍 Detected ${OS}/${ARCH}"

# Create installation directory
echo "📁 Creating installation directory..."
TEMP_EXTRACT_DIR="$HOME/.local/share/cursor-agent/versions/.tmp-$CURSOR_VERSION-$(date +%s)"
mkdir -p "${TEMP_EXTRACT_DIR}"

# Cleanup function
cleanup() {
    rm -rf "${TEMP_EXTRACT_DIR}"
}
trap cleanup EXIT

# Download and extract
echo "⬇️  Downloading Cursor Agent package..."
DOWNLOAD_URL="https://downloads.cursor.com/lab/$CURSOR_VERSION/${OS}/${ARCH}/agent-cli-package.tar.gz"

if curl -fSL "${DOWNLOAD_URL}" | tar --strip-components=1 -xzf - -C "${TEMP_EXTRACT_DIR}"; then
    echo "✅ Package downloaded and extracted"
else
    echo "❌ Download failed. Please check your internet connection and try again."
    echo "❌ If the problem persists, the package might not be available for ${OS}/${ARCH}."
    exit 1
fi

# Atomically move from temp to final destination
echo "📦 Finalizing installation..."
rm -rf "${CURSOR_INSTALL_DIR}"
if mv "${TEMP_EXTRACT_DIR}" "${CURSOR_INSTALL_DIR}"; then
    echo "✅ Package installed successfully"
else
    echo "❌ Failed to install package. Please check permissions."
    exit 1
fi

# Create bin directory and symlink
echo "🔗 Creating symlink..."
mkdir -p ~/.local/bin
rm -f ~/.local/bin/cursor-agent
ln -s "${CURSOR_INSTALL_DIR}/cursor-agent" ~/.local/bin/cursor-agent

echo "✅ Cursor Agent CLI installation complete!"
echo "🔧 Make sure ~/.local/bin is in your PATH to use 'cursor-agent' command"
