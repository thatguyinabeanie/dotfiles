#!/bin/bash
# Claude Code Installation via official script
# https://docs.anthropic.com/en/docs/claude-code/getting-started

set -euo pipefail

{{ template "utilities/logging.sh.tmpl" }}

log_section "Installing Claude Code"

if command -v claude >/dev/null 2>&1; then
    log_detail "Claude Code already installed"
    log_summary "Claude Code already present"
else
    log_detail "Installing Claude Code via official script..."
    tmp_install_script="$(mktemp)"
    curl -fsSL https://claude.ai/install.sh -o "$tmp_install_script"
    if [ "${CLAUDE_INSTALL_SHA256-}" != "" ]; then
        log_detail "Verifying Claude Code installer checksum..."
        echo "${CLAUDE_INSTALL_SHA256}  ${tmp_install_script}" | sha256sum -c -
        log_detail "Checksum verification succeeded"
    else
        log_detail "WARNING: CLAUDE_INSTALL_SHA256 not set; skipping installer checksum verification"
    fi
    bash "$tmp_install_script"
    rm -f "$tmp_install_script"
    log_summary "Claude Code installation complete"
fi
