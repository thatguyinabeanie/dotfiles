#!/bin/bash

set -euo pipefail

# Import GPG key for make verification
# Key: Paul D. Smith <paul@mad-scientist.net> (make maintainer)
# Used to verify signatures of downloaded make packages
echo "🔑 Importing GPG key for make verification..."

# First, check if key is already present
if gpg --list-keys B2508A90102F8AE3B12A0090DEACCAAEDB78137A >/dev/null 2>&1; then
    echo "✅ GPG key already present"
# Try to import from primary keyserver
elif gpg --keyserver keyserver.ubuntu.com --recv-keys B2508A90102F8AE3B12A0090DEACCAAEDB78137A 2>/dev/null; then
    echo "✅ GPG key imported successfully"
# Try alternative keyserver
elif gpg --keyserver keys.openpgp.org --recv-keys B2508A90102F8AE3B12A0090DEACCAAEDB78137A 2>/dev/null; then
    echo "✅ GPG key imported from alternative keyserver"
else
    echo "⚠️  Failed to import GPG key. Package signature verification may fail."
    echo "   You can manually import later with:"
    echo "   gpg --keyserver keyserver.ubuntu.com --recv-keys B2508A90102F8AE3B12A0090DEACCAAEDB78137A"
fi

# Detect the best storage method for the current platform
detect_storage_method() {
  local os_type="$(/usr/bin/uname -s)"
  
  case "${os_type}" in
    Darwin*)
      echo "macos_defaults"
      ;;
    Linux*)
      # Check for available storage methods in order of preference
      if command -v dconf >/dev/null 2>&1; then
        echo "dconf"
      elif command -v gsettings >/dev/null 2>&1; then
        echo "gsettings"
      else
        echo "xdg_config"
      fi
      ;;
    *)
      echo "xdg_config"  # Fallback to XDG for other Unix-like systems
      ;;
  esac
}

# Read a machine identity value
read_machine_identity() {
  local key="$1"
  local storage_method="${2:-$(detect_storage_method)}"
  
  case "${storage_method}" in
    macos_defaults)
      defaults read com.chezmoi.machine "${key}" 2>/dev/null || echo ""
      ;;
    dconf)
      local dconf_key="/com/chezmoi/machine/${key//_/-}"
      dconf read "${dconf_key}" 2>/dev/null | sed 's/^.\(.*\).$/\1/' || echo ""
      ;;
    gsettings)
      gsettings get com.chezmoi.machine "${key//_/-}" 2>/dev/null | sed 's/^.\(.*\).$/\1/' || echo ""
      ;;
    xdg_config)
      local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/machine-identity"
      if [[ -f "${config_file}" ]]; then
        grep "^${key}=" "${config_file}" 2>/dev/null | cut -d'=' -f2- | sed 's/^"\(.*\)"$/\1/' || echo ""
      else
        echo ""
      fi
      ;;
  esac
}

# Write a machine identity value
write_machine_identity() {
  local key="$1"
  local value="$2"
  local storage_method="${3:-$(detect_storage_method)}"
  
  case "${storage_method}" in
    macos_defaults)
      case "${key}" in
        work_environment|personal_environment)
          defaults write com.chezmoi.machine "${key}" -bool "${value}"
          ;;
        *)
          defaults write com.chezmoi.machine "${key}" -string "${value}"
          ;;
      esac
      ;;
    dconf)
      local dconf_key="/com/chezmoi/machine/${key//_/-}"
      case "${key}" in
        work_environment|personal_environment)
          dconf write "${dconf_key}" "${value,,}"
          ;;
        *)
          dconf write "${dconf_key}" "'${value}'"
          ;;
      esac
      ;;
    gsettings)
      local gsettings_key="${key//_/-}"
      case "${key}" in
        work_environment|personal_environment)
          gsettings set com.chezmoi.machine "${gsettings_key}" "${value,,}"
          ;;
        *)
          gsettings set com.chezmoi.machine "${gsettings_key}" "${value}"
          ;;
      esac
      ;;
    xdg_config)
      local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/machine-identity"
      local config_dir="$(dirname "${config_file}")"
      
      mkdir -p "${config_dir}"
      
      if [[ -f "${config_file}" ]]; then
        if grep -q "^${key}=" "${config_file}"; then
          sed -i.bak "s|^${key}=.*|${key}=\"${value}\"|" "${config_file}"
          rm -f "${config_file}.bak"
        else
          echo "${key}=\"${value}\"" >> "${config_file}"
        fi
      else
        cat > "${config_file}" << EOF
# Machine identity configuration
# Generated by chezmoi machine identity system
${key}="${value}"
EOF
      fi
      ;;
  esac
}

# Check if machine identity is configured or needs updating
is_machine_identity_configured() {
  local storage_method="${1:-$(detect_storage_method)}"
  local work_env="$(read_machine_identity "work_environment" "${storage_method}")"
  local personal_env="$(read_machine_identity "personal_environment" "${storage_method}")"
  
  # Check if basic identity exists
  if [[ -z "${work_env}" ]]; then
    return 1  # Not configured
  fi
  
  # Check if current chezmoi data matches stored data (for updates)
  local chezmoi_work="{{ if hasKey . "WORK_ENVIRONMENT" }}{{ .WORK_ENVIRONMENT | default "false" }}{{ else }}false{{ end }}"
  local chezmoi_personal="{{ if hasKey . "PERSONAL_ENVIRONMENT" }}{{ .PERSONAL_ENVIRONMENT | default "false" }}{{ else }}{{ if hasKey . "WORK_ENVIRONMENT" }}{{ not .WORK_ENVIRONMENT }}{{ else }}false{{ end }}{{ end }}"
  
  # Normalize values for comparison
  normalize_boolean() {
    local value="$1"
    case "$value" in
      "1"|"true"|"True"|"TRUE") echo "true" ;;
      "0"|"false"|"False"|"FALSE"|"") echo "false" ;;
      *) echo "$value" ;;
    esac
  }
  
  local norm_stored_work="$(normalize_boolean "${work_env}")"
  local norm_stored_personal="$(normalize_boolean "${personal_env}")"
  local norm_chezmoi_work="$(normalize_boolean "${chezmoi_work}")"
  local norm_chezmoi_personal="$(normalize_boolean "${chezmoi_personal}")"
  
  # Return success (0) if values match, failure (1) if update needed
  [[ "${norm_stored_work}" == "${norm_chezmoi_work}" ]] && [[ "${norm_stored_personal}" == "${norm_chezmoi_personal}" ]]
}

echo "🔧 Setting up machine configuration"

# Set up machine identity if not already configured or needs updating
if ! is_machine_identity_configured; then
  # Determine if this is first time setup or an update
  STORAGE_METHOD="$(detect_storage_method)"
  STORED_WORK_ENV="$(read_machine_identity "work_environment" "${STORAGE_METHOD}")"
  
  if [[ -z "${STORED_WORK_ENV}" ]]; then
    echo "📝 Configuring machine identity (first time setup)"
    FIRST_TIME_SETUP=true
  else
    echo "🔄 Updating machine identity (environment changed)"
    FIRST_TIME_SETUP=false
  fi
  
  # Detect storage method
  echo "📦 Using storage method: ${STORAGE_METHOD}"
  
  # Read values from defaults first, fallback to chezmoi data
  WORK_ENV="$(read_machine_identity "work_environment" "${STORAGE_METHOD}")"
  PERSONAL_ENV="$(read_machine_identity "personal_environment" "${STORAGE_METHOD}")"
  WORK_ORG="$(read_machine_identity "work_org" "${STORAGE_METHOD}")"
  HOSTNAME_SETTING="$(read_machine_identity "hostname" "${STORAGE_METHOD}")"
  SHELL_PREF="$(read_machine_identity "shell" "${STORAGE_METHOD}")"
  CATPPUCCIN_PREF="$(read_machine_identity "catppuccin_flavor" "${STORAGE_METHOD}")"
  
  # If not in defaults, read from chezmoi data (from interactive prompts)
  if [[ -z "${WORK_ENV}" ]]; then
    WORK_ENV="{{ .WORK_ENVIRONMENT | default "false" }}"
    echo "📥 Reading work_environment from chezmoi data: ${WORK_ENV}"
  fi
  
  if [[ -z "${PERSONAL_ENV}" ]]; then
    {{- if hasKey . "PERSONAL_ENVIRONMENT" }}
    PERSONAL_ENV="{{ .PERSONAL_ENVIRONMENT | default "false" }}"
    {{- else }}
    # Default to opposite of work environment if not explicitly set
    if [[ "${WORK_ENV}" == "true" ]]; then
      PERSONAL_ENV="false"
    else
      PERSONAL_ENV="true"
    fi
    {{- end }}
    echo "📥 Reading personal_environment from chezmoi data: ${PERSONAL_ENV}"
  fi
  
  if [[ -z "${WORK_ORG}" ]]; then
    WORK_ORG="{{ .git.config.work_org | default "" }}"
    echo "📥 Reading work_org from chezmoi data: ${WORK_ORG}"
  fi
  
  if [[ -z "${HOSTNAME_SETTING}" ]]; then
    HOSTNAME_SETTING="{{ .hostname | default "" }}"
    echo "📥 Reading hostname from chezmoi data: ${HOSTNAME_SETTING}"
  fi
  
  if [[ -z "${SHELL_PREF}" ]]; then
    SHELL_PREF="{{ .SHELL | default "" }}"
    echo "📥 Reading shell from chezmoi data: ${SHELL_PREF}"
  fi
  
  if [[ -z "${CATPPUCCIN_PREF}" ]]; then
    CATPPUCCIN_PREF="{{ .CATPPUCCIN_FLAVOR | default "" }}"
    echo "📥 Reading catppuccin_flavor from chezmoi data: ${CATPPUCCIN_PREF}"
  fi
  
  # Persist to platform storage (defaults/dconf/etc)
  echo "💾 Saving machine identity to ${STORAGE_METHOD}..."
  write_machine_identity "work_environment" "${WORK_ENV}" "${STORAGE_METHOD}"
  write_machine_identity "personal_environment" "${PERSONAL_ENV}" "${STORAGE_METHOD}"
  if [[ -n "${WORK_ORG}" ]]; then
    write_machine_identity "work_org" "${WORK_ORG}" "${STORAGE_METHOD}"
  fi
  write_machine_identity "hostname" "${HOSTNAME_SETTING}" "${STORAGE_METHOD}"
  write_machine_identity "last_updated" "$(date -Iseconds)" "${STORAGE_METHOD}"
  
  # Store TouchID configuration status
  {{- if eq .chezmoi.os "darwin" }}
  if [ -f "/etc/pam.d/sudo_local" ] && grep -q "pam_tid.so" "/etc/pam.d/sudo_local" 2>/dev/null; then
    write_machine_identity "touchid_configured" "true" "${STORAGE_METHOD}"
  else
    write_machine_identity "touchid_configured" "false" "${STORAGE_METHOD}"
  fi
  {{- end }}
  
  # Store preferences if they were set interactively
  if [[ -n "${SHELL_PREF}" ]]; then
    write_machine_identity "shell" "${SHELL_PREF}" "${STORAGE_METHOD}"
  fi
  if [[ -n "${CATPPUCCIN_PREF}" ]]; then
    write_machine_identity "catppuccin_flavor" "${CATPPUCCIN_PREF}" "${STORAGE_METHOD}"
  fi
  
  echo "✅ Machine identity configured:"
  echo "   Storage method: ${STORAGE_METHOD}"
  echo "   Work Environment: ${WORK_ENV}"
  echo "   Personal Environment: ${PERSONAL_ENV}"
  echo "   Work Org: ${WORK_ORG}"
  echo "   Hostname: ${HOSTNAME_SETTING}"
  if [[ -n "${SHELL_PREF}" ]]; then
    echo "   Shell: ${SHELL_PREF}"
  fi
  if [[ -n "${CATPPUCCIN_PREF}" ]]; then
    echo "   Catppuccin: ${CATPPUCCIN_PREF}"
  fi

  FIRST_TIME_SETUP=true
else
  FIRST_TIME_SETUP=false
  # Read hostname from storage for hostname setting below
  STORAGE_METHOD="$(detect_storage_method)"
  HOSTNAME_SETTING="$(read_machine_identity "hostname" "${STORAGE_METHOD}")"
fi

# Set hostname and configure sudo (combine all sudo operations)
{{- $target_hostname := "" -}}
{{- $current_hostname := output "hostname" | trim -}}

{{- /* Determine target hostname from various sources */ -}}
{{- if env "HOSTNAME" -}}
  {{- $target_hostname = env "HOSTNAME" -}}
{{- else if hasKey . "hostname" -}}
  {{- $target_hostname = .hostname -}}
{{- end -}}

# Initialize hostname variables
HOSTNAME_NEEDS_SETTING=false
TARGET_HOSTNAME=""
CURRENT_HOSTNAME="{{ $current_hostname }}"

{{- if and $target_hostname (ne $target_hostname $current_hostname) }}
HOSTNAME_NEEDS_SETTING=true
TARGET_HOSTNAME="{{ $target_hostname }}"

# Validate TARGET_HOSTNAME contains only safe characters (alphanumeric, hyphens, dots)
if [[ ! "$TARGET_HOSTNAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]]; then
  echo "❌ Error: Invalid hostname '$TARGET_HOSTNAME'. Hostnames must contain only alphanumeric characters, hyphens, and dots."
  HOSTNAME_NEEDS_SETTING=false
fi
{{- end }}

# Combine ALL sudo operations into one command to minimize password prompts
{{- if eq .chezmoi.os "darwin" }}
# System configuration (TouchID and hostname)
CHANGES_NEEDED=false
SUDO_COMMANDS=""

# Check TouchID setup - only if not already tracked as configured
TOUCHID_CONFIGURED="$(read_machine_identity "touchid_configured" "${STORAGE_METHOD:-$(detect_storage_method)}")"

if [[ "${TOUCHID_CONFIGURED}" != "true" ]]; then
  # Check actual TouchID status
  if [ ! -f "/etc/pam.d/sudo_local" ] || ! grep -q "pam_tid.so" "/etc/pam.d/sudo_local" 2>/dev/null; then
    SUDO_COMMANDS="${SUDO_COMMANDS}echo 'auth       sufficient     pam_tid.so' > /etc/pam.d/sudo_local"$'\n'
    CHANGES_NEEDED=true
    echo "🔐 TouchID for sudo needs configuration"
  else
    # TouchID is already configured but not tracked in defaults
    echo "✅ TouchID for sudo already configured (updating defaults)"
    if ! $FIRST_TIME_SETUP; then
      STORAGE_METHOD_FOR_UPDATE="$(detect_storage_method)"
      write_machine_identity "touchid_configured" "true" "${STORAGE_METHOD_FOR_UPDATE}"
    fi
  fi
else
  echo "✅ TouchID for sudo already configured and tracked"
fi

# Check hostname
if $HOSTNAME_NEEDS_SETTING; then
  # Using absolute path for scutil in sudo context to ensure command is found
  # when PATH may not include /usr/sbin
  SUDO_COMMANDS="${SUDO_COMMANDS}/usr/sbin/scutil --set ComputerName '$TARGET_HOSTNAME'"$'\n'
  SUDO_COMMANDS="${SUDO_COMMANDS}/usr/sbin/scutil --set LocalHostName '$TARGET_HOSTNAME'"$'\n'
  SUDO_COMMANDS="${SUDO_COMMANDS}/usr/sbin/scutil --set HostName '$TARGET_HOSTNAME'"$'\n'
  CHANGES_NEEDED=true
fi

# Apply changes if needed
if $CHANGES_NEEDED; then
  if $FIRST_TIME_SETUP; then
    echo "🔐 Configuring system settings (sudo required)..."
  else
    echo "🔐 Applying system configuration changes (sudo required)..."
  fi
  
  if [[ -n "$SUDO_COMMANDS" ]]; then
    echo "$SUDO_COMMANDS" | sudo bash
    
    # Update TouchID status after successful configuration
    if echo "$SUDO_COMMANDS" | grep -q "pam_tid"; then
      STORAGE_METHOD_FOR_UPDATE="$(detect_storage_method)"
      write_machine_identity "touchid_configured" "true" "${STORAGE_METHOD_FOR_UPDATE}"
      echo "✅ TouchID sudo enabled and tracked"
    fi
    
    # Verify hostname results
    if $HOSTNAME_NEEDS_SETTING; then
      echo "✅ Hostname set to: $TARGET_HOSTNAME"
    fi
  fi
else
  if $FIRST_TIME_SETUP; then
    echo "✅ System already configured correctly"
  fi
fi

{{- else }}
# Non-macOS system configuration skipped
{{- end }}

# Validation (only show details on first setup)
if $FIRST_TIME_SETUP; then
  echo ""
  echo "🎉 Machine setup complete!"
  
  # Quick validation
  VALIDATION_STORAGE_METHOD="$(detect_storage_method)"
  STORED_WORK_ENV="$(read_machine_identity "work_environment" "${VALIDATION_STORAGE_METHOD}")"
  STORED_PERSONAL_ENV="$(read_machine_identity "personal_environment" "${VALIDATION_STORAGE_METHOD}")"
  CHEZMOI_WORK_ENV="{{ .WORK_ENVIRONMENT | default "false" }}"
  {{- if hasKey . "PERSONAL_ENVIRONMENT" }}
  CHEZMOI_PERSONAL_ENV="{{ .PERSONAL_ENVIRONMENT | default "false" }}"
  {{- else }}
  CHEZMOI_PERSONAL_ENV="{{ not .WORK_ENVIRONMENT }}"
  {{- end }}
  
  # Normalize boolean values for comparison
  normalize_boolean() {
    local value="$1"
    case "$value" in
      "1"|"true"|"True"|"TRUE") echo "true" ;;
      "0"|"false"|"False"|"FALSE"|"") echo "false" ;;
      *) echo "$value" ;;
    esac
  }
  
  NORMALIZED_STORED_WORK_ENV="$(normalize_boolean "${STORED_WORK_ENV:-false}")"
  NORMALIZED_STORED_PERSONAL_ENV="$(normalize_boolean "${STORED_PERSONAL_ENV:-false}")"
  NORMALIZED_CHEZMOI_WORK_ENV="$(normalize_boolean "${CHEZMOI_WORK_ENV}")"
  NORMALIZED_CHEZMOI_PERSONAL_ENV="$(normalize_boolean "${CHEZMOI_PERSONAL_ENV}")"
  
  if [[ "${NORMALIZED_STORED_WORK_ENV}" == "${NORMALIZED_CHEZMOI_WORK_ENV}" ]] && [[ "${NORMALIZED_STORED_PERSONAL_ENV}" == "${NORMALIZED_CHEZMOI_PERSONAL_ENV}" ]]; then
    echo "✅ Machine identity system configured and validated successfully!"
  else
    echo "⚠️  Machine identity validation warning:"
    echo "     Work: storage=${STORED_WORK_ENV}, chezmoi=${CHEZMOI_WORK_ENV}"
    echo "     Personal: storage=${STORED_PERSONAL_ENV}, chezmoi=${CHEZMOI_PERSONAL_ENV}"
  fi
else
  echo "✅ Machine identity system ready"
fi
