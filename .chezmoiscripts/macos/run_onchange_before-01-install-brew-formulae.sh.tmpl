#!/bin/bash

# Homebrew Formulae (CLI Tools) Installation Script
# run_onchange: {{ template "queries/brew-formulae.tmpl" . }}

{{ template "utilities/error-handling.sh" }}
{{ template "utilities/logging.sh.tmpl" }}

{{ if eq .chezmoi.os "darwin" -}}

log_section "🍺 Homebrew Formulae (CLI Tools)"

{{- template "brew/ensure-brew.sh.tmpl" }}

# Install brew packages using pre-check + quiet install pattern
# Args: $1 = label (e.g. "taps", "formulae"), $2 = brewfile path, $3 = entry_type (tap|brew)
install_brew_packages() {
    local label="$1"
    local brewfile="$2"
    local entry_type="${3:-brew}"

    local total
    total=$(grep -c "^${entry_type}" "$brewfile" 2>/dev/null || echo "0")

    # Pre-check
    local MISSING=()
    local check_output
    check_output=$(brew bundle check --verbose --no-upgrade --file="$brewfile" 2>&1 || true)
    while IFS= read -r line; do
        # ponytail: brew's "bundle check --verbose" wording has changed across
        # versions ("Formula X needs to be installed" / "Tap X needs to be
        # tapped" vs. older "'X' is not installed" / "'X' is not tapped");
        # match both so a future wording change doesn't silently make this
        # pre-check a no-op again.
        local name=""
        if [[ "$line" == *"needs to be installed"* ]] || [[ "$line" == *"needs to be tapped"* ]]; then
            name=$(echo "$line" | sed -E 's/.*(Formula|Tap) ([^ ]+) needs to be (installed|tapped).*/\2/')
        elif [[ "$line" == *"is not installed"* ]] || [[ "$line" == *"is not tapped"* ]]; then
            name=$(echo "$line" | sed "s/.*'\([^']*\)'.*/\1/")
        fi
        [[ -n "$name" ]] && MISSING+=("$name")
    done <<< "$check_output"

    if [[ ${#MISSING[@]} -eq 0 ]]; then
        log_summary "✓ All $total $label up to date"
        return 0
    fi

    # Capture failure instead of letting set -e / the ERR trap abort before the per-package report
    local exit_code=0
    brew bundle install --quiet --no-upgrade --file="$brewfile" >> "$LOG_FILE" 2>&1 || exit_code=$?

    for name in "${MISSING[@]}"; do
        local is_installed=false
        if [[ "$entry_type" == "tap" ]]; then
            brew tap 2>/dev/null | grep -q "^${name}$" && is_installed=true
        else
            brew list "$name" >/dev/null 2>&1 && is_installed=true
        fi
        if [[ "$is_installed" == "true" ]]; then
            log_install_result "ok" "$name"
        else
            log_install_result "fail" "$name"
        fi
    done

    if [[ $exit_code -ne 0 ]]; then
        log_error "Some $label failed to install. See $LOG_FILE for details."
    fi
}

# Install taps first
taps_file=$(mktemp)
brews_file=$(mktemp)
trap 'rm -f "$taps_file" "$brews_file"' EXIT
{{- range .homebrew_taps }}
echo "tap \"{{ .name }}\"" >> "$taps_file"
{{- end }}
install_brew_packages "taps" "$taps_file" "tap"

# Language servers that install via brew
{{- range .language_servers }}
  {{- if has "brew" .installer }}
echo "brew \"{{ .name }}\"" >> "$brews_file"
  {{- end }}
{{- end }}
# Formatters that install via brew
{{- range .formatters }}
  {{- if has "brew" .installer }}
echo "brew \"{{ .name }}\"" >> "$brews_file"
  {{- end }}
{{- end }}
# Linters that install via brew
{{- range .linters }}
  {{- if has "brew" .installer }}
echo "brew \"{{ .name }}\"" >> "$brews_file"
  {{- end }}
{{- end }}
# Development tools that install via brew
{{- range .dev_tools }}
  {{- if has "brew" .installer }}
echo "brew \"{{ .name }}\"" >> "$brews_file"
  {{- end }}
{{- end }}
# AI agents that install via brew
{{- range .agents }}
  {{- if has "brew" .installer }}
echo "brew \"{{ .name }}\"" >> "$brews_file"
  {{- end }}
{{- end }}
install_brew_packages "formulae" "$brews_file" "brew"

# Setup automatic updates
if brew autoupdate status 2>&1 | grep -q "not configured"; then
    if brew autoupdate start --upgrade --cleanup --immediate{{- if not .WORK_ENVIRONMENT }} --sudo{{- end }}; then
        log_success "Homebrew automatic upgrades configured"
    else
        log_warning "Failed to configure automatic upgrades"
    fi
else
    log_debug "Homebrew automatic upgrades already configured"
fi

{{- else }}
log_warning "This script is designed for macOS only"
exit 0
{{- end }}
