#!/bin/bash

# Homebrew Formulae (CLI Tools) Installation Script
# run_onchange: {{ template "queries/brew-formulae.tmpl" . }}

{{ template "utilities/error-handling.sh" }}
{{ template "utilities/logging.sh.tmpl" }}

{{ if eq .chezmoi.os "darwin" -}}

log_section "🍺 Homebrew Formulae (CLI Tools)"

{{- template "brew/ensure-brew.sh.tmpl" }}

# Function to install packages in batches
install_brew_packages() {
    local package_type="$1"
    local packages="$2"

    if [[ -z "$packages" ]]; then
        log_debug "No $package_type packages to install"
        return 0
    fi

    log_step "Installing $package_type packages"

    # Create temporary Brewfile
    local brewfile=$(mktemp)
    echo -e "$packages" > "$brewfile"

    # Determine brew bundle arguments based on verbose mode
    local brew_args="install --file=$brewfile"
    if [[ "${CHEZMOI_VERBOSE}" == "1" ]]; then
        brew_args="$brew_args --verbose"
    fi

    # Install packages - behavior depends on verbose mode
    if [[ "${CHEZMOI_VERBOSE}" == "1" ]]; then
        # Verbose mode: stream output directly for real-time visibility
        log_info "Running: brew bundle $brew_args"
        log_info "Streaming output (this may take a while for large apps)..."
        brew bundle $brew_args
        local exit_code=$?
    else
        # Normal mode: capture output and show summary
        local output
        output=$(brew bundle $brew_args 2>&1)
        local exit_code=$?
    fi

    if [ $exit_code -eq 0 ]; then
        if [[ "${CHEZMOI_VERBOSE}" != "1" ]]; then
            # Success - show summary instead of full output (non-verbose only)
            local new_count=$(echo "$output" | grep -c "Installing" 2>/dev/null || echo "0")
            local cached_count=$(echo "$output" | grep -c "Using" 2>/dev/null || echo "0")

            # Ensure we have integers (remove any whitespace/newlines)
            new_count=$(echo "$new_count" | tr -d '\n' | tr -d ' ')
            cached_count=$(echo "$cached_count" | tr -d '\n' | tr -d ' ')

            if [ "$new_count" -gt 0 ] 2>/dev/null || [ "$cached_count" -gt 0 ] 2>/dev/null; then
                log_success "$package_type: $new_count new, $cached_count cached"
            else
                log_success "$package_type packages installed successfully"
            fi
        else
            log_success "$package_type packages installed successfully"
        fi
    else
        # Error - show full output for debugging
        if [[ "${CHEZMOI_VERBOSE}" != "1" ]]; then
            echo "$output"
        fi
        log_error "Failed to install some $package_type packages"
        rm -f "$brewfile"
        return 1
    fi

    # Clean up
    rm -f "$brewfile"
}

# Install taps first
log_step "Installing Homebrew taps"
TAPS=""

# Add required taps (manually curated list)
TAPS="${TAPS}tap \"adoptopenjdk/openjdk\"\n"
TAPS="${TAPS}tap \"charmbracelet/tap\"\n"
TAPS="${TAPS}tap \"domt4/autoupdate\"\n"
TAPS="${TAPS}tap \"felixkratz/formulae\"\n"
TAPS="${TAPS}tap \"hashicorp/tap\"\n"
TAPS="${TAPS}tap \"jesseduffield/lazydocker\"\n"
TAPS="${TAPS}tap \"kubewall/tap\"\n"
TAPS="${TAPS}tap \"nikitabobko/tap\"\n"

install_brew_packages "taps" "$TAPS"

# Collect all brew formulae from different sources
log_step "Collecting brew formulae from all sources"
BREWS=""

# Language servers that install via brew
{{- range .language_servers }}
  {{- if eq .install_via "brew" }}
BREWS="${BREWS}brew \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

# Formatters that install via brew
{{- range .formatters }}
  {{- if eq .install_via "brew" }}
BREWS="${BREWS}brew \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

# Linters that install via brew
{{- range .linters }}
  {{- if eq .install_via "brew" }}
BREWS="${BREWS}brew \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

# Development tools that install via brew
{{- range .dev_tools }}
  {{- if eq .install_via "brew" }}
BREWS="${BREWS}brew \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

# AI agents that install via brew
{{- range .agents }}
  {{- if eq .install_via "brew" }}
BREWS="${BREWS}brew \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

install_brew_packages "brews" "$BREWS"

# Setup automatic updates
log_step "Setting up Homebrew automatic upgrades"
if brew autoupdate status 2>&1 | grep -q "not configured"; then
    if brew autoupdate start --upgrade --cleanup --immediate{{- if not .WORK_ENVIRONMENT }} --sudo{{- end }}; then
        log_success "Homebrew automatic upgrades configured"
    else
        log_warning "Failed to configure automatic upgrades"
    fi
else
    log_debug "Homebrew automatic upgrades already configured"
fi

# Summary
log_header "Homebrew Formulae Installation Summary"
log_info "Installed packages by category:"
log_substep "Language servers: $(echo -e "$BREWS" | grep -E '(language-server|lsp|analyzer)' | wc -l | tr -d ' ')"
log_substep "Formatters: $(echo -e "$BREWS" | grep -E '(fmt|format|yamlfix|yamlfmt)' | wc -l | tr -d ' ')"
log_substep "Linters: $(echo -e "$BREWS" | grep -E '(lint|check|vale|hadolint|tflint|cspell)' | wc -l | tr -d ' ')"
log_substep "Development tools: $(echo -e "$BREWS" | grep -v -E '(language-server|lsp|analyzer|fmt|format|yamlfix|yamlfmt|lint|check|vale|hadolint|tflint|cspell)' | wc -l | tr -d ' ')"

log_success "Homebrew formulae installation completed"

{{- else }}
log_warning "This script is designed for macOS only"
exit 0
{{- end }}
