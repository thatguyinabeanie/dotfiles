#!/bin/bash

# Homebrew Casks (GUI Applications) Installation Script
# run_onchange: {{ template "queries/brew-casks.tmpl" . }}

{{ template "utilities/error-handling.sh" }}
{{ template "utilities/logging.sh.tmpl" }}
{{ template "utilities/env-helpers.sh.tmpl" }}

{{ if eq .chezmoi.os "darwin" -}}

log_section "📦 Homebrew Casks (GUI Applications)"

{{- template "brew/ensure-brew.sh.tmpl" }}

# Function to install packages with progress
install_brew_packages() {
    local package_type="$1"
    local packages="$2"

    if [[ -z "$packages" ]]; then
        log_debug "No $package_type packages to install"
        return 0
    fi

    # Count packages
    local total_count=$(echo -e "$packages" | grep -c "cask\|brew" || echo "0")
    log_step "Installing $total_count $package_type packages"

    # Create temporary Brewfile
    local brewfile=$(mktemp)
    echo -e "$packages" > "$brewfile"

    # Show package list
    log_detail "Packages to install:"
    echo -e "$packages" | grep -o '"[^"]*"' | tr -d '"' | while read pkg; do
        log_substep "  - $pkg"
    done

    # Determine brew bundle arguments - always verbose for visibility
    local brew_args="install --file=$brewfile --verbose"

    # Install packages with full output streaming
    log_detail "Running: brew bundle $brew_args"
    log_detail "⏳ Streaming full installation output..."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Stream all output with timestamps and formatting
    local current_package=""
    brew bundle $brew_args 2>&1 | while IFS= read -r line; do
        local timestamp=$(date '+%H:%M:%S')

        # Detect package being processed
        if [[ "$line" =~ Installing\ ([^[:space:]]+) ]]; then
            current_package="${BASH_REMATCH[1]}"
            echo ""
            echo "[$timestamp] 📥 INSTALLING: $current_package"
            echo "[$timestamp] $line"
        elif [[ "$line" =~ Downloading\ ([^[:space:]]+) ]]; then
            echo "[$timestamp] ⬇️  $line"
        elif [[ "$line" =~ Using\ ([^[:space:]]+) ]]; then
            echo "[$timestamp] ✓ CACHED: $line"
        elif [[ "$line" =~ "Pouring" ]]; then
            echo "[$timestamp] 🍺 $line"
        elif [[ "$line" =~ "==> " ]]; then
            echo "[$timestamp] 🔧 $line"
        elif [[ "$line" =~ "Error:" ]] || [[ "$line" =~ "error:" ]]; then
            echo "[$timestamp] ❌ ERROR: $line"
        elif [[ "$line" =~ "Warning:" ]] || [[ "$line" =~ "warning:" ]]; then
            echo "[$timestamp] ⚠️  WARNING: $line"
        elif [[ ! -z "$line" ]]; then
            # Show all non-empty lines with timestamp
            echo "[$timestamp] $line"
        fi
    done

    local exit_code=${PIPESTATUS[0]}

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [ $exit_code -eq 0 ]; then
        log_success "$package_type packages installed successfully"
    else
        log_error "Failed to install some $package_type packages (exit code: $exit_code)"
        rm -f "$brewfile"
        return 1
    fi

    # Clean up
    rm -f "$brewfile"
}

# Install casks
log_step "Collecting cask packages"
CASKS=""

# Development tools that install via brew_cask
{{- range .dev_tools }}
  {{- if has "brew_cask" .installer }}
CASKS="${CASKS}cask \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

# AI agents that install via brew_cask
{{- range .agents }}
  {{- if has "brew_cask" .installer }}
CASKS="${CASKS}cask \"{{ .name }}\"\n"
  {{- end }}
{{- end }}

# General applications that install via brew_cask
{{- if .applications.shared }}
  {{- range .applications.shared }}
    {{- if has "brew_cask" .installer }}
CASKS="${CASKS}cask \"{{ .name }}\"\n"
    {{- end }}
  {{- end }}
{{- end }}

if is_personal_environment; then
  {{- if .applications.personal }}
    {{- range .applications.personal }}
      {{- if has "brew_cask" .installer }}
CASKS="${CASKS}cask \"{{ .name }}\"\n"
      {{- end }}
    {{- end }}
  {{- end }}
fi

if is_work_environment; then
  {{- if .applications.work }}
    {{- range .applications.work }}
      {{- if has "brew_cask" .installer }}
CASKS="${CASKS}cask \"{{ .name }}\"\n"
      {{- end }}
    {{- end }}
  {{- end }}
fi

install_brew_packages "casks" "$CASKS"

# Summary
log_header "Homebrew Casks Installation Summary"
log_detail "Installed packages:"
log_substep "GUI applications: $(echo -e "$CASKS" | wc -l | tr -d ' ')"

log_success "Homebrew casks installation completed"

{{- else }}
log_warning "This script is designed for macOS only"
exit 0
{{- end }}
