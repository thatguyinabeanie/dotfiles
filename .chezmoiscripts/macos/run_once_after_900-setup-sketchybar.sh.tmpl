#!/usr/bin/env bash

{{- if eq .chezmoi.os "darwin" }}

# Exit silently if INSTALL_SKETCHY_BAR is falsey
if [[ "${INSTALL_SKETCHY_BAR}" =~ ^(0|false|False|FALSE|f|F|no|No|NO|n|N|off|Off|OFF)$ ]]; then
	exit 0
fi

# SketchyBar setup script - start the service

set -euo pipefail

echo "Setting up SketchyBar service..."

# Check if SketchyBar is installed
if ! command -v sketchybar &> /dev/null; then
    echo "SketchyBar not found. Please install it first with: brew install sketchybar"
    exit 1
fi

# Install SbarLua plugin
echo "📦 Installing SbarLua plugin..."
if (git clone https://github.com/FelixKratz/SbarLua.git /tmp/SbarLua &>/dev/null && \
    cd /tmp/SbarLua/ && \
    make install &>/dev/null && \
    rm -rf /tmp/SbarLua/); then
    echo "✅ SbarLua plugin installed successfully"
else
    echo "❌ Failed to install SbarLua plugin"
    exit 1
fi


{{- end }}
