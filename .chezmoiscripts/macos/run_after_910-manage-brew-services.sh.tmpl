#!/usr/bin/env bash

{{- if eq .chezmoi.os "darwin" }}

# Exit silently if MANAGE_BREW_SERVICES is falsey
if [[ "${MANAGE_BREW_SERVICES}" =~ ^(0|false|False|FALSE|f|F|no|No|NO|n|N|off|Off|OFF)$ ]]; then
	exit 0
fi

# Brew Services Manager
# Hash: {{ include ".chezmoidata/brew-services.yaml" | sha256sum }}

set -euo pipefail

echo "🔧 Managing brew services..."

# Get currently running services once
RUNNING_SERVICES=$(brew services list --json | jq -r '.[] | select(.status == "started") | .name')

{{- range .services }}
{{- $service := . }}
{{- $excluded := false }}
{{- range $.excluded_services }}
{{- if eq . $service.name }}{{ $excluded = true }}{{ end }}
{{- end }}
{{- if not $excluded }}

# Process {{ .name }}
if echo "$RUNNING_SERVICES" | grep -q "^{{ .name }}$"; then
	SERVICE_RUNNING=true
else
	SERVICE_RUNNING=false
fi

{{- if hasKey . "disabled" }}
{{- if .disabled }}
# Stop disabled service if running
if $SERVICE_RUNNING; then
	brew services stop "{{ .name }}" >/dev/null 2>&1
fi
{{- else }}
{{- if eq .action "restart" }}
# Restart {{ .name }}
brew services restart "{{ .name }}" >/dev/null 2>&1
{{- else if eq .action "start" }}
# Start {{ .name }} if not running
if ! $SERVICE_RUNNING; then
	brew services start "{{ .name }}" >/dev/null 2>&1
fi
{{- end }}
{{- end }}
{{- else }}
{{- if eq .action "restart" }}
# Restart {{ .name }}
brew services restart "{{ .name }}" >/dev/null 2>&1
{{- else if eq .action "start" }}
# Start {{ .name }} if not running
if ! $SERVICE_RUNNING; then
	brew services start "{{ .name }}" >/dev/null 2>&1
fi
{{- end }}
{{- end }}
{{- end }}
{{- end }}

echo "📊 Final brew services status:"
brew services list

{{- end }}
