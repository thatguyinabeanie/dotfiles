#!/bin/sh

{{- $shared := (include ".chezmoidata/environment/env-shared.yaml" | fromYaml) }}
{{- $taps := (include ".chezmoidata/packages/macos-taps.yaml" | fromYaml) }}
{{- $brewsShared := (include ".chezmoidata/packages/macos-brew-shared.yaml" | fromYaml) }}
{{- $brewsPersonal := (include ".chezmoidata/packages/macos-brew-personal.yaml" | fromYaml) }}
{{- $brewsWork := (include ".chezmoidata/packages/macos-brew-work.yaml" | fromYaml) }}
{{- $casksShared := (include ".chezmoidata/packages/macos-casks-shared.yaml" | fromYaml) }}
{{- $casksPersonal := (include ".chezmoidata/packages/macos-casks-personal.yaml" | fromYaml) }}
{{- $casksWork := (include ".chezmoidata/packages/macos-casks-work.yaml" | fromYaml) }}
{{- $fonts := (include ".chezmoidata/packages/macos-fonts.yaml" | fromYaml) }}
{{- $mas := (include ".chezmoidata/packages/macos-appstore.yaml" | fromYaml) }}

# Comprehensive macOS Homebrew and Package Installation Script
# Hash files to trigger on changes:
# taps.yaml-hash: {{ include ".chezmoidata/packages/macos-taps.yaml" | sha256sum }}
# brews-shared.yaml-hash: {{ include ".chezmoidata/packages/macos-brew-shared.yaml" | sha256sum }}
# brews-personal.yaml-hash: {{ include ".chezmoidata/packages/macos-brew-personal.yaml" | sha256sum }}
# brews-work.yaml-hash: {{ include ".chezmoidata/packages/macos-brew-work.yaml" | sha256sum }}
# casks-shared.yaml-hash: {{ include ".chezmoidata/packages/macos-casks-shared.yaml" | sha256sum }}
# casks-personal.yaml-hash: {{ include ".chezmoidata/packages/macos-casks-personal.yaml" | sha256sum }}
# casks-work.yaml-hash: {{ include ".chezmoidata/packages/macos-casks-work.yaml" | sha256sum }}
# fonts.yaml-hash: {{ include ".chezmoidata/packages/macos-fonts.yaml" | sha256sum }}
# mas.yaml-hash: {{ include ".chezmoidata/packages/macos-appstore.yaml" | sha256sum }}

# Source shared homebrew helper functions
{{ template "homebrew-helpers.sh.tmpl" . }}

{{ if eq .chezmoi.os "darwin" -}}

# Check if Homebrew is installed, install if not
{{ if not (lookPath "brew") -}}
echo "🟠 Installing Homebrew Package Manager for macOS."
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
echo "🔵 Homebrew Package Manager installed."
{{ else -}}
echo "🔵 Homebrew is already installed."
{{ end -}}

# Ensure PATH is configured
setup_homebrew_path

# Install taps first
printf "🔧 Installing Homebrew taps..."
TAPS=""
{{ range $taps.macos_taps.taps -}}
TAPS="${TAPS}tap \"{{ . }}\"\n"
{{ end }}
install_packages "taps" "$TAPS"

# Install brews
printf "🍺 Installing Homebrew packages..."
BREWS=""

# Always add shared brews
{{ range $brewsShared.macos_brew_shared.tools -}}
BREWS="${BREWS}brew \"{{ . }}\"\n"
{{ end }}

# Add environment-specific brews
{{ if and (hasKey . "WORK_ENVIRONMENT") (eq .WORK_ENVIRONMENT true) -}}
# Add work brews
{{ range $brewsWork.macos_brew_work.tools -}}
BREWS="${BREWS}brew \"{{ . }}\"\n"
{{ end }}
{{ else -}}
# Add personal brews
{{ range $brewsPersonal.macos_brew_personal.tools -}}
BREWS="${BREWS}brew \"{{ . }}\"\n"
{{ end }}
{{ end -}}

install_packages "brews" "$BREWS"

# Install casks
printf "📦 Installing Homebrew casks..."
CASKS=""

# Always add shared casks
{{ range $casksShared.macos_casks_shared.applications -}}
CASKS="${CASKS}cask \"{{ . }}\"\n"
{{ end }}

# Add environment-specific casks
{{ if and (hasKey . "WORK_ENVIRONMENT") (eq .WORK_ENVIRONMENT true) -}}
# Add work casks
{{ range $casksWork.macos_casks_work.applications -}}
CASKS="${CASKS}cask \"{{ . }}\"\n"
{{ end }}
{{ else -}}
# Add personal casks
{{ range $casksPersonal.macos_casks_personal.applications -}}
CASKS="${CASKS}cask \"{{ . }}\"\n"
{{ end }}
{{ end -}}

install_packages "casks" "$CASKS"

# Install fonts
printf "🔤 Installing fonts..."
FONTS=""
{{ range $fonts.macos_fonts.fonts -}}
FONTS="${FONTS}cask \"{{ . }}\"\n"
{{ end }}
install_packages "fonts" "$FONTS"

# Install MAS apps (personal only)
{{ if or (eq (hasKey . "WORK_ENVIRONMENT") false) (eq .WORK_ENVIRONMENT false) -}}
printf "🏪 Installing Mac App Store apps..."
MAS_APPS=""
{{ range $mas.macos_appstore.mas -}}
MAS_APPS="${MAS_APPS}mas {{ . }}\n"
{{ end }}
install_packages "mas" "$MAS_APPS"
{{ end -}}

# Setup automatic updates
printf "🕒 Setting up Homebrew automatic upgrades..."
if brew autoupdate status 2>&1 | grep -q "not configured"; then
  brew autoupdate start --upgrade --cleanup --immediate{{- if not .WORK_ENVIRONMENT }} --sudo{{- end }}
fi
printf " ✅\n"

{{ end -}}