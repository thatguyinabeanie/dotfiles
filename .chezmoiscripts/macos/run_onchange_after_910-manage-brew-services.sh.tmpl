#!/usr/bin/env bash

# Brew Services Manager
# Manages Homebrew services based on .chezmoidata/services.yaml

{{- define "process_service" -}}
{{- $service := .service }}
{{- $excluded := false }}
{{- range .excluded_services }}
{{- if eq . $service.name }}{{ $excluded = true }}{{ end }}
{{- end }}
{{- if not $excluded }}

# Process {{ $service.name }}
if echo "$RUNNING_SERVICES" | grep -q "^{{ $service.name }}$"; then
    SERVICE_RUNNING=true
else
    SERVICE_RUNNING=false
fi

# Check if service should be managed
{{- $condition := "always" }}
{{- if hasKey $service "condition" }}{{ $condition = $service.condition }}{{ end }}
{{- if ne $service.action "stop" }}
{{- if eq $condition "always" }}
# Service active - always manage
{{- if eq $service.action "restart" }}
# Restart {{ $service.name }}
brew services restart "{{ $service.name }}" >/dev/null 2>&1
{{- else if eq $service.action "start" }}
# Start {{ $service.name }} if not running
if ! $SERVICE_RUNNING; then
    brew services start "{{ $service.name }}" >/dev/null 2>&1
fi
{{- end }}
{{- else if eq $condition "ifInstalled" }}
# Service active - only manage if installed
if command -v "{{ $service.name }}" >/dev/null 2>&1; then
{{- if eq $service.action "restart" }}
    # Restart {{ $service.name }}
    brew services restart "{{ $service.name }}" >/dev/null 2>&1
{{- else if eq $service.action "start" }}
    # Start {{ $service.name }} if not running
    if ! $SERVICE_RUNNING; then
        brew services start "{{ $service.name }}" >/dev/null 2>&1
    fi
{{- end }}
fi
{{- end }}
{{- else }}
# Service inactive - stop if running
if $SERVICE_RUNNING; then
    brew services stop "{{ $service.name }}" >/dev/null 2>&1
fi
{{- end }}
{{- end }}
{{- end -}}

{{- if eq .chezmoi.os "darwin" }}
{{- $brewServices := (include ".chezmoidata/services.yaml" | fromYaml) }}

# Exit silently if MANAGE_BREW_SERVICES is falsey
if [[ "${MANAGE_BREW_SERVICES}" =~ ^(0|false|False|FALSE|f|F|no|No|NO|n|N|off|Off|OFF)$ ]]; then
	exit 0
fi

# Check if brew is installed
if ! command -v brew &> /dev/null; then
    exit 0
fi

# Brew Services Manager - Initial Setup

# Use relaxed error handling for service management (some services may not exist)
set +e

echo "🔧 Initial brew services setup..."

# Get currently running services once (detected at runtime, not template evaluation)
RUNNING_SERVICES=$(brew services list --json | jq -r '.[] | select(.status == "started") | .name')

{{- range $brewServices.macos_services }}
{{ template "process_service" (dict "service" . "excluded_services" $brewServices.excluded_services) }}
{{- end }}

echo "📊 Final brew services status:"
brew services list

{{- end }}
