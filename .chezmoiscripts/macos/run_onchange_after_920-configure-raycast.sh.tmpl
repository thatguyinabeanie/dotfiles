#!/bin/bash

# Configure Raycast keyboard shortcut and disable Spotlight
#
# This script:
# 1. Disables macOS Spotlight's Cmd+Space keyboard shortcut
# 2. Configures Raycast to use Cmd+Space as its global hotkey
#
# The script only runs when applications.yaml changes (via hash trigger)
# Hash: {{ include ".chezmoidata/applications.yaml" | sha256sum }}

set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}

# Check if Raycast is installed
if ! [ -d "/Applications/Raycast.app" ]; then
  echo "⏭️  Raycast not installed, skipping configuration"
  exit 0
fi

echo "⚙️  Configuring Raycast keyboard shortcuts..."

# Function to disable Spotlight keyboard shortcut (Cmd+Space)
disable_spotlight_shortcut() {
  # The symbolic hotkeys for Spotlight are keys 64 and 65
  # We use `defaults write` with -dict-add so changes go through cfprefsd
  # (PlistBuddy writes to the file directly but cfprefsd ignores those changes)

  local current_enabled
  current_enabled=$(defaults read com.apple.symbolichotkeys AppleSymbolicHotKeys 2>/dev/null | grep -A 1 '"64"' | grep enabled | tr -d ' ;' | cut -d= -f2 || echo "")

  if [ "$current_enabled" != "0" ]; then
    echo "  🔕 Disabling Spotlight keyboard shortcut (Cmd+Space)..."

    # Disable Spotlight search (key 64) via defaults write so cfprefsd picks it up
    defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 '<dict><key>enabled</key><false/><key>value</key><dict><key>type</key><string>standard</string><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1048576</integer></array></dict></dict>'

    # Disable "Show Finder search window" (key 65)
    defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 '<dict><key>enabled</key><false/><key>value</key><dict><key>type</key><string>standard</string><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1572864</integer></array></dict></dict>'

    echo "  ✅ Spotlight keyboard shortcut disabled"
  else
    echo "  ✅ Spotlight keyboard shortcut already disabled"
  fi
}

# Function to configure Raycast to use Cmd+Space
configure_raycast_shortcut() {
  # Raycast's hotkey is stored in its preferences
  # The default is usually Cmd+Space, but let's ensure it's set

  local raycast_plist="$HOME/Library/Preferences/com.raycast.macos.plist"

  # Check if Raycast has been launched at least once (preferences exist)
  if [ -f "$raycast_plist" ]; then
    echo "  ⌨️  Configuring Raycast hotkey to Cmd+Space..."

    # Set the raycastGlobalHotkey to Cmd+Space
    # Raycast stores this as a string in the format "Command-49" (modifier-keyCode)
    defaults write com.raycast.macos raycastGlobalHotkey -string "Command-49"

    echo "  ✅ Raycast hotkey configured"
  else
    echo "  ℹ️  Raycast preferences not found (launch Raycast once to initialize)"
    echo "     After first launch, run 'chezmoi apply' again to configure the hotkey"
  fi
}

# Execute configuration
disable_spotlight_shortcut
configure_raycast_shortcut

# Restart affected services for changes to take effect
echo "  🔄 Restarting services to apply changes..."
killall SystemUIServer 2>/dev/null || true

# Check if Raycast is running and offer to restart it
if pgrep -x "Raycast" > /dev/null; then
  echo "  ℹ️  Raycast is running. Restart it to apply the new hotkey."
  echo "     You can restart Raycast from: Raycast > Quit Raycast"
fi

echo ""
echo "✅ Raycast configuration complete!"
echo "   • Spotlight Cmd+Space: Disabled"
echo "   • Raycast Cmd+Space: Configured"
echo ""
echo "   Note: You may need to log out and log back in for all changes to take effect."

{{- end }}
