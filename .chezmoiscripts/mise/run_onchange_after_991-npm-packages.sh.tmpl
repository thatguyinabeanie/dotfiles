#!/bin/bash

# NPM Global Package Installation (Hybrid Approach)
# Installs packages globally for system-wide use. Mason also installs these for Neovim.
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "npm" "root" .) }}

set -euo pipefail

{{ template "utilities/logging.sh.tmpl" }}

# Ensure Node.js is available via mise
if ! mise which node >/dev/null 2>&1; then
    echo "❌ Node.js not found. Please run mise installation first."
    log_to_file "ERROR: Node.js not found"
    exit 1
fi

log_detail "Collecting npm packages for global installation..."

# Collect all packages with 'npm' in installer array
NPM_PACKAGES=()

# Language servers not managed by Mason
{{- range .language_servers }}
{{- if and (has "npm" .installer) }}
NPM_PACKAGES+=("{{ if .mason_name }}{{ .mason_name }}{{ else }}{{ .name }}{{ end }}")
{{- end }}
{{- end }}

# Formatters not managed by Mason
{{- range .formatters }}
{{- if and (has "npm" .installer) }}
NPM_PACKAGES+=("{{ if .mason_name }}{{ .mason_name }}{{ else }}{{ .name }}{{ end }}")
{{- end }}
{{- end }}

# Linters not managed by Mason
{{- range .linters }}
{{- if and (has "npm" .installer) }}
NPM_PACKAGES+=("{{ if .mason_name }}{{ .mason_name }}{{ else }}{{ .name }}{{ end }}")
{{- end }}
{{- end }}

# AI agents
{{- range .agents }}
{{- if has "npm" .installer }}
NPM_PACKAGES+=("{{ if .mason_name }}{{ .mason_name }}{{ else }}{{ .name }}{{ end }}")
{{- end }}
{{- end }}

# MCP servers
{{- range .mcp_servers }}
{{- if has "npm" .installer }}
NPM_PACKAGES+=("{{ if .mason_name }}{{ .mason_name }}{{ else }}{{ .name }}{{ end }}")
{{- end }}
{{- end }}

if [[ ${#NPM_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✅ No npm packages to install"
    exit 0
fi

log_section "📦 Global NPM Installation (${#NPM_PACKAGES[@]} packages)"
log_detail "Installing globally for system-wide availability"
{{- $masonCount := 0 }}
{{- range .language_servers }}{{- if and (has "npm" .installer) (has "mason" .installer) }}{{- $masonCount = add $masonCount 1 }}{{- end }}{{- end }}
{{- range .formatters }}{{- if and (has "npm" .installer) (has "mason" .installer) }}{{- $masonCount = add $masonCount 1 }}{{- end }}{{- end }}
{{- range .linters }}{{- if and (has "npm" .installer) (has "mason" .installer) }}{{- $masonCount = add $masonCount 1 }}{{- end }}{{- end }}
{{- if gt $masonCount 0 }}
log_detail "Note: {{ $masonCount }} packages also managed by Mason for Neovim"
{{- end }}

# Pre-check which packages are already installed
log_detail "Checking for already installed packages..."
PACKAGES_TO_INSTALL=()
ALREADY_INSTALLED=0

for package in "${NPM_PACKAGES[@]}"; do
    if npm list -g "$package" >/dev/null 2>&1; then
        log_detail "$package already installed"
        ALREADY_INSTALLED=$((ALREADY_INSTALLED + 1))
    else
        PACKAGES_TO_INSTALL+=("$package")
    fi
done

# Report status and install only missing packages
if [[ ${#PACKAGES_TO_INSTALL[@]} -eq 0 ]]; then
    log_summary "✅ All npm packages already installed ($ALREADY_INSTALLED packages)"
    exit 0
fi

log_detail "Installing ${#PACKAGES_TO_INSTALL[@]} packages (${ALREADY_INSTALLED} already installed)..."

# Try bulk install for missing packages
if npm install -g "${PACKAGES_TO_INSTALL[@]}" >> "$LOG_FILE" 2>&1; then
    log_summary "✅ NPM packages: ${#PACKAGES_TO_INSTALL[@]} installed, $ALREADY_INSTALLED already present"
else
    log_detail "Bulk install failed, installing individually..."

    # Install packages individually with progress
    installed=0
    failed=0
    total=${#PACKAGES_TO_INSTALL[@]}
    current=0

    for package in "${PACKAGES_TO_INSTALL[@]}"; do
        current=$((current + 1))
        show_progress "$current" "$total" "$package"

        if npm install -g "$package" >> "$LOG_FILE" 2>&1; then
            log_detail "$package installed successfully"
            installed=$((installed + 1))
        else
            log_to_file "ERROR: Failed to install $package"
            failed=$((failed + 1))
        fi
    done

    clear_progress

    if [[ $failed -eq 0 ]]; then
        log_summary "✅ NPM packages: $installed installed, $ALREADY_INSTALLED already present"
    else
        log_summary "⚠️  NPM packages: $installed installed, $failed failed, $ALREADY_INSTALLED already present (see $LOG_FILE)"
    fi
fi