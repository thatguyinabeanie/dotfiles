#!/bin/bash

# This script installs npm packages not managed by mise or Mason
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "npm" "root" .) }}

set -euo pipefail

{{- template "utilities/logging.sh.tmpl" }}

# Ensure Node.js is available via mise
if ! mise which node >/dev/null 2>&1; then
    echo "❌ Node.js not found. Please run mise installation first."
    log_to_file "ERROR: Node.js not found"
    exit 1
fi

log_detail "Collecting npm packages..."

# Collect npm packages not managed by Mason
NPM_PACKAGES=()

# Language servers not managed by Mason
{{- range .language_servers }}
{{- if and (eq .install_via "npm") (not .mason_ensure_installed) }}
NPM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Formatters not managed by Mason
{{- range .formatters }}
{{- if and (eq .install_via "npm") (not .mason_ensure_installed) }}
NPM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Linters not managed by Mason
{{- range .linters }}
{{- if and (eq .install_via "npm") (not .mason_ensure_installed) }}
NPM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# AI agents
{{- range .agents }}
{{- if eq .install_via "npm" }}
NPM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# MCP servers
{{- range .mcp_servers }}
{{- if eq .install_via "npm" }}
NPM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

if [[ ${#NPM_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✅ No npm packages to install (all handled by Mason or mise)"
    exit 0
fi

log_section "📦 Installing ${#NPM_PACKAGES[@]} NPM Packages"
log_detail "Packages: ${NPM_PACKAGES[*]}"

# Try bulk install first (faster)
log_detail "Attempting bulk installation..."
if npm install -g "${NPM_PACKAGES[@]}" >> "$LOG_FILE" 2>&1; then
    log_summary "✅ All npm packages installed successfully"
else
    log_detail "Bulk install failed, installing individually..."

    # Install packages individually with progress
    local installed=0
    local failed=0
    local total=${#NPM_PACKAGES[@]}
    local current=0

    for package in "${NPM_PACKAGES[@]}"; do
        current=$((current + 1))
        show_progress "$current" "$total" "$package"

        if npm list -g "$package" >/dev/null 2>&1; then
            log_detail "$package already installed"
            installed=$((installed + 1))
        elif npm install -g "$package" >> "$LOG_FILE" 2>&1; then
            log_detail "$package installed successfully"
            installed=$((installed + 1))
        else
            log_to_file "ERROR: Failed to install $package"
            failed=$((failed + 1))
        fi
    done

    clear_progress

    if [[ $failed -eq 0 ]]; then
        log_summary "✅ NPM packages: $installed installed, 0 failed"
    else
        log_summary "⚠️  NPM packages: $installed installed, $failed failed (see $LOG_FILE)"
    fi
fi