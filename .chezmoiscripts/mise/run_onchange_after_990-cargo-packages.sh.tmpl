#!/bin/bash

# This script installs cargo packages not managed by mise or Mason
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "cargo" "root" .) }}

set -euo pipefail

{{ template "utilities/logging.sh.tmpl" }}

# Ensure Rust is available via mise
if ! mise which cargo >/dev/null 2>&1; then
    echo "❌ Rust not found. Please run mise installation first."
    log_to_file "ERROR: Rust not found"
    exit 1
fi

# Install cargo-binstall first as it accelerates all other cargo installations
log_detail "Checking cargo-binstall prerequisite..."
if ! command -v cargo-binstall >/dev/null 2>&1; then
    log_detail "Installing cargo-binstall (enables faster binary installations)..."
    if cargo install cargo-binstall >> "$LOG_FILE" 2>&1; then
        log_detail "cargo-binstall installed successfully"
    else
        log_detail "Failed to install cargo-binstall, falling back to regular cargo install"
    fi
else
    log_detail "cargo-binstall already available"
fi

log_detail "Collecting cargo packages..."

# Collect cargo packages not managed by Mason
CARGO_PACKAGES=()

# Language servers not managed by Mason
{{- range .language_servers }}
{{- if and (eq .install_via "cargo") (not .mason_ensure_installed) }}
{{- if .install_command }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

# Formatters not managed by Mason
{{- range .formatters }}
{{- if and (eq .install_via "cargo") (not .mason_ensure_installed) }}
{{- if .install_command }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

# Linters not managed by Mason
{{- range .linters }}
{{- if and (eq .install_via "cargo") (not .mason_ensure_installed) }}
{{- if .install_command }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

# Development tools (excluding cargo-binstall which is installed separately)
{{- range .dev_tools }}
{{- if and (eq .install_via "cargo") (ne .name "cargo-binstall") }}
{{- if .install_command }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

if [[ ${#CARGO_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✅ No cargo packages to install (all handled by Mason or mise)"
    exit 0
fi

log_section "🦀 Installing ${#CARGO_PACKAGES[@]} Cargo Packages"

installed=0
failed=0
total=${#CARGO_PACKAGES[@]}
current=0

for package_spec in "${CARGO_PACKAGES[@]}"; do
    current=$((current + 1))

    # Check if this is a custom install command
    if [[ "$package_spec" == *"cargo install"* ]]; then
        # Extract tool name from the command for checking if already installed
        tool_name=$(echo "$package_spec" | sed -n 's/.*--git.*\/\([^/]*\)\.git \([^ ]*\).*/\2/p')
        if [[ -z "$tool_name" ]]; then
            # Fallback: extract last argument as tool name
            tool_name=$(echo "$package_spec" | awk '{print $NF}')
        fi

        show_progress "$current" "$total" "$tool_name"

        if cargo install --list | grep -q "^$tool_name "; then
            log_detail "$tool_name already installed"
            installed=$((installed + 1))
        elif eval "$package_spec" >> "$LOG_FILE" 2>&1; then
            log_detail "$tool_name installed successfully"
            installed=$((installed + 1))
        else
            log_to_file "ERROR: Failed to install $tool_name via cargo"
            failed=$((failed + 1))
        fi
    else
        # Standard cargo install
        show_progress "$current" "$total" "$package_spec"

        if cargo install --list | grep -q "^$package_spec "; then
            log_detail "$package_spec already installed"
            installed=$((installed + 1))
        elif cargo install "$package_spec" >> "$LOG_FILE" 2>&1; then
            log_detail "$package_spec installed successfully"
            installed=$((installed + 1))
        else
            log_to_file "ERROR: Failed to install $package_spec via cargo"
            failed=$((failed + 1))
        fi
    fi
done

clear_progress

if [[ $failed -eq 0 ]]; then
    log_summary "✅ Cargo packages: $installed installed, 0 failed"
else
    log_summary "⚠️  Cargo packages: $installed installed, $failed failed (see $LOG_FILE)"
fi