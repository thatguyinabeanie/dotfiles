#!/bin/bash

# This script installs mise tools
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "mise" "root" .) }}

set -euo pipefail

# Ensure mise is in PATH (avoid duplication)
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Check if mise is installed
if ! command -v mise >/dev/null 2>&1; then
    echo "❌ mise is not installed. Please install mise first."
    exit 1
fi

echo "📦 Installing mise tools from config..."
if mise install; then
    echo "✅ All mise tools installed successfully"
else
    echo "⚠️  Some mise tools may have failed to install"
fi

# Verify critical runtimes are available
echo "🔍 Verifying critical runtimes..."
CRITICAL_RUNTIMES=("node" "python" "go" "rust")

check_runtime_status() {
    local runtime="$1"

    # Check if runtime is actually installed and working
    if mise which "${runtime}" >/dev/null 2>&1; then
        local version=$(mise current "${runtime}" 2>/dev/null)
        echo "  ✅ ${runtime} (${version})"
    # Check if runtime is configured in mise (will be installed)
    elif grep -q "\"${runtime}\"" ~/.config/mise/config.toml 2>/dev/null || \
         mise config ls 2>/dev/null | grep -q "${runtime}"; then
        echo "  ⏳ ${runtime} (installing...)"
    else
        echo "  ⚠️ ${runtime} not configured"
    fi
}

for runtime in "${CRITICAL_RUNTIMES[@]}"; do
    check_runtime_status "${runtime}"
done

echo "✅ Mise installation completed"
