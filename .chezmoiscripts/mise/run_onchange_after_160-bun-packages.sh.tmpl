#!/bin/bash

# Global bun Package Installation
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "bun" "root" .) }}

{{ template "utilities/logging.sh.tmpl" }}
{{ template "utilities/uninstall.sh.tmpl" }}

set -euo pipefail

if ! command -v bun >/dev/null 2>&1; then
    echo "❌ bun not found. Installing bun..."
    curl -fsSL https://bun.sh/install | bash
    export PATH="$HOME/.bun/bin:$PATH"
    if ! command -v bun >/dev/null 2>&1; then
        echo "❌ Failed to install bun. Please install manually."
        exit 1
    fi
fi

log_section "🍞 Bun Packages"

# Remove packages flagged "install: false"
_bun_is_installed() { grep -qF -- " $1@" <<< "$(bun pm ls -g 2>/dev/null)"; }
_bun_remove() { bun remove -g "$1"; }
REMOVE_PACKAGES=({{ template "queries/removed-packages.tmpl" (dict "PackageManager" "bun" "root" .) }})
if [[ ${#REMOVE_PACKAGES[@]} -gt 0 ]]; then
    uninstall_packages _bun_is_installed _bun_remove "${REMOVE_PACKAGES[@]}"
fi

BUN_PACKAGES=()

# AI agents
{{- range .agents }}
{{- if and (has "bun" .installer) (ne (toString (get . "install")) "false") }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Language servers
{{- range .language_servers }}
{{- if and (has "bun" .installer) (ne (toString (get . "install")) "false") }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Formatters
{{- range .formatters }}
{{- if and (has "bun" .installer) (ne (toString (get . "install")) "false") }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Linters
{{- range .linters }}
{{- if and (has "bun" .installer) (ne (toString (get . "install")) "false") }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

if [[ ${#BUN_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✓ No bun packages configured"
    exit 0
fi

# Pre-check
MISSING=()
for pkg in "${BUN_PACKAGES[@]}"; do
    bun pm ls -g 2>/dev/null | grep -q "$pkg" || MISSING+=("$pkg")
done

if [[ ${#MISSING[@]} -eq 0 ]]; then
    log_summary "✓ All ${#BUN_PACKAGES[@]} bun packages up to date"
    exit 0
fi

for pkg in "${MISSING[@]}"; do
    if bun install -g "$pkg" >> "$LOG_FILE" 2>&1; then
        log_install_result "ok" "$pkg"
    else
        log_install_result "fail" "$pkg"
    fi
done
