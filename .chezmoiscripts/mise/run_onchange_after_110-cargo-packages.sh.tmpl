#!/bin/bash

# Cargo Global Package Installation (Hybrid Approach)
# Installs Rust packages globally for system-wide use. Mason also installs these for Neovim.
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "cargo" "root" .) }}

set -euo pipefail

{{ template "utilities/logging.sh.tmpl" }}

# Ensure Rust is available via mise
if ! mise which cargo >/dev/null 2>&1; then
    echo "❌ Rust not found. Please run mise installation first."
    log_to_file "ERROR: Rust not found"
    exit 1
fi

# Install cargo-binstall first as it accelerates all other cargo installations
log_detail "Checking cargo-binstall prerequisite..."
if ! command -v cargo-binstall >/dev/null 2>&1; then
    log_detail "Installing cargo-binstall (enables faster binary installations)..."
    if cargo install cargo-binstall >> "$LOG_FILE" 2>&1; then
        log_detail "cargo-binstall installed successfully"
    else
        log_detail "Failed to install cargo-binstall, falling back to regular cargo install"
    fi
else
    log_detail "cargo-binstall already available"
fi

log_detail "Collecting cargo packages for global installation..."

# Collect all packages with 'cargo' in installer array
CARGO_PACKAGES=()

# Language servers not managed by Mason
{{- range .language_servers }}
{{- if and (has "cargo" .installer) }}
{{- if hasKey . "install_command" }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

# Formatters not managed by Mason
{{- range .formatters }}
{{- if and (has "cargo" .installer) }}
{{- if hasKey . "install_command" }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

# Linters not managed by Mason
{{- range .linters }}
{{- if and (has "cargo" .installer) }}
{{- if hasKey . "install_command" }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

# Development tools (excluding cargo-binstall which is installed separately)
{{- range .dev_tools }}
{{- if and (has "cargo" .installer) (ne .name "cargo-binstall") }}
{{- if hasKey . "install_command" }}
CARGO_PACKAGES+=("{{ .install_command }}")
{{- else }}
CARGO_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}
{{- end }}

if [[ ${#CARGO_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✅ No cargo packages to install"
    exit 0
fi

log_section "🦀 Global Cargo Installation (${#CARGO_PACKAGES[@]} packages)"

# Pre-check: capture installed list once, then identify what's missing
INSTALLED_LIST=$(cargo install --list 2>/dev/null)
MISSING_PACKAGES=()
for package_spec in "${CARGO_PACKAGES[@]}"; do
    if [[ "$package_spec" == *"cargo install"* ]]; then
        tool_name=$(echo "$package_spec" | sed -n 's/.*--git.*\/\([^/]*\)\.git \([^ ]*\).*/\2/p')
        [[ -z "$tool_name" ]] && tool_name=$(echo "$package_spec" | awk '{print $NF}')
        echo "$INSTALLED_LIST" | grep -q "^$tool_name " || MISSING_PACKAGES+=("$package_spec")
    else
        echo "$INSTALLED_LIST" | grep -q "^$package_spec " || MISSING_PACKAGES+=("$package_spec")
    fi
done

if [[ ${#MISSING_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✓ All ${#CARGO_PACKAGES[@]} cargo packages up to date"
    exit 0
fi

for package_spec in "${MISSING_PACKAGES[@]}"; do
    if [[ "$package_spec" == *"cargo install"* ]]; then
        tool_name=$(echo "$package_spec" | sed -n 's/.*--git.*\/\([^/]*\)\.git \([^ ]*\).*/\2/p')
        [[ -z "$tool_name" ]] && tool_name=$(echo "$package_spec" | awk '{print $NF}')
        if eval "$package_spec" >> "$LOG_FILE" 2>&1; then
            log_install_result "ok" "$tool_name"
        else
            log_install_result "fail" "$tool_name"
        fi
    else
        if command -v cargo-binstall >/dev/null 2>&1 && \
           cargo binstall --no-confirm "$package_spec" >> "$LOG_FILE" 2>&1; then
            log_install_result "ok" "$package_spec"
        elif cargo install "$package_spec" >> "$LOG_FILE" 2>&1; then
            log_install_result "ok" "$package_spec"
        else
            log_install_result "fail" "$package_spec"
        fi
    fi
done