#!/bin/bash

# Parallel Package Installer Orchestrator
#
# This script runs BEFORE individual package installers (990-995) and launches
# them in parallel for significantly faster installation (25min → 10min).
#
# Design:
# - This script (989) runs first and installs all packages in parallel
# - Individual scripts (990-995) run after as safety net
# - Individual scripts detect already-installed packages and skip quickly
# - Result: Fast parallel install + reliable fallback mechanism
#
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "npm" "root" .) }}-{{ template "queries/packages.tmpl" (dict "PackageManager" "cargo" "root" .) }}-{{ template "queries/packages.tmpl" (dict "PackageManager" "go" "root" .) }}

set -euo pipefail

{{- template "utilities/logging.sh.tmpl" }}

log_section "⚡ Parallel Package Installation"

# Directory for this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Track which installers to run
declare -A INSTALLERS
INSTALLERS=(
    [cargo]="990-cargo-packages.sh"
    [npm]="991-npm-packages.sh"
    [pip]="992-pip-packages.sh"
    [go]="993-go-packages.sh"
    [gem]="994-gem-packages.sh"
    [bun]="995-bun-packages.sh"
)

# Track running processes
declare -A pids
declare -A results

log_summary "Starting package installers in parallel..."
log_detail "This significantly reduces installation time"

# Launch all installers in background
for manager in "${!INSTALLERS[@]}"; do
    script="${INSTALLERS[$manager]}"
    script_path="$SCRIPT_DIR/$script"

    if [[ -f "$script_path" ]]; then
        log_detail "Launching $manager installer..."
        bash "$script_path" &
        pids[$manager]=$!
    fi
done

# Wait for all installers and collect results
log_detail "Waiting for all package installers to complete..."

for manager in "${!pids[@]}"; do
    pid=${pids[$manager]}

    if wait "$pid"; then
        results[$manager]="success"
        log_detail "$manager installer completed successfully"
    else
        results[$manager]="failed"
        log_to_file "ERROR: $manager installer failed (exit code: $?)"
    fi
done

# Generate summary
log_section "📊 Parallel Installation Summary"

local success_count=0
local fail_count=0

for manager in "${!results[@]}"; do
    if [[ "${results[$manager]}" == "success" ]]; then
        echo "  ✅ $manager"
        success_count=$((success_count + 1))
    else
        echo "  ❌ $manager (see $LOG_FILE)"
        fail_count=$((fail_count + 1))
    fi
done

echo ""
if [[ $fail_count -eq 0 ]]; then
    log_summary "✅ All $success_count package managers completed successfully"
    exit 0
else
    log_summary "⚠️  $success_count succeeded, $fail_count failed"
    log_summary "   Check log file: $LOG_FILE"
    exit 1
fi
