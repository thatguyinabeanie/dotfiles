#!/bin/bash
# Unified mise installation - handles both regular mise and mise-x64

{{- /* Inline mise architecture configuration */ -}}
{{- $mise := dict "dev_mise_architectures" (dict
  "architectures" (dict
    "native" (dict
      "binary" "mise"
      "launchagent" "com.user.mise-update"
    )
    "x64_variant" (dict
      "binary" "mise-x64"
      "arch" "x64"
      "description" "x64 compatibility"
      "launchagent" "com.user.mise-x64-update"
      "install_on_arm64" true
    )
  )
  "schedule" (dict
    "native" (dict "hour" 9 "minute" 0)
    "x64" (dict "hour" 9 "minute" 15)
  )
) -}}

set -euo pipefail

# Function to install mise with specified architecture
install_mise_arch() {
	local arch="$1"
	local binary_name="$2"
	local description="$3"
	local launchagent_name="$4"

	echo "🔧 Installing $binary_name ($description)..."

	# Configure mise installation
	export MISE_INSTALL_ARCH="$arch"
	export MISE_INSTALL_PATH="$HOME/.local/bin/$binary_name"
	export MISE_QUIET="true"

	# Install mise using the official installer
	if ! command -v mise >/dev/null 2>&1; then
		echo "Installing mise..."
		curl https://mise.run | sh

		# Add mise to PATH for this session
		export PATH="$HOME/.local/bin:$PATH"
	else
		echo "mise already installed"
	fi

	# Load and start LaunchAgent for daily updates (macOS only)
	{{- if eq .chezmoi.os "darwin" }}
  mkdir -p "{{ .chezmoi.homeDir }}/Library/LaunchAgents"
	if launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/$launchagent_name.plist" 2>/dev/null; then
		echo "⏰ $binary_name auto-update scheduled"
	else
		echo "⏰ $binary_name auto-update already configured"
	fi
	{{- end }}

	echo "✅ $binary_name setup complete"
}

echo "🚀 Installing mise..."

# Install native mise for system architecture
install_mise_arch "{{ if eq .chezmoi.arch "amd64" }}x64{{ else }}arm64{{ end }}" "{{ $mise.dev_mise_architectures.architectures.native.binary }}" "{{ .chezmoi.arch }}" "{{ $mise.dev_mise_architectures.architectures.native.launchagent }}"

# Install mise-x64 (for Node.js 14 compatibility) only on Apple Silicon
{{- if and (eq .chezmoi.arch "arm64") ($mise.dev_mise_architectures.architectures.x64_variant.install_on_arm64) }}
install_mise_arch "{{ $mise.dev_mise_architectures.architectures.x64_variant.arch }}" "{{ $mise.dev_mise_architectures.architectures.x64_variant.binary }}" "{{ $mise.dev_mise_architectures.architectures.x64_variant.description }}" "{{ $mise.dev_mise_architectures.architectures.x64_variant.launchagent }}"
{{- end }}

echo "🎉 All mise installations complete"

# Setup mise upgrade LaunchAgent (only for native mise, not mise-x64, macOS only)
{{- if eq .chezmoi.os "darwin" }}
if launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/com.user.mise-upgrade.plist" 2>/dev/null; then
	echo "⏰ mise upgrade scheduled (weekly on Mondays at 10:00 AM)"
else
	echo "⏰ mise upgrade already configured"
fi
{{- end }}

