#!/bin/bash

# This script installs bun packages (global packages)
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "bun" "root" .) }}

set -euo pipefail

# Ensure bun is available
if ! command -v bun >/dev/null 2>&1; then
    echo "❌ bun not found. Installing bun..."
    curl -fsSL https://bun.sh/install | bash
    export PATH="$HOME/.bun/bin:$PATH"
    
    if ! command -v bun >/dev/null 2>&1; then
        echo "❌ Failed to install bun. Please install manually."
        exit 1
    fi
fi

echo "📦 Collecting bun packages..."

# Collect bun packages not managed by Mason
BUN_PACKAGES=()

# AI agents
{{- range .agents }}
{{- if has "bun" .installer }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# MCP servers
{{- range .mcp_servers }}
{{- if has "bun" .installer }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Language servers not managed by Mason
{{- range .language_servers }}
{{- if and (has "bun" .installer) }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Formatters not managed by Mason
{{- range .formatters }}
{{- if and (has "bun" .installer) }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

# Linters not managed by Mason
{{- range .linters }}
{{- if and (has "bun" .installer) }}
BUN_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

if [[ ${#BUN_PACKAGES[@]} -eq 0 ]]; then
    echo "✅ No bun packages to install (all handled by Mason)"
    exit 0
fi

echo "📦 Installing ${#BUN_PACKAGES[@]} bun packages globally..."

for package in "${BUN_PACKAGES[@]}"; do
    echo "📦 Installing $package..."
    if bun pm ls -g | grep -q "$package"; then
        echo "  ✅ $package already installed"
    elif bun install -g "$package" >/dev/null 2>&1; then
        echo "  ✅ $package installed successfully"
    else
        echo "  ❌ Failed to install $package via bun"
    fi
done

echo "✅ Bun package installation completed"