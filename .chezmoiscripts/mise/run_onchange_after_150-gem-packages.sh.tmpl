#!/bin/bash

# Global gem Package Installation
# run_onchange: {{ template "queries/packages.tmpl" (dict "PackageManager" "gem" "root" .) }}

{{ template "utilities/logging.sh.tmpl" }}
{{ template "utilities/uninstall.sh.tmpl" }}

set -euo pipefail

if ! mise which ruby >/dev/null 2>&1; then
    echo "❌ Ruby not found. Please run mise installation first."
    exit 1
fi

log_section "💎 Ruby Gem Packages"

# Remove packages flagged "install: false"
_gem_is_installed() { gem list -i -e "$1"; }
_gem_remove() { gem uninstall -a -x "$1"; }
REMOVE_PACKAGES=({{ template "queries/removed-packages.tmpl" (dict "PackageManager" "gem" "root" .) }})
if [[ ${#REMOVE_PACKAGES[@]} -gt 0 ]]; then
    uninstall_packages _gem_is_installed _gem_remove "${REMOVE_PACKAGES[@]}"
fi

GEM_PACKAGES=()

{{- range .language_servers }}
{{- if and (has "gem" .installer) (ne (toString (get . "install")) "false") }}
GEM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

{{- range .formatters }}
{{- if and (has "gem" .installer) (ne (toString (get . "install")) "false") }}
GEM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

{{- range .linters }}
{{- if and (has "gem" .installer) (ne (toString (get . "install")) "false") }}
GEM_PACKAGES+=("{{ .name }}")
{{- end }}
{{- end }}

if [[ ${#GEM_PACKAGES[@]} -eq 0 ]]; then
    log_summary "✓ No gem packages configured"
    exit 0
fi

# Pre-check
MISSING=()
for pkg in "${GEM_PACKAGES[@]}"; do
    gem list -i "$pkg" >/dev/null 2>&1 || MISSING+=("$pkg")
done

if [[ ${#MISSING[@]} -eq 0 ]]; then
    log_summary "✓ All ${#GEM_PACKAGES[@]} gem packages up to date"
    exit 0
fi

for pkg in "${MISSING[@]}"; do
    if gem install "$pkg" >> "$LOG_FILE" 2>&1; then
        log_install_result "ok" "$pkg"
    else
        log_install_result "fail" "$pkg"
    fi
done
