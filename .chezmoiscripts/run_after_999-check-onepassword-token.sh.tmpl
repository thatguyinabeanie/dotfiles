#!/bin/bash
# Check if 1Password service account token is configured
# Runs after chezmoi apply with daily rate-limiting

set -euo pipefail

{{- if eq .WORK_ENVIRONMENT true }}

# Check if OP_SERVICE_ACCOUNT_TOKEN is configured
if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    # Check if token file exists (fallback)
    _OP_TOKEN_FILE="$HOME/.config/op/service-account-token"
    if [[ ! -f "$_OP_TOKEN_FILE" ]]; then
        # Rate limiting: check last warning timestamp (once per 24 hours)
        _LAST_WARNING=$(defaults read com.chezmoi.config op_token_warning_shown 2>/dev/null || echo "0")
        _CURRENT_TIME=$(date +%s)
        _TIME_SINCE_WARNING=$(( _CURRENT_TIME - _LAST_WARNING ))
        _ONE_DAY=86400  # 24 hours in seconds

        if [[ $_TIME_SINCE_WARNING -ge $_ONE_DAY ]]; then
            echo "⚠️  1Password service account token not configured" >&2
            echo "   See: ~/.local/share/chezmoi/.docs/human/ONEPASSWORD_SERVICE_ACCOUNT.md" >&2

            # Store timestamp to prevent showing again today
            defaults write com.chezmoi.config op_token_warning_shown -int "$_CURRENT_TIME"
        fi
    fi
fi

{{- else }}
# Not in work environment - skip check
exit 0
{{- end }}
